# banking_api_resource_server — Path A backend
API_RESOURCE_SERVER_PORT=8082
API_RESOURCE_SERVER_HOST=127.0.0.1
# Shared secret the gateway uses to call this service.
# Must match DEMO_API_RESOURCE_SERVER_KEY on the MCP gateway.
# Do NOT use demo-mortgage-key-0000 — the service rejects that committed default.
API_RESOURCE_SERVER_API_KEY=mortgage-compose-dev-key
