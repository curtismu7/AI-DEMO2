# Shared PingOne environment for this project.
PINGONE_ENVIRONMENT_ID=01d89b06-66d5-430e-9f28-65636843788b

# OpenAI Agents SDK agent service
AGENT_HOST=127.0.0.1
# AGENT_PORT: configure this setting for openai_agent/.env.example; see the service documentation.
AGENT_PORT=8891

# BFF internal tool endpoint (set by BFF at request time; not configured here)
# BFF_TOOL_URL=http://127.0.0.1:3001/internal/agent-tool
# BFF_INTERNAL_SECRET=<set in demo_api_server/.env>

# OpenAI model
OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY: configure this setting for openai_agent/.env.example; see the service documentation.
OPENAI_API_KEY=<your-openai-api-key>
