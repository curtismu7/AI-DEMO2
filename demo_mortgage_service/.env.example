# banking_mortgage_service — Path A backend
MORTGAGE_SERVICE_PORT=8082
MORTGAGE_SERVICE_HOST=127.0.0.1
# Shared secret the gateway uses to call this service.
# Must match DEMO_MORTGAGE_SERVICE_KEY on the MCP gateway.
# Do NOT use demo-mortgage-key-0000 — the service rejects that committed default.
MORTGAGE_SERVICE_API_KEY=mortgage-compose-dev-key
