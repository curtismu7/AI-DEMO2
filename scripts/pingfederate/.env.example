# Copy to .env locally; never commit the copied file.
PINGFEDERATE_PROFILE_PATH=/absolute/path/to/prepared-pingfederate-profile
PINGFEDERATE_ADMIN_PASSWORD=replace-with-a-local-admin-password

# Keep this pinned. Do not use :latest.
PINGFEDERATE_IMAGE=pingidentity/pingfederate:13.1.2-alpine_3.24.1-al25-edge@sha256:996ad6caba201cbf22bfdfa55d09f4726c0f001c2f7ec60a0b78181f3deaa805
PINGFEDERATE_CONTAINER_NAME=ai-demo-pingfederate
PINGFEDERATE_VOLUME_NAME=ai-demo-pingfederate-out
PINGFEDERATE_NETWORK_NAME=ai-demo_ai-demo
PINGFEDERATE_ADMIN_PORT=9999
PINGFEDERATE_ENGINE_PORT=9031
