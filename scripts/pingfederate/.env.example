# Copy to .env locally; never commit the copied file.
PINGFEDERATE_PROFILE_PATH=/absolute/path/to/prepared-pingfederate-profile
PINGFEDERATE_ADMIN_PASSWORD=replace-with-a-local-admin-password

# Keep this pinned. Do not use :latest.
PINGFEDERATE_IMAGE=pingidentity/pingfederate:13.1.3-alpine_3.24.2-al25-edge@sha256:522cca2db24360fba3fffb90ce099e9ebdf3f59112a742cfed5d8d3109569655
PINGFEDERATE_CONTAINER_NAME=ai-demo-pingfederate
PINGFEDERATE_VOLUME_NAME=ai-demo-pingfederate-out
PINGFEDERATE_NETWORK_NAME=ai-demo_ai-demo
PINGFEDERATE_ADMIN_PORT=9999
PINGFEDERATE_ENGINE_PORT=9031
PINGFEDERATE_LOG_VOLUME_NAME=ai-demo-pingfederate-bootstrap

# Send server.log and audit.log to the existing Privilege Elasticsearch cluster.
# Keep the Filebeat version aligned with the Elasticsearch deployment.
ELASTIC_STACK_VERSION=replace-with-the-elasticsearch-version
ELASTICSEARCH_URL=https://replace-with-a-docker-reachable-elasticsearch-host:9200
ELASTICSEARCH_USERNAME=replace-with-a-dedicated-pf-log-ingestion-user
ELASTICSEARCH_PASSWORD=replace-with-the-ingestion-password
