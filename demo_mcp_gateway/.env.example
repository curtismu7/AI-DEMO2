# banking-mcp-gateway — environment variables
# Copy to .env and fill in real values

# =============================================================================
# SERVER
# =============================================================================
PORT=3005
HOST=0.0.0.0

# =============================================================================
# GATEWAY OAUTH CLIENT (mcp-gw in PingOne)
# This client's credentials are used as the actor token source in RFC 8693 re-exchange.
# Create a Worker Application in PingOne with grant_type=token-exchange allowed.
# =============================================================================
MCP_GW_CLIENT_ID=your-mcp-gw-client-id
MCP_GW_CLIENT_SECRET=your-mcp-gw-client-secret

# =============================================================================
# PINGONE
# =============================================================================
PINGONE_ENVIRONMENT_ID=your-pingone-env-id
PINGONE_REGION=com
PINGONE_TOKEN_ENDPOINT=https://auth.pingone.com/YOUR_ENV_ID/as/token

# =============================================================================
# GATEWAY RESOURCE URI
# This is the `aud` value that agent1 must request when exchanging for a GW-scoped token.
# Register this as the resource_uri on the MCP Gateway Resource in PingOne.
# =============================================================================
MCP_GW_RESOURCE_URI=mcpgateway.ping.demo

# =============================================================================
# BACKEND MCP SERVERS
# =============================================================================
# mcp-olb (banking_mcp_server)
MCP_OLB_WS_URL=ws://localhost:8080
MCP_OLB_RESOURCE_URI=mcpserver.ping.demo

# mcp-invest (banking_mcp_invest)
MCP_INVEST_WS_URL=ws://localhost:8081
MCP_INVEST_RESOURCE_URI=https://mcp-invest.ping.demo

# =============================================================================
# PINGONE AUTHORIZE / P1AZ (optional — leave blank or set to false to use local scope evaluation)
#
# MCP_GW_P1AZ_ENABLED — feature flag. Set to true to activate live P1AZ policy decisions.
#   false (default): local scope evaluation always runs, regardless of endpoint config.
#                    Credentials can be pre-configured without activating the feature.
#   true + endpoint set: calls real P1AZ Sideband API per request.
#   true + endpoint blank: logs a warning, falls back to local scope evaluation (no crash).
#
# When PingGateway is deployed in front of this gateway, set MCP_GW_P1AZ_ENABLED=false
# here — PingGateway's PingAuthorizeFilter becomes the sole P1AZ enforcement point,
# avoiding double-calling the policy per request.
# =============================================================================
MCP_GW_P1AZ_ENABLED=false
PINGAUTHORIZE_ENDPOINT=
PINGAUTHORIZE_WORKER_ID=
# --- DPoP (RFC 9449) + RAR (RFC 9396) enforcement (paired with BFF ff_dpop / ff_rar) ---
# REQUIRE_DPOP_PROOF: when true, reject tool calls whose token is not DPoP-bound or whose
#   proof fails verification (otherwise the gateway only observes + logs). Default false.
REQUIRE_DPOP_PROOF=false
# DPOP_PROOF_LIFETIME_SECS: max age (seconds) accepted for a DPoP proof's iat. Default 60.
DPOP_PROOF_LIFETIME_SECS=60
# REQUIRE_RAR_INTENT: when true, enforce tool-call params are a subset of the granted
#   authorization_details (and require them to be present). Default false.
REQUIRE_RAR_INTENT=false
# GW_MCP_BRIDGE_SECRET: optional shared secret sent with X-DPoP-Verified on the internal
#   gateway->MCP hop. When set (here AND on the MCP server) a direct caller cannot spoof
#   the verified flag. Leave blank for the demo default (no internal-hop guard).
GW_MCP_BRIDGE_SECRET=
# Token introspection — set to the authz-server (or real PingOne) introspect endpoint.
# Leave blank to skip introspection (tokens assumed active without verification).
GW_INTROSPECTION_ENDPOINT=http://localhost:9001/as/introspect
# RFC 7662 introspection MUST use the credentials of the client that issued/exchanged the token.
# Per RFC 7662, the introspecting client must own the token's audience — set these to the
# MCP Exchanger client credentials, NOT the gateway client. If unset, falls back to MCP_GW_CLIENT_ID
# which will cause PingOne to return active=false (wrong issuer), causing token rejection.
GW_INTROSPECTION_CLIENT_ID=
GW_INTROSPECTION_CLIENT_SECRET=

# =============================================================================
# HITL SERVICE (optional — leave blank to return HITL error without creating a challenge)
# When set: INDETERMINATE PA decisions create a challenge in the HITL service
# and return the challengeId to the agent for retry.
# =============================================================================
HITL_SERVICE_URL=http://localhost:3009

# =============================================================================
# OPTIONAL TUNING
# =============================================================================
GW_TOOL_CALL_TIMEOUT_MS=30000

# =============================================================================
# PORTABLE ENCRYPTED CREDENTIAL VAULT (Phase 269)
# =============================================================================
# The gateway can read MCP_GW_*, PROVIDER_*, HELIX_*, and BFF_INTERNAL_*
# entries from a shared encrypted vault (secrets.vault at repo root). Set
# VAULT_PATH if your vault lives elsewhere; set VAULT_PASSWORD to unlock the
# vault at startup. The gateway deletes VAULT_PASSWORD from process.env
# immediately after opening the vault.
#
# NOTE: In a standard install, banking_mcp_gateway/.env is typically a
# symlink to banking_api_server/.env (created by run-bank.sh's
# ensure_service_env helper). Plan 05's setupFresh.js writes VAULT_PATH into
# the BFF's .env, which the gateway then sees via the symlink. You do NOT
# need to set VAULT_PATH in both places.
#
# ⚠️  No password recovery — see banking_api_server/.env.example.
#
# Quote secrets per CLAUDE.md rule (special chars ~ . - break shell parsing):
#   VAULT_PATH="/etc/banking/secrets.vault"
#   VAULT_PASSWORD="your-strong-passphrase-here"
#
# Allowlist regex for vault keys: /^(MCP_GW_|PROVIDER_|HELIX_|BFF_INTERNAL_)[A-Z0-9_]+$/
# Entries outside this allowlist are LOGGED and SKIPPED (no env injection).
#
# Vercel: skipped when VERCEL=1.
# =============================================================================
# VAULT_PATH=
# VAULT_PASSWORD=

# =============================================================================
# UC18 -- Gateway rate limiting (default: disabled)
# Enable per-agent/per-tool sliding-window rate limiting at the gateway.
# Returns 429 (rate_limited) when maxRequests is exceeded within the window.
# The BFF feature flag ff_mcp_rate_limit documents intent; this env var is the
# actual gate (the gateway has no access to the BFF configStore).
# =============================================================================
# GATEWAY_RATE_LIMIT_ENABLED=true
# GATEWAY_RATE_LIMIT_MAX_REQUESTS=20    # max calls per window per (agentSub, toolName)
# GATEWAY_RATE_LIMIT_WINDOW_MS=60000    # sliding window duration in ms (default: 60s)
