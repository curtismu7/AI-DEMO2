# Start with an empty context and allow only the gateway build inputs.
**
!scope-topology.json
!mcp-tool-schemas.json
!demo_mcp_gateway/
!demo_mcp_gateway/package*.json
!demo_mcp_gateway/tsconfig.json
!demo_mcp_gateway/src/
!demo_mcp_gateway/src/**
!oauth-mcp/
!oauth-mcp/openapi/
!oauth-mcp/openapi/**
!demo_mcp_resource_server/
!demo_mcp_resource_server/openapi/
!demo_mcp_resource_server/openapi/**

# Keep secrets, dependency trees, VCS data, and generated/runtime clutter out.
demo_mcp_gateway/node_modules
oauth-mcp/node_modules
demo_mcp_resource_server/node_modules
**/.git
**/.git/**
**/node_modules
**/node_modules/**
**/.venv
**/.venv/**
**/venv
**/venv/**
**/__pycache__
**/__pycache__/**
**/*.pyc
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.crt
**/*.p12
**/*.pfx
**/*.log
**/coverage
**/coverage/**
**/.cache
**/.cache/**
**/.turbo
**/.turbo/**
