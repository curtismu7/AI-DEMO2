{
  "name": "oauth-mcp",
  "version": "1.0.0",
  "description": "OAuth-compliant MCP server with full Authorization Server",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:clean": "rm -rf dist && npm run build",
    "build:prod": "NODE_ENV=production npm run build:clean",
    "dev": "NODE_ENV=development nodemon --exec ts-node src/index.ts",
    "dev:debug": "NODE_ENV=development nodemon --inspect --exec ts-node src/index.ts",
    "start": "NODE_ENV=production node dist/index.js",
    "start:dev": "NODE_ENV=development node dist/index.js",
    "start:staging": "NODE_ENV=staging node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "test": "NODE_ENV=test jest --forceExit",
    "test:unit": "NODE_ENV=test jest --testPathIgnorePatterns=integration --forceExit",
    "test:integration": "NODE_ENV=test jest --testPathPattern=integration --forceExit",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage",
    "test:ci": "NODE_ENV=test jest --ci --coverage --watchAll=false --forceExit",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "lint:fix": "eslint src/**/*.ts tests/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run test:ci",
    "health-check": "node scripts/health-check.js",
    "config:validate": "node scripts/validate-config.js",
    "config:example": "node scripts/create-example-config.js",
    "docker:build": "docker build -t demo-mcp-server .",
    "docker:run": "docker run -p 8080:8080 --env-file .env demo-mcp-server",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d"
  },
  "keywords": [
    "mcp",
    "banking",
    "server"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.5.0",
    "nodemon": "^3.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/auto-instrumentations-node": "^0.59.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.200.0",
    "@opentelemetry/sdk-node": "^0.200.0",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.5.0",
    "@upstash/redis": "^1.37.0",
    "axios": "^1.6.0",
    "dotenv": "^17.2.2",
    "jose": "^6.2.3",
    "jsonschema": "^1.4.1",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "selfsigned": "^5.5.0",
    "uuid": "^14.0.0",
    "ws": "^8.14.0"
  },
  "mcpServers": {
    "super-banking": {
      "transport": "http",
      "url": "http://localhost:8080/mcp",
      "description": "Super Banking Banking MCP Server — provides banking tools for AI agents",
      "auth": {
        "type": "oauth2",
        "discovery_url": "http://localhost:8080/.well-known/mcp-server"
      }
    }
  }
}
