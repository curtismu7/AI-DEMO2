# AI Demo MCP Server Configuration Example
# Copy this file to .env.development or .env.production and update with your values
# Monorepo catalog (shared keys & Backend-for-Frontend (BFF) vars): ../.env.example

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
NODE_ENV=development
LOG_LEVEL=INFO

# =============================================================================
# HTTP MCP TRANSPORT (MCP spec 2025-11-25 — Phase D)
# Adds RFC 9728 Protected Resource Metadata + POST /mcp Streamable HTTP endpoint
# alongside the existing WebSocket transport. Both can run simultaneously.
# =============================================================================
# Set to 'false' to disable the HTTP MCP endpoint (WebSocket is never affected)
HTTP_MCP_TRANSPORT_ENABLED=true

# Public base URL of this server — used in RFC 9728 metadata and WWW-Authenticate
# e.g. https://mcp.myapp.com   or   http://localhost:8080 for local dev
MCP_RESOURCE_URL=http://localhost:8080

# Resource URI used for RFC 8707 audience validation on every inbound agent token.
# When set, TokenIntrospector will reject tokens whose `aud` claim does not include this value.
# Recommended: set to the same value as MCP_RESOURCE_URL.
# Leave blank to skip audience validation (not recommended for production).
# MCP_SERVER_RESOURCE_URI=http://localhost:8080

# Comma-separated Origins allowed to POST to /mcp.
# Leave blank to allow all origins (suitable for server-to-server or demo use).
# Example: https://claude.ai,https://cursor.so
MCP_ALLOWED_ORIGINS=

# =============================================================================
# MCP SERVER CONFIGURATION
# =============================================================================
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8080
MCP_SERVER_MAX_CONNECTIONS=100
MCP_SERVER_SESSION_TIMEOUT=3600

# =============================================================================
# PINGONE ADVANCED IDENTITY CLOUD CONFIGURATION (REQUIRED)
# =============================================================================
# Get these values from your PingOne AI IAM Core environment
PINGONE_BASE_URL=https://your-environment.pingidentity.com
PINGONE_CLIENT_ID=your-client-id
PINGONE_CLIENT_SECRET=your-client-secret
PINGONE_INTROSPECTION_ENDPOINT=https://your-environment.pingidentity.com/as/introspect
PINGONE_AUTHORIZATION_ENDPOINT=https://your-environment.pingidentity.com/as/authorize
PINGONE_TOKEN_ENDPOINT=https://your-environment.pingidentity.com/as/token
# JWKS used to verify inbound agent-token signatures. MUST be the AUTH host's
# OIDC JWKS (.../as/jwks). If unset, the resolver falls back to
# PINGONE_BASE_URL + /jwks, which on PingOne is the Management API host and
# returns 403 — making every agent token signature check fail (401 -> logout).
PINGONE_JWKS_URI=https://your-environment.pingidentity.com/as/jwks

# PingOne app used ONLY for oauth-mcp's own /authorize redirect-federation hop
# (RP role — oauth-mcp logs a real user into PingOne, then mints its own
# downstream token). Distinct from every other PINGONE_* app in this file.
# Create via PingOne console/pingcli: authorization_code grant, PKCE, single
# redirect_uri = <OAUTH_ISSUER or derived https://<host>:<MCP_SERVER_PORT>>/authorize/callback
OAUTH_MCP_PINGONE_CLIENT_ID=
OAUTH_MCP_PINGONE_CLIENT_SECRET=

# Initial access token gating RFC 7591 Dynamic Client Registration (§3.1):
# POST /register requires `Authorization: Bearer <this value>`. Unset (default)
# = /register returns 503 temporarily_unavailable — registration is CLOSED until
# an operator provisions a secret here (generate with: openssl rand -base64 32).
DCR_INITIAL_ACCESS_TOKEN=

# Admit MCP clients this server has never seen. ChatGPT and Claude cannot be
# pre-registered and offer no field for the initial access token above, so
# reaching them means opening registration. Turning this on enables BOTH ways an
# unknown client can identify itself:
#   - RFC 7591 open registration: POST /register with no initial access token
#   - CIMD: an https client_id URL serving the client's own metadata document
#     (draft-ietf-oauth-client-id-metadata-document), advertised as
#     client_id_metadata_document_supported in the AS metadata
# The escalation the initial-access-token gate protected against is closed a
# different way: a self-admitted client's scope is pinned server-side (below)
# and never read from its request. If DCR_INITIAL_ACCESS_TOKEN is also set it is
# still enforced, and such a registration may name its own scope.
MCP_OPEN_CLIENT_REGISTRATION=false

# Scope granted to a self-admitted client. Deliberately read-only by default:
# a caller that walked in off the internet should not get write.
DCR_OPEN_REGISTRATION_SCOPE=mcp:invoke read

# Optional strict allowlist of hostnames a CIMD document may be fetched from,
# comma-separated (e.g. chatgpt.com,claude.ai). Unset = any public https host is
# allowed; loopback and private-network literals are refused either way.
CIMD_ALLOWED_HOSTS=

# =============================================================================
# BANKING API CONFIGURATION
# =============================================================================
BANKING_API_BASE_URL=https://api.ping.demo:3001
BANKING_API_TIMEOUT=30000
BANKING_API_MAX_RETRIES=3
BANKING_API_CIRCUIT_BREAKER_THRESHOLD=5

# Per-request timeout for tool execution (ms). Applies to executeTool only; CIBA waits are excluded.
# Spec SHOULD: MCP 2025-11-25 §lifecycle/timeouts
TOOL_CALL_TIMEOUT_MS=30000

# =============================================================================
# SECURITY CONFIGURATION (REQUIRED)
# =============================================================================
# Generate a secure 64+ character encryption key
# You can use: openssl rand -base64 48
ENCRYPTION_KEY=your-64-character-encryption-key-here-replace-with-secure-key

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================
TOKEN_STORAGE_PATH=./data/tokens
SESSION_STORAGE_PATH=./data/sessions
TOKEN_CACHE_TTL_SECONDS=3600
SESSION_CLEANUP_INTERVAL_SECONDS=300

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
AUDIT_LOG_PATH=./logs/audit.log
SECURITY_LOG_PATH=./logs/security.log
ENABLE_DETAILED_LOGGING=false

# =============================================================================
# DEVELOPMENT SETTINGS (Development environment only)
# =============================================================================
# Uncomment for development
# ENABLE_DEBUG_MODE=true
# SKIP_SSL_VERIFICATION=true
# MOCK_BANKING_API=false

# =============================================================================
# PRODUCTION SETTINGS (Production environment only)
# =============================================================================
# Uncomment for production
# ENABLE_RATE_LIMITING=true
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
# ENABLE_CORS=false
# CORS_ALLOWED_ORIGINS=https://your-frontend.com

# =============================================================================
# MONITORING AND HEALTH CHECKS
# =============================================================================
HEALTH_CHECK_INTERVAL_SECONDS=30

# =============================================================================
# CIBA — CLIENT-INITIATED BACKCHANNEL AUTHENTICATION
# =============================================================================
# When true the MCP server will send push notifications instead of redirect URLs
CIBA_ENABLED=false
# Binding message shown on the phone push notification
CIBA_BINDING_MESSAGE=Banking App – AI Assistant
# Poll interval between /token polls (milliseconds)
CIBA_POLL_INTERVAL_MS=5000
# Maximum seconds to wait for user approval before giving up
CIBA_MAX_WAIT_SECONDS=300
ENABLE_METRICS=true
METRICS_PORT=9090

# --- DPoP (RFC 9449) bridged enforcement ---
# REQUIRE_DPOP_PROOF: when true, the MCP server requires the gateway's X-DPoP-Verified
#   assertion (the gateway does the real proof crypto on the BFF->gateway hop). Default false.
REQUIRE_DPOP_PROOF=false
# GW_MCP_BRIDGE_SECRET: must match the gateway's value. X-DPoP-Verified is only trusted
#   when accompanied by this secret — prevents a direct caller from spoofing it.
#   REQUIRED when REQUIRE_DPOP_PROOF=true: an unset secret means the header cannot be
#   authenticated, so the server refuses the request rather than trusting it.
GW_MCP_BRIDGE_SECRET=

# --- Delegation chain (RFC 8693 `act`) enforcement — F10 ---
# MCP_ALLOWED_ACTORS: comma-separated allow-list of actor client-ids permitted to act
#   for a user at this server (i.e. the gateway's client id). The gateway verifies the
#   actor chain; this re-checks it at the final hop so the fact is not discarded.
#   Unset (default) = gate disarmed; it logs an explicit `ran=false skipReason=...`
#   marker so an unarmed gate is never mistaken for a PERMIT.
#   Once set the gate is FAIL-CLOSED: a token with no `act` claim is rejected.
#   Do NOT set this until the gateway sends `actor_token` on its RFC 8693 Exchange #3
#   (demo_mcp_gateway/src/auth/McpTokenExchangeClient.ts) — until then the issued token
#   carries no `act` and every call would be denied.
#
#   KNOWN INTERACTION (accepted, not a bug): tokens self-issued by this server's
#   own embedded AS — i.e. anything minted through DCR /register + /token, for
#   BOTH client_credentials and authorization_code — carry no `act` claim, since
#   a directly-issued token has no delegation chain by definition. Setting
#   MCP_ALLOWED_ACTORS to a non-empty value therefore REJECTS every self-issued /
#   DCR token as well. The gate is deliberately not exempted for them: it is a
#   separate fail-closed control, and "no provable delegation chain" is exactly
#   what it exists to refuse. If you need both, do not arm this gate.
MCP_ALLOWED_ACTORS=

# =============================================================================
# DOCKER CONFIGURATION (Docker deployments only)
# =============================================================================
# Uncomment for Docker
# DOCKER_INTERNAL_PORT=8080
# DOCKER_DATA_VOLUME=/app/data
# DOCKER_LOGS_VOLUME=/app/logs