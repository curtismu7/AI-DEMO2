# Shared PingOne environment for this project.
PINGONE_ENVIRONMENT_ID=01d89b06-66d5-430e-9f28-65636843788b

# banking-hitl-service — environment variables

# PORT: configure this setting for demo_hitl_service/.env.example; see the service documentation.
PORT=3009
# HOST: configure this setting for demo_hitl_service/.env.example; see the service documentation.
HOST=0.0.0.0

# =============================================================================
# NOTIFICATION MODE
# Options: log (dev, no external calls), ciba (PingOne push/email), email (SMTP via BFF)
# =============================================================================
HITL_NOTIFY_MODE=log

# URL shown in approval notifications — must reach the OLB dashboard
HITL_DASHBOARD_URL=https://demo-api-server:3001/dashboard/approve

# =============================================================================
# CIBA (when HITL_NOTIFY_MODE=ciba)
# =============================================================================
PINGONE_CIBA_ENDPOINT=https://auth.pingone.com/YOUR_ENV_ID/as/bc-authorize
# HITL_CLIENT_ID: configure this setting for demo_hitl_service/.env.example; see the service documentation.
HITL_CLIENT_ID=your-hitl-client-id
# HITL_CLIENT_SECRET: configure this setting for demo_hitl_service/.env.example; see the service documentation.
HITL_CLIENT_SECRET=your-hitl-client-secret

# =============================================================================
# EMAIL (when HITL_NOTIFY_MODE=email)
# Email notifications are sent via the BFF's internal email endpoint
# =============================================================================
BANKING_API_BASE_URL=https://api.ping.demo:3001

# =============================================================================
# CORS
# Comma-separated origins allowed to call this service (OLB App + MCP Gateway)
# Defaults: UI (demo-api-server:3001), BFF (api.ping.demo:3001), MCP Gateway (localhost:3005)
# =============================================================================
HITL_ALLOWED_ORIGINS=https://demo-api-server:3001,https://api.ping.demo:3001,http://localhost:3005
