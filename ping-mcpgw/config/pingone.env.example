# PingOne Privilege MCPGW — OIDC configuration
# Copy to pingone.env and fill in values.
# This file is mounted into the container at /var/lib/procyon/config/pingone.env.
#
# Values come from the MCPGW application you create in the PingOne admin console
# under AI Security > Agentic Apps. See ping-mcpgw/README.md for full setup steps.

# Public URL of this MCPGW (must match the Redirect URI registered in PingOne).
# Callback URI registered in PingOne must be: ${SERVER_URL}/callback
SERVER_URL=https://<mcpgw-dns>:8623

# OIDC application credentials (from the MCPGW app in PingOne admin console).
OIDC_CLIENT_ID=<client-id>
OIDC_CLIENT_SECRET=<client-secret>

# PingOne authorization server endpoints — replace <env-id> with your environment ID.
OIDC_AUTH_URL=https://auth.pingone.com/<env-id>/as/authorize
OIDC_TOKEN_URL=https://auth.pingone.com/<env-id>/as/token
OIDC_USER_URL=https://auth.pingone.com/<env-id>/as/userinfo

OIDC_SCOPES=openid profile email
