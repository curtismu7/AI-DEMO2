# Server port (also used to compute the OAuth redirect URI in production mode).
PORT=3910

# ── The gateway to test against ─────────────────────────────────────────────
# Defaults to the public Ping AI Demo's Privilege AI Gateway — works with zero
# setup (it's a self-advertising AS: Dynamic Client Registration, no client_id
# needed). Point PRIVILEGE_GATEWAY_HOST at your own Privilege AI Gateway (or
# any other RFC 9728/8414-advertising MCP gateway) to test that instead.
# PRIVILEGE_GATEWAY_HOST=https://mcpgw.ai-demo.ping-devops.com
# PRIVILEGE_GATEWAY_APP=opensearch22
# PRIVILEGE_GATEWAY_APP_OPENSEARCH=opensearch
# PRIVILEGE_GATEWAY_APP_BRAVE=brave

# "Direct" mode — no Privilege in the path. Defaults to the same AI Demo's
# façade (also a self-advertising, open-DCR AS — zero setup). Override to
# compare against any MCP server you run yourself.
# DIRECT_MCP_URL=
# DIRECT_BRAVE_MCP_URL=

# Only needed if the gateway does NOT self-advertise its own OAuth endpoints
# (Dynamic Client Registration / RFC 9728) and you need the PingOne OIDC
# discovery fallback, or a static client id instead of DCR:
# PINGONE_ENVIRONMENT_ID=
# GATEWAY_CLIENT_ID=
# GATEWAY_CLIENT_SECRET=
# LOGIN_HINT=you@example.com

# ── Optional: discover doors from the Privilege console ────────────────────
# Paste your console session's `auth_token` cookie value into the "Connect
# Privilege console" form in the UI — this env var only supplies the
# environment id used to scope that lookup.
# PRIVILEGE_CONSOLE_ENV_ID=

# Where saved door-discovery results and (if you edit them) gateway OIDC
# settings are stored (default: ~/.ai-gateway-client/).
# DOOR_STORE_DIR=
# GATEWAY_ENV_PATH=
