# Server port (also used to compute the PingOne redirect URI below).
PORT=3900

# Where saved server profiles are stored (default: ~/.mcp-inspector/profiles.json)
# PROFILE_STORE_DIR=/some/other/path

# ── Optional: PingOne hosted MCP server ────────────────────────────────────
# The "PingOne" tab defaults to the public Ping AI Demo's own PingOne
# environment and OIDC app — works with zero setup as long as PORT stays
# 3900 (that's the port its redirect URI was registered for). To test your
# own PingOne environment instead, create your own OIDC app:
#   - Grant type: Authorization Code (+ Refresh Token optional)
#   - Token endpoint auth method: None (public client)
#   - PKCE: S256 required
#   - Redirect URI: http://127.0.0.1:3900/api/pingone/callback
#     (must match PORT above)
# PINGONE_ENVIRONMENT_ID=
# PINGONE_REGION=com
# PINGONE_MCP_CLIENT_ID=

# In dev (`npm run dev` in web/), set this to the Vite dev server URL so the
# PingOne login redirect lands back on it instead of the bare API server.
# WEB_URL=http://127.0.0.1:5173
