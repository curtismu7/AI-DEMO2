# banking-agent-service — environment variables
# Copy to .env and fill in real values

# =============================================================================
# SERVER
# =============================================================================
PORT=3006
# HOST: configure this setting for demo_agent_service/.env.example; see the service documentation.
HOST=0.0.0.0

# =============================================================================
# AGENT1 OAUTH CLIENT (agent1 in PingOne)
# Used to acquire the actor_token for RFC 8693 token exchange.
# Create a Worker Application in PingOne with grant_type=token-exchange allowed.
# =============================================================================
AGENT_CLIENT_ID=your-agent1-client-id
# AGENT_CLIENT_SECRET: configure this setting for demo_agent_service/.env.example; see the service documentation.
AGENT_CLIENT_SECRET=your-agent1-client-secret

# =============================================================================
# PINGONE
# =============================================================================
PINGONE_ENVIRONMENT_ID=01d89b06-66d5-430e-9f28-65636843788b
# PINGONE_TOKEN_ENDPOINT: configure this setting for demo_agent_service/.env.example; see the service documentation.
PINGONE_TOKEN_ENDPOINT=https://auth.pingone.com/YOUR_ENV_ID/as/token

# =============================================================================
# BFF TOOL CALLBACK URL
# URL the agent service POSTs back to for tool execution.
# run.sh injects this automatically. Only set here for direct invocation.
# In Docker/k8s: http://banking-api-server:3001/internal/agent-tool
# =============================================================================
BFF_TOOL_URL=http://127.0.0.1:3001/internal/agent-tool

# =============================================================================
# MCP GATEWAY
# =============================================================================
MCP_GATEWAY_WS_URL=ws://localhost:3005
# MCP_GW_RESOURCE_URI: configure this setting for demo_agent_service/.env.example; see the service documentation.
MCP_GW_RESOURCE_URI=mcpgateway.ping.demo

# =============================================================================
# LLM PROVIDER
# Options: anthropic, openai, none (echo mode — no API key needed)
# =============================================================================
LLM_PROVIDER=none
# LLM_API_KEY: configure this setting for demo_agent_service/.env.example; see the service documentation.
LLM_API_KEY=
# LLM_MODEL: configure this setting for demo_agent_service/.env.example; see the service documentation.
LLM_MODEL=claude-sonnet-4-6
# Anthropic — set LLM_PROVIDER=anthropic and provide your key to use Claude
ANTHROPIC_API_KEY=

# =============================================================================
# PINGONE PRIVILEGE LLM LANES (ff_privilege_llm_first on the BFF)
# The BFF resolves google -> privilege_llm and anthropic -> privilege_claude;
# reasonOnce maps those to the gateway's virtual-key lanes. Same values as
# demo_api_server/.env — this service has no access to that file.
# =============================================================================
PRIVILEGE_LLM_GATEWAY_URL=
# PRIVILEGE_LLM_VIRTUAL_KEY_ANTHROPIC: configure this setting for demo_agent_service/.env.example; see the service documentation.
PRIVILEGE_LLM_VIRTUAL_KEY_ANTHROPIC=
# PRIVILEGE_LLM_VIRTUAL_KEY_GOOGLE: configure this setting for demo_agent_service/.env.example; see the service documentation.
PRIVILEGE_LLM_VIRTUAL_KEY_GOOGLE=

# =============================================================================
# PKI CREDS (Phase G — optional)
# When true, agent uses private_key_jwt instead of client_secret.
# Requires AGENT_CERT_PATH pointing to a PKCS#12 certificate.
# =============================================================================
USE_PKI_AGENT_CREDS=false
# AGENT_CERT_PATH: configure this setting for demo_agent_service/.env.example; see the service documentation.
AGENT_CERT_PATH=
