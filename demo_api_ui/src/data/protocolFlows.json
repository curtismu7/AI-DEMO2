{
  "ciba-hitl": {
    "id": "ciba-hitl",
    "name": "CIBA Human-in-the-Loop",
    "description": "Client-Initiated Backchannel Authentication with human approval",
    "actors": [
      "client-app",
      "auth-server",
      "human-approver"
    ],
    "steps": [
      {
        "id": "step-1",
        "actor": "client-app",
        "fromActor": "client-app",
        "toActor": "auth-server",
        "action": "POST /api/auth/ciba/initiate",
        "label": "POST /api/auth/ciba/initiate",
        "method": "POST",
        "endpoint": "/api/auth/ciba/initiate",
        "body": { "binding_message": "Approve transfer" },
        "step": 1,
        "responseMap": { "authReqId": "auth_req_id" },
        "expected": {}
      },
      {
        "id": "step-2",
        "actor": "human-approver",
        "fromActor": "human-approver",
        "toActor": "auth-server",
        "action": "POST /api/auth/ciba/approve-now/:authReqId",
        "label": "POST /api/auth/ciba/approve-now/:authReqId",
        "method": "POST",
        "endpoint": "/api/auth/ciba/approve-now/:authReqId",
        "step": 2,
        "expected": {}
      },
      {
        "id": "step-3",
        "actor": "client-app",
        "fromActor": "client-app",
        "toActor": "auth-server",
        "action": "GET /api/auth/ciba/poll/:authReqId",
        "label": "GET /api/auth/ciba/poll/:authReqId",
        "method": "GET",
        "endpoint": "/api/auth/ciba/poll/:authReqId",
        "step": 3,
        "expected": {}
      }
    ],
    "branches": []
  },
  "dpop": {
    "id": "dpop",
    "name": "DPoP Sender-Constrained Token",
    "description": "RFC 9449 — a token bound to the client's key, then replayed at the gateway. The demo routes require the DPoP header to be present; they do not verify the proof signature.",
    "actors": [
      "client-app",
      "gateway"
    ],
    "steps": [
      {
        "id": "step-1",
        "actor": "client-app",
        "fromActor": "client-app",
        "toActor": "gateway",
        "action": "POST /api/auth/oauth/token",
        "label": "Request a DPoP-bound token",
        "method": "POST",
        "endpoint": "/api/auth/oauth/token",
        "headers": { "DPoP": "demo-proof-jwt-not-verified" },
        "body": {
          "grant_type": "urn:ietf:params:oauth:grant-type:token-exchange",
          "scope": "transfer:write",
          "subject_token": "demo-subject-token",
          "resource": "https://mcpgateway.ping.demo"
        },
        "step": 1,
        "responseMap": { "accessToken": "access_token" },
        "expected": {}
      },
      {
        "id": "step-2",
        "actor": "gateway",
        "fromActor": "gateway",
        "toActor": "client-app",
        "action": "POST /api/auth/gateway/verify-dpop",
        "label": "Gateway verifies the proof binding",
        "method": "POST",
        "endpoint": "/api/auth/gateway/verify-dpop",
        "headers": { "DPoP": "demo-proof-jwt-not-verified" },
        "body": { "access_token": ":accessToken" },
        "step": 2,
        "expected": {}
      }
    ],
    "branches": []
  },
  "rfc8693-token-exchange": {
    "id": "rfc8693-token-exchange",
    "name": "RFC 8693 Token Exchange",
    "description": "Real PingOne token exchange driven by the signed-in session token — Exchange #1 on its own, then the two-exchange agent chain.",
    "actors": [
      "client-app",
      "token-exchanger"
    ],
    "steps": [
      {
        "id": "step-1",
        "actor": "client-app",
        "fromActor": "client-app",
        "toActor": "token-exchanger",
        "action": "POST /api/tokens/exchange-test (single)",
        "label": "Exchange #1 — session token to mcpgateway.ping.demo",
        "method": "POST",
        "endpoint": "/api/tokens/exchange-test",
        "body": {
          "mode": "single",
          "audience": "mcpgateway.ping.demo",
          "scopes": ["read", "write"]
        },
        "step": 1,
        "expected": {}
      },
      {
        "id": "step-2",
        "actor": "token-exchanger",
        "fromActor": "token-exchanger",
        "toActor": "client-app",
        "action": "POST /api/tokens/exchange-test (double)",
        "label": "Two-exchange chain — user to agent to MCP resource",
        "method": "POST",
        "endpoint": "/api/tokens/exchange-test",
        "body": {
          "mode": "double",
          "scopes": ["read", "write"]
        },
        "step": 2,
        "expected": {}
      }
    ],
    "branches": []
  },
  "par": {
    "id": "par",
    "name": "PAR Intent Binding",
    "description": "RFC 9126 — pushes authorization_details to the real PingOne as/par endpoint, then enforces the $100 declared-intent cap against the returned request_uri.",
    "actors": [
      "client-app",
      "auth-server"
    ],
    "steps": [
      {
        "id": "step-1",
        "actor": "client-app",
        "fromActor": "client-app",
        "toActor": "auth-server",
        "action": "POST /api/demo/intent-binding/run ($80)",
        "label": "Push $80 intent — within the declared cap",
        "method": "POST",
        "endpoint": "/api/demo/intent-binding/run",
        "body": {
          "action": "permit",
          "requestedAmount": 80,
          "live": true
        },
        "step": 1,
        "responseMap": { "requestUri": "requestUri" },
        "expected": {}
      },
      {
        "id": "step-2",
        "actor": "client-app",
        "fromActor": "client-app",
        "toActor": "auth-server",
        "action": "POST /api/demo/intent-binding/run ($500)",
        "label": "Push $500 intent — exceeds the cap, expect DENY",
        "method": "POST",
        "endpoint": "/api/demo/intent-binding/run",
        "body": {
          "action": "permit",
          "requestedAmount": 500,
          "live": true
        },
        "step": 2,
        "expected": {}
      }
    ],
    "branches": []
  }
}
