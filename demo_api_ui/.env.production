# Shared PingOne environment for this project.
PINGONE_ENVIRONMENT_ID=01d89b06-66d5-430e-9f28-65636843788b

# On Vercel, frontend and API share the same domain — use relative URLs
REACT_APP_API_URL=
# REACT_APP_CLIENT_URL: configure this setting for demo_api_ui/.env.production; see the service documentation.
REACT_APP_CLIENT_URL=
# REACT_APP_MANAGED_DEPLOYMENT: configure this setting for demo_api_ui/.env.production; see the service documentation.
REACT_APP_MANAGED_DEPLOYMENT=true
