# The UI Dockerfile uses the repo root for llm-timeouts.json and topology exports.
# Keep this context scoped to the UI build inputs; the root .dockerignore must
# remain broader for other services that build from the repo root.
**
!demo_api_ui
!demo_api_ui/**
!llm-timeouts.json
!docs/
!docs/exports/
!docs/exports/server-topology-lucidchart.csv
!docs/exports/server-topology-details.csv

# The cross-repo readiness check runs from a read-only BuildKit bind mount in
# the builder. Keep its UI-only output image small while exposing its inputs.
!scripts/
!scripts/check-demo-readiness-contract.mjs
!scope-topology.json
!ping-gateway/
!ping-gateway/config/
!ping-gateway/config/scope-topology.json
!demo_api_server/
!demo_api_server/config/
!demo_api_server/config/**
!demo_api_server/services/
!demo_api_server/services/demoReadinessCatalog.js
!demo_api_server/services/demoStepPrerequisites.js
!demo_api_server/services/scopeTopology.js
!demo_api_server/services/agentRegistryService.js
!demo_api_server/services/oauthClientRegistry.js
!demo_api_server/services/agentMcpTokenService.js
!demo_api_server/services/rfcCompliantErrorHandler.js
!demo_api_server/routes/
!demo_api_server/routes/intentBinding.js
!demo_api_server/tests/
!demo_api_server/tests/routes/
!demo_api_server/tests/demoReadinessExecutionService.test.js
!demo_api_server/tests/routes/pfDavinciAuth.test.js
!demo_api_ui/tests
!demo_api_ui/tests/**

# Re-including the BFF source directory must not admit installed or runtime
# state from the host checkout into the UI-only build context.
demo_api_server/node_modules
demo_api_server/**/node_modules
demo_api_server/data
demo_api_server/.env
demo_api_server/.env.*
demo_api_server/test-results

# The UI image build does not consume local dependencies or generated/test data.
demo_api_ui/node_modules
demo_api_ui/build
demo_api_ui/dist
demo_api_ui/.vite
demo_api_ui/coverage
demo_api_ui/e2e
demo_api_ui/docs
demo_api_ui/test-results
demo_api_ui/design
demo_api_ui/evidence
