.org/2000/svg"},["path",{"fill":"none","d":"M0 0h24v24H0z"}],["path",{"d":"M11 7 9.6 8.4l2.6 2.6H2v2h10.2l-2.6 2.6L11 17l5-5-5-5zm9 12h-8v2h8c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-8v2h8v14z"}]],["SPAN",{},"Sign In"]]],["DIV",{"class":"user-menu"},["BUTTON",{"class":"user-menu-trigger","aria-label":"User menu","type":"button"},["DIV",{"class":"user-menu-avatar"},"T"],["svg",{"stroke":"currentColor","fill":"currentColor","stroke-width":"0","viewBox":"0 0 24 24","class":"user-menu-dropdown-icon","height":"1em","width":"1em","xmlns":"http://www.w3.org/2000/svg"},["path",{"fill":"none","d":"M0 0h24v24H0z"}],["path",{"d":"m7 10 5 5 5-5z"}]]]]]]],["MAIN",{"class":"main-content"},["DIV",{"class":"user-dashboard"},["DIV",{"class":"loading","role":"status","aria-live":"polite"},"Loading your account information…"]]],["DIV",{"class":"banking-agent-float-root","data-agent-ui":"floating"},["DIV",{"class":"banking-agent-panel ba-mode-light ba-mode-inline ba-split-column ba-popout-mode","role":"dialog","aria-label":"AI Demo AI Agent"},["DIV",{"role":"button","tabindex":"-1","class":"ba-header"},["DIV",{"class":"ba-header-top"},["DIV",{"class":"ba-header-left"},["SPAN",{"class":"ba-status-dot"}],["DIV",{},["DIV",{"class":"ba-title"},"AI Demo Assistant"],["DIV",{"class":"ba-subtitle"},"Customer · Test"]]],["DIV",{"class":"ba-header-session"},["DIV",{"title":"PingOne user id"},"user-123"]],["DIV",{"class":"ba-header-tools"},["LABEL",{"class":"ctl-check ctl-check--switch ba-header-toggle-label"},["INPUT",{"__playwright_value_":"on","__playwright_checked_":"false","class":"ctl-raw","title":"Show or hide RFC token-event messages in the chat","type":"checkbox"}],["SPAN",{"class":"ctl-check-track","aria-hidden":"true"}],["SPAN",{"class":"ctl-check-text"},"RFC info"]],["LABEL",{"class":"ctl-check ctl-check--switch ba-header-toggle-label"},["INPUT",{"__playwright_value_":"on","__playwright_checked_":"false","class":"ctl-raw","title":"Show or hide the 12-step compliance status","type":"checkbox"}],["SPAN",{"class":"ctl-check-track","aria-hidden":"true"}],["SPAN",{"class":"ctl-check-text"},"Compliance"]],["LABEL",{"class":"ctl-check ctl-check--switch ba-header-toggle-label"},["INPUT",{"__playwright_value_":"on","__playwright_checked_":"false","class":"ctl-raw","title":"View Token Chain — RFC 8693 token exchange and authorization decisions (floating panel, agent stays usable)","type":"checkbox"}],["SPAN",{"class":"ctl-check-track","aria-hidden":"true"}],["SPAN",{"class":"ctl-check-text"},"Token Chain"]],["BUTTON",{"type":"button","class":"ba-actions-trigger","title":"Open Agent Demo Guide"},"Guide"],["BUTTON",{"type":"button","class":"ba-actions-trigger","aria-expanded":"false","aria-haspopup":"dialog"},"Actions ","▾"],["BUTTON",{"type":"button","class":"ba-header-signout"},"Sign out"]]]],["DIV",{"class":"ba-body"},["DIV",{"class":"ba-right-col"},["DIV",{"class":"ssb-bar","aria-label":"Simple Stepper"},["SPAN",{"class":"ssb-title"},"Simple Stepper"],["BUTTON",{"type":"button","class":"ssb-toggle","aria-expanded":"false"},"Show"]],["DIV",{"class":"banking-agent-messages"},["DIV",{"class":"banking-agent-msg assistant"},["DIV",{},["DIV",{"class":"banking-agent-msg-bubble"},["DIV",{"class":"md-content ba-msg-body"},["P",{"class":"md-para"},"Hi Test! I'm your AI assistant. I can help with your accounts, explain the OAuth flows behind the scenes, and more. What would you like to do?"]]]]],["DIV"]],["DIV",{"class":"ba-bottom"},["DIV",{"class":"ba-input-row"},["INPUT",{"__playwright_value_":"","class":"ba-input","placeholder":"Ask about your accounts…","value":""}],["BUTTON",{"type":"button","class":"ba-send-btn","disabled":"","aria-label":"Send"},"Send"]]],["DIV",{"class":"ba-bottom-extra"},["BUTTON",{"type":"button","class":"ba-start-over-btn","title":"Clear conversation and start fresh"},"Start Over"]],["DIV",{"class":"ba-token-footer"},["SPAN",{},"⬆ ","0"," in"],["SPAN",{},"⬇ ","0"," out"],["SPAN",{},"∑ ","0"]]]]]],["DIV",{"class":"ciba-drawer","role":"dialog","aria-modal":"true","aria-label":"CIBA Panel","aria-hidden":"true","style":"width: min(840px, 96vw);"},["DIV",{"class":"ciba-resize-handle","title":"Drag to resize"}],["DIV",{"class":"ciba-header"},["DIV",{},["H2",{"class":"ciba-title"},"Backchannel Authentication",["SPAN",{"class":"ciba-badge ciba-badge--off"},"Disabled"]],["P",{"class":"ciba-subtitle"},"OIDC CIBA plus OAuth tokens, Backend-for-Frontend (BFF) session, MCP, and RFC 8693 token exchange — open ",["STRONG",{},"Full stack"]," for the map and ",["STRONG",{},"Token exchange"]," for before/after ",["CODE",{},"/token"],", statuses, and responses."]],["BUTTON",{"class":"ciba-close","aria-label":"Close"},"✕"]],["DIV",{"class":"ciba-tabs"},["BUTTON",{"class":"ciba-tab ciba-tab--active"},"What is CIBA"],["BUTTON",{"class":"ciba-tab"},"Sign-in & roles"],["BUTTON",{"class":"ciba-tab"},"Full stack"],["BUTTON",{"class":"ciba-tab"},"Token exchange"],["BUTTON",{"class":"ciba-tab"},"vs Login Flow"],["BUTTON",{"class":"ciba-tab"},"▶ Try It"],["BUTTON",{"class":"ciba-tab"},"App Flows"],["BUTTON",{"class":"ciba-tab"},"PingOne Setup"],["BUTTON",{"class":"ciba-tab"},"BFF code"]],["DIV",{"class":"ciba-body"},["DIV",{"class":"ciba-tab-content"},["P",{},"CIBA (Client-Initiated Backchannel Authentication, OpenID CIBA Core 1.0) decouples the"," ",["STRONG",{},"consumption device"]," (where the app runs) from where the user"," ",["STRONG",{},"approves"]," — often another device or their email inbox. No browser redirect, no popup. PingOne delivers the approval step by ",["STRONG",{},"email"]," or"," ",["STRONG",{},"push"]," depending on your DaVinci configuration."],["H3",{},"The flow (6 steps)"],["PRE",{"class":"edu-code"},"\n1. App (server) ──POST /bc-authorize──▶ PingOne\n   { login_hint: \"user@bank.com\", scope: \"openid write\",\n     binding_message: \"Approve $500 transfer\" }\n\n2. PingOne ◀─────────────────────────── auth_req_id returned\n\n3. PingOne ──out-of-band approval────▶ User (channel is your PingOne / DaVinci setup)\n   • Email: approval link in inbox  — OR —  • Push: notification on registered device\n\n4. User approves (link in email or tap Approve on device)\n\n5. App polls POST /token (grant=ciba, auth_req_id=...)\n   → authorization_pending (repeat every 5s)\n   → tokens returned ✓\n\n6. Tokens stored server-side (never sent to browser)\n   Tool call / transaction executes with user context\n"],["H3",{},"Real HTTP: bc-authorize request & response"],["PRE",{"class":"edu-code"},"POST {issuer}/as/bc-authorize\nContent-Type: application/x-www-form-urlencoded\nAuthorization: Basic <base64(client_id:client_secret)>\n\nscope=openid%20banking%3Awrite\n&login_hint=user%40bank.com\n&binding_message=Approve%20%24500%20transfer\n&acr_values=Multi_factor            (optional step-up)\n&client_notification_token=...      (required for ping/push delivery mode)\n\nHTTP/1.1 200 OK\n{\n  \"auth_req_id\": \"abc123xyz...\",\n  \"expires_in\": 300,\n  \"interval\": 5\n}"],["H3",{},"Real HTTP: polling for tokens"],["PRE",{"class":"edu-code"},"POST {issuer}/as/token\nContent-Type: application/x-www-form-urlencoded\n\ngrant_type=urn:openid:params:grant-type:ciba\n&auth_req_id=abc123xyz...\n&client_id=...\n&client_secret=...\n\n── If user has not yet approved ──\nHTTP/1.1 400 Bad Request\n{ \"error\": \"authorization_pending\" }\n\n── If poll is too fast ──\nHTTP/1.1 400 Bad Request\n{ \"error\": \"slow_down\" }   → increase interval by 5s\n\n── On approval ──\nHTTP/1.1 200 OK\n{\n  \"access_token\": \"...\",\n  \"token_type\": \"Bearer\",\n  \"id_token\": \"...\",\n  \"refresh_token\": \"...\",\n  \"expires_in\": 3600\n}\n\n── On denial / timeout ──\nHTTP/1.1 400 Bad Request\n{ \"error\": \"access_denied\" | \"expired_token\" }"],["H3",{},"Key concepts"],["UL",{},["LI",{},["STRONG",{},"auth_req_id"]," — a short-lived opaque ID returned by PingOne when"," ",["CODE",{},"POST /bc-authorize"]," succeeds. The server uses it to poll"," ",["CODE",{},"POST /token"]," until the user approves or the request expires."],["LI",{},["STRONG",{},"binding_message"]," — the text shown in the approval email or push notification, e.g. ",["EM",{},"\"Approve $500 transfer to Savings\""],". Helps the user confirm exactly what they are authorising."],["LI",{},["STRONG",{},"login_hint"]," — the user's email address. PingOne resolves this to the target account and sends the approval to the right inbox or device."],["LI",{},["STRONG",{},"Poll vs Ping delivery mode"]," — ",["EM",{},"Poll"],": server calls"," ",["CODE",{},"POST /token"]," every 5 s (or ",["CODE",{},"interval"]," seconds). ",["EM",{},"Ping"],": PingOne calls a ",["CODE",{},"client_notification_endpoint"]," when the user approves (requires a publicly reachable callback URL). This demo uses Poll mode."],["LI",{},["STRONG",{},"Backend-for-Frontend (BFF) pattern — tokens never reach the browser"]," — tokens are stored in the server-side session. The browser only receives approval status updates via the Backend-for-Frontend (BFF) poll API. XSS cannot steal them."],["LI",{},["STRONG",{},"Email vs push"]," — controlled by your PingOne / DaVinci flow, not by this app. Email-only CIBA requires no push-capable MFA device."]],["H3",{},"When to use CIBA (vs Authorization Code)"],["UL",{},["LI",{},"LLM / agent contexts where a browser redirect would break the flow."],["LI",{},"Step-up authentication mid-session (high-value transaction) without a page reload."],["LI",{},"IoT / headless devices that cannot host a redirect URI."],["LI",{},"Delegated approval — approve on phone while viewing dashboard on desktop."]]]]],["DIV",{"class":"cimd-drawer","role":"dialog","aria-modal":"true","aria-label":"CIMD Guide and Simulator","aria-hidden":"true","style":"width: min(740px, 96vw);"},["DIV",{"class":"cimd-resize-handle"}],["DIV",{"class":"cimd-header"},["DIV",{},["H2",{"class":"cimd-title"},"📄 Client ID Metadata Document"],["P",{"class":"cimd-subtitle"},"draft-ietf-oauth-client-id-metadata-document — the client_id is a URL"]],["BUTTON",{"class":"cimd-close","aria-label":"Close CIMD panel"},"✕"]],["DIV",{"class":"cimd-tabs","role":"tablist","aria-label":"CIMD guide sections"},["BUTTON",{"class":"cimd-tab cimd-tab--active","role":"tab","aria-selected":"true"},"What is CIMD"],["BUTTON",{"class":"cimd-tab","role":"tab","aria-selected":"false"},"CIMD vs DCR"],["BUTTON",{"class":"cimd-tab","role":"tab","aria-selected":"false"},"Doc format"],["BUTTON",{"class":"cimd-tab","role":"tab","aria-selected":"false"},"How AS uses it"],["BUTTON",{"class":"cimd-tab","role":"tab","aria-selected":"false"},"Flow diagram"],["BUTTON",{"class":"cimd-tab","role":"tab","aria-selected":"false"},"▶ Simulate"],["BUTTON",{"class":"cimd-tab","role":"tab","aria-selected":"false"},"PingOne"]],["DIV",{"class":"cimd-body","role":"tabpanel"},["P",{},["STRONG",{},"OAuth Client ID Metadata Document (CIMD)"]," is an IETF draft (",["A",{"href":"https://datatracker.ietf.org/doc/draft-ietf-oauth-client-id-metadata-document/","target":"_blank","rel":"noopener noreferrer"},"draft-ietf-oauth-client-id-metadata-document"],") that redefines what a ",["CODE",{},"client_id"]," is. Instead of an opaque string like ",["CODE",{},"abc123"],", the ",["CODE",{},"client_id"]," becomes a ",["STRONG",{},"URL"],". When the authorization server receives that URL, it fetches the document at that URL to discover the client's metadata (redirect URIs, grant types, scopes, etc.)."],["DIV",{"class":"cimd-callout"},["STRONG",{},"Core idea:"]," The ",["CODE",{},"client_id"]," IS the metadata document URL. The client controls the URL, so the client controls its own registration data."],["UL",{},["LI",{},["CODE",{},"client_id"]," is a URL, e.g."," ",["CODE",{},"https://app.example.com/.well-known/oauth-client/my-app"]],["LI",{},"The AS fetches that URL and reads the metadata (",["CODE",{},"redirect_uris"],", ",["CODE",{},"grant_types"],", etc.)"],["LI",{},"The client self-describes by controlling the hosted document"],["LI",{},"Eliminates out-of-band registration in AS implementations that support the draft"],["LI",{},"Updates are instant: just update the hosted JSON file"]],["H3",{},"What this demo does"],["P",{},"This demo bridges the gap between the draft and PingOne. You fill in a CIMD-style form, the backend creates the OAuth application in PingOne via the Management API, then hosts the CIMD document at:"],["PRE",{"class":"cimd-code"},["CODE",{},"GET /.well-known/oauth-client/{pingone-app-id}"]],["P",{},"Use the ",["STRONG",{},"▶ Simulate"]," tab to watch the full AS-fetches-CIMD flow animated step by step."],["H3",{},"Key references"],["UL",{},["LI",{},["A",{"href":"https://datatracker.ietf.org/doc/draft-ietf-oauth-client-id-metadata-document/","target":"_blank","rel":"noopener noreferrer"},"draft-ietf-oauth-client-id-metadata-document (IETF)"]],["LI",{},["A",{"href":"https://www.rfc-editor.org/rfc/rfc7591","target":"_blank","rel":"noopener noreferrer"},"RFC 7591 — OAuth 2.0 Dynamic Client Registration"]," ","(compare & contrast)"]]]],["FOOTER",{"class":"footer"},["DIV",{"class":"footer-content"},["IMG",{"__playwright_current_src__":"https://api.ping.demo:4000/super-bank-icon.png","alt":"","class":"footer-logo","src":"/super-bank-icon.png","style":"height: 32px; width: 32px; object-fit: contain; margin-right: 8px; vertical-align: middle;"}],["SPAN",{"class":"footer-brand-text","style":"font-weight: bold; font-size: 18px; vertical-align: middle;"},"AI Demo"," Demo"],["SPAN",{"class":"footer-copyright","style":"margin-left: 16px; font-size: 14px;"},"© ","2026"," All rights reserved."]]]]],[[3,373]],[[3,374]],[[3,375]],[[3,376]],[[3,377]],[[3,378]],[[3,379]],[[3,380]],[[3,381]],[[3,382]]]],"viewport":{"width":1280,"height":720},"timestamp":3742926.721,"wallTime":1783081354423,"collectionTime":1.2000000029802322,"resourceOverrides":[],"isMainFrame":true}}
