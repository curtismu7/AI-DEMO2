# Shared PingOne environment for this project.
PINGONE_ENVIRONMENT_ID=01d89b06-66d5-430e-9f28-65636843788b

ANTHROPIC_API_KEY=your_key_here
# Route through the PingOne Agent Privilege: set the base URL to <gateway>/llm/anthropic
# and ANTHROPIC_API_KEY to the `anthropic` virtual key (it allows Haiku only, so the
# model defaults to claude-haiku-4-5 on that path). Override with COMPLIANCE_MODEL.
# ANTHROPIC_BASE_URL=https://mcpgw.ai-demo.ping-devops.com/llm/anthropic
# COMPLIANCE_MODEL=
COMPLIANCE_PORT=3007
COMPLIANCE_HOST=0.0.0.0
