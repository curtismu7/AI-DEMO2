      "grantedScopes": ["read"]
    },
    "Super Banking Membership Specialist Agent": {
      "type": "WEB_APP",
      "grantTypes": ["client_credentials", "token_exchange"],
      "grantedScopes": ["read"]
    },
    "Super Banking Payroll Specialist Agent": {
      "type": "WEB_APP",
      "grantTypes": ["client_credentials", "token_exchange"],
      "grantedScopes": ["read"]
    },
    "Super Banking Agent": {
      "type": "WORKER",
      "grantTypes": ["client_credentials"],
      "grantedScopes": []
    },
    "Super Banking Worker": {
      "type": "WORKER",
      "grantTypes": ["client_credentials"],
      "grantedScopes": []
    }
  },
  "servers": {
    "demo_api_server": { "resource": "Super Banking API", "validatesAudience": "enduser.ping.demo", "gatesOnToolScopes": false, "description": "BFF / token custodian. Performs RFC 8693 two-exchange delegation (user token -> mcpgateway.ping.demo)." },
    "demo_mcp_gateway": { "resource": "Super Banking MCP Gateway", "validatesAudience": "mcpgateway.ping.demo", "gatesOnToolScopes": true, "description": "MCP Gateway. Validates inbound aud === mcpgateway.ping.demo and enforces per-tool requiredScopes (getScopesForGatewayTool) on the inbound bearer BEFORE credential swap. Therefore every gateway-surface tool scope MUST be mirrored onto the Super Banking MCP Gateway resource (ARCHITECTURE-TRUTHS T-10)." },
    "demo_mcp_server": { "resource": "Super Banking MCP Server", "validatesAudience": "mcpgateway.ping.demo", "gatesOnToolScopes": true, "description": "Backend MCP tool server. Gateway forwards the inbound bearer UNCHANGED (no re-exchange — see authorizeMcpRequest.ts Step 4 + GatewayTokenPolicy D-05), so the server validates aud === mcpgateway.ping.demo (MCP_SERVER_RESOURCE_URI), the same gateway-targeted audience. PingOne token exchange cannot issue a separate server aud alongside the gateway aud (returns invalid_scope: May not request scopes for multiple resources)." },
    "demo_agent_service": { "resource": "Super Banking Agent Gateway", "validatesAudience": "agentgateway.ping.demo", "gatesOnToolScopes": false, "description": "Agent Gateway (Two-Exchange Step 1 audience for the AI Agent client-credentials token)." }
  },
