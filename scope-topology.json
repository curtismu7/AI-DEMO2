{
  "$schema": "./scope-topology.schema.json",
  "version": 3,
  "deployment": {
    "_comment": "Public app URLs per deployment environment. Master SoT for PINGONE_PUBLIC_APP_URL and PINGONE_RESOURCE_PINGGATEWAY_URI. Used to derive redirect URIs in configStore at startup. .env must still provide PingOne secrets (ClientID, ClientSecret) — this section is non-sensitive config only.",
    "environments": {
      "local": { "publicAppUrl": "https://demo-api-server:3001", "pingGatewayResourceUri": "https://api.ping.demo:3036/mcp" },
      "k8s": { "publicAppUrl": "https://ai-demo.ping-devops.com", "pingGatewayResourceUri": "https://ai-demo.ping-devops.com/mcp" }
    },
    "redirectUris": { "_comment": "Derived from publicAppUrl by configStore at startup. Uncomment and set manually only to override auto-derivation.", "adminCallback": "/api/auth/oauth/callback", "userCallback": "/api/auth/oauth/user/callback" }
  },
  "provisioning": {
    "appPrefix": "Demo AI App",
    "resourceNames": { "Super Banking API": "Demo API", "Super Banking MCP Server": "Demo MCP Server", "Super Banking MCP Invest": "Demo MCP Invest", "Super Banking MCP Gateway": "Demo MCP Gateway", "Super Banking Agent Gateway": "Demo Agent Gateway", "Super Banking A2A Intermediate": "Demo A2A Intermediate" },
    "appNames": { "Super Banking User App": "Demo AI App - User Login", "Super Banking Admin App": "Demo AI App - Admin Login", "Super Banking MCP Server": "Demo AI App - MCP Server Client", "Super Banking MCP Gateway": "Demo AI App - MCP Gateway", "Super Banking MCP Exchanger": "Demo AI App - Token Exchanger", "Super Banking AI Agent": "Demo AI App - AI Agent Actor", "Super Banking Agent": "Demo AI App - Agent Actor", "Super Banking Worker": "Demo AI App - Introspection Worker", "Super Banking Investment Advisor Agent": "Demo AI App - Investment Advisor Agent", "Super Banking Records Specialist Agent": "Demo AI App - Records Specialist Agent", "Super Banking Purchase Specialist Agent": "Demo AI App - Purchase Specialist Agent", "Super Banking Membership Specialist Agent": "Demo AI App - Membership Specialist Agent", "Super Banking Payroll Specialist Agent": "Demo AI App - Payroll Specialist Agent" }
  },
  "aliases": { "banking:mcp:invoke": "mcp:invoke", "gateway:mcp:invoke": "mcp:invoke", "ai:agent": "ai:agent:read" },
  "scopes": {
    "read": { "description": "Read accounts, balances, transactions", "riskLevel": "low", "resource": "Super Banking API", "category": "data" },
    "write": { "description": "Write operations (deposit/withdrawal/transfer)", "riskLevel": "high", "resource": "Super Banking API", "category": "data" },
    "transfer": { "description": "Execute fund transfers", "riskLevel": "high", "resource": "Super Banking API", "category": "data" },
    "accounts:read": { "description": "Read account information and balances", "riskLevel": "low", "resource": "Super Banking API", "category": "data" },
    "transactions:read": { "description": "Read transaction history and details", "riskLevel": "low", "resource": "Super Banking API", "category": "data" },
    "mortgage:read": { "description": "Read mortgage/feature-specific data (banking vertical)", "riskLevel": "low", "resource": "Super Banking API", "category": "feature" },
    "largepurchase:read": { "description": "Read large purchase data (retail vertical)", "riskLevel": "low", "resource": "Super Banking API", "category": "feature" },
    "records:read": { "description": "Read health record data (healthcare vertical)", "riskLevel": "low", "resource": "Super Banking API", "category": "feature" },
    "gear:read": { "description": "Read gear order data (sporting-goods vertical)", "riskLevel": "low", "resource": "Super Banking API", "category": "feature" },
    "expense:read": { "description": "Read expense report data (workforce vertical)", "riskLevel": "low", "resource": "Super Banking API", "category": "feature" },
    "permits:read": { "description": "Read permit status data (government vertical)", "riskLevel": "low", "resource": "Super Banking API", "category": "feature" },
    "transcript:read": { "description": "Read enrollment/transcript status data (university vertical)", "riskLevel": "low", "resource": "Super Banking API", "category": "feature" },
    "invest:read": { "description": "Read investment accounts, balances, and portfolio summaries (A2A specialist scope)", "riskLevel": "low", "resource": "Super Banking API", "category": "feature" },
    "ai:agent:read": { "description": "Agent invocation permission", "riskLevel": "medium", "resource": "Super Banking API", "category": "agent" },
    "mcp:invoke": { "description": "Invoke MCP tools via the gateway (RFC 8693 exchange)", "riskLevel": "medium", "resource": "Super Banking MCP Server", "category": "infra" },
    "code:search": { "description": "Search and read the indexed source code (read-only)", "riskLevel": "low", "resource": "Super Banking MCP Server", "category": "infra" },
    "agent:invoke": { "description": "Invoke the Agent Gateway (Two-Exchange Step 1 audience)", "riskLevel": "medium", "resource": "Super Banking Agent Gateway", "category": "infra" },
    "ai_agent": { "description": "AI agent identity", "riskLevel": "medium", "resource": "Super Banking API", "category": "ai" },
    "admin:read": { "description": "Read access to administrative data", "riskLevel": "medium", "resource": "Super Banking API", "category": "admin" },
    "admin:write": { "description": "Write access to administrative operations", "riskLevel": "high", "resource": "Super Banking API", "category": "admin" },
    "admin:delete": { "description": "Delete operations for administrative tasks", "riskLevel": "critical", "resource": "Super Banking API", "category": "admin" },
    "users:read": { "description": "Read access to user management data", "riskLevel": "medium", "resource": "Super Banking API", "category": "admin" },
    "users:manage": { "description": "Full user management capabilities", "riskLevel": "high", "resource": "Super Banking API", "category": "admin" },
    "workorders:read": { "description": "Read Work Order Status data (manufacturing vertical)", "riskLevel": "low", "resource": "Super Banking API", "category": "feature" },
    "sensitive:read": { "description": "Read sensitive account details (full account/routing numbers) — requires user consent", "riskLevel": "high", "resource": "Super Banking API", "category": "data" }
  },
  "resources": {
    "Super Banking API": {
      "uri": "enduser.ping.demo",
      "scopes": ["read", "write", "transfer", "accounts:read", "transactions:read", "mortgage:read", "largepurchase:read", "records:read", "gear:read", "expense:read", "permits:read", "transcript:read", "invest:read", "ai:agent:read", "ai_agent", "admin:read", "admin:write", "admin:delete", "users:read", "users:manage", "workorders:read", "sensitive:read"]
    },
    "Super Banking MCP Server": {
      "uri": "mcpserver.ping.demo",
      "scopes": ["mcp:invoke", "code:search"],
      "mirroredScopes": ["read", "write", "transfer", "mortgage:read", "largepurchase:read", "records:read", "gear:read", "expense:read", "permits:read", "transcript:read", "invest:read", "ai:agent:read", "admin:read", "admin:write", "admin:delete", "users:read", "users:manage", "workorders:read", "sensitive:read"]
    },
    "Super Banking MCP Invest": {
      "uri": "mcp-invest.ping.demo",
      "scopes": ["mcp:invoke"],
      "mirroredScopes": ["invest:read", "read"]
    },
    "Super Banking MCP Gateway": {
      "uri": "mcpgateway.ping.demo",
      "scopes": ["mcp:invoke"],
      "mirroredScopes": ["read", "write", "transfer", "mortgage:read", "largepurchase:read", "records:read", "gear:read", "expense:read", "permits:read", "transcript:read", "invest:read", "workorders:read", "sensitive:read", "code:search"]
    },
    "Super Banking Agent Gateway": {
      "uri": "agentgateway.ping.demo",
      "scopes": ["agent:invoke"],
      "mirroredScopes": ["read", "write", "transfer", "mortgage:read", "largepurchase:read", "records:read", "gear:read", "expense:read", "permits:read", "transcript:read", "invest:read", "workorders:read", "sensitive:read", "code:search"]
    },
    "Super Banking A2A Intermediate": {
      "uri": "a2a-intermediate.ping.demo",
      "scopes": ["agent:invoke"]
    }
  },
  "apps": {
    "Super Banking User App": {
      "type": "WEB_APP",
      "grantTypes": ["authorization_code", "refresh_token", "token_exchange"],
      "grantedScopes": ["ai:agent:read", "read", "write", "transfer", "mortgage:read", "largepurchase:read", "records:read", "gear:read", "expense:read", "permits:read", "transcript:read", "workorders:read", "invest:read"]
    },
    "Super Banking Admin App": {
      "type": "WEB_APP",
      "grantTypes": ["authorization_code", "refresh_token", "token_exchange"],
      "grantedScopes": ["read", "write", "transfer", "accounts:read", "transactions:read", "mortgage:read", "ai:agent:read", "ai_agent", "admin:read", "admin:write", "admin:delete", "users:read", "users:manage"]
    },
    "Super Banking MCP Server": {
      "type": "WEB_APP",
      "grantTypes": ["client_credentials"],
      "isResourceServer": "Super Banking MCP Server",
      "grantedScopes": []
    },
    "Super Banking MCP Gateway": {
      "type": "WEB_APP",
      "grantTypes": ["client_credentials", "token_exchange"],
      "isResourceServer": "Super Banking MCP Gateway",
      "grantedScopes": []
    },
    "Super Banking MCP Exchanger": {
      "type": "WEB_APP",
      "grantTypes": ["token_exchange"],
      "grantedScopes": ["read", "write", "mcp:invoke"]
    },
    "Super Banking AI Agent": {
      "type": "WEB_APP",
      "grantTypes": ["client_credentials", "token_exchange"],
      "grantedScopes": ["agent:invoke"]
    },
    "Super Banking Investment Advisor Agent": {
      "type": "WEB_APP",
      "grantTypes": ["client_credentials", "token_exchange"],
      "grantedScopes": ["invest:read"]
    },
    "Super Banking Records Specialist Agent": {
      "type": "WEB_APP",
