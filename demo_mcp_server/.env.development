NODE_ENV=development
LOG_LEVEL=INFO

HTTP_MCP_TRANSPORT_ENABLED=true
MCP_RESOURCE_URL=http://localhost:8080
MCP_ALLOWED_ORIGINS=
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8080
MCP_SERVER_MAX_CONNECTIONS=100
MCP_SERVER_SESSION_TIMEOUT=3600

PINGONE_BASE_URL=https://auth.pingone.com/dev-placeholder-env-id/as
PINGONE_CLIENT_ID=00000000-0000-0000-0000-000000000001
PINGONE_CLIENT_SECRET=dev-placeholder-client-secret-32chars
PINGONE_INTROSPECTION_ENDPOINT=https://auth.pingone.com/dev-placeholder-env-id/as/introspect
PINGONE_AUTHORIZATION_ENDPOINT=https://auth.pingone.com/dev-placeholder-env-id/as/authorize
PINGONE_TOKEN_ENDPOINT=https://auth.pingone.com/dev-placeholder-env-id/as/token
PINGONE_JWKS_URI=https://auth.pingone.com/dev-placeholder-env-id/as/jwks

BANKING_API_BASE_URL=https://api.ping.demo:3001
BANKING_API_TIMEOUT=30000
BANKING_API_MAX_RETRIES=3
BANKING_API_CIRCUIT_BREAKER_THRESHOLD=5
TOOL_CALL_TIMEOUT_MS=30000

ENCRYPTION_KEY=dev-placeholder-encryption-key-use-only-for-local-dev-not-prod

TOKEN_STORAGE_PATH=./data/tokens
SESSION_STORAGE_PATH=./data/sessions
TOKEN_CACHE_TTL_SECONDS=3600
SESSION_CLEANUP_INTERVAL_SECONDS=300

AUDIT_LOG_PATH=./logs/audit.log
SECURITY_LOG_PATH=./logs/security.log
ENABLE_DETAILED_LOGGING=false
HEALTH_CHECK_INTERVAL_SECONDS=30

CIBA_ENABLED=false
REQUIRE_DPOP_PROOF=false
GW_MCP_BRIDGE_SECRET=
ENABLE_METRICS=true
METRICS_PORT=9090
