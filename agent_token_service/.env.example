# ── agent_token_service ──────────────────────────────────────────────────────
# Standalone PingOne agent-token broker. Mints a client-credentials token for a
# dedicated PingOne AI_AGENT app and returns it to API-key-authenticated callers
# (e.g. a Microsoft Copilot Studio REST/MCP tool). Copy to `.env` and fill in.
# NEVER commit a filled-in .env — secrets only live in .env / vault.

# --- Service ---
# Listen port. 8097 by default (clear of the demo's 30xx/8888-8895 service ports).
PORT=8097
# Bind address. Defaults to loopback for safety. Set HOST=0.0.0.0 only when the
# service is deployed behind TLS / a tunnel so Copilot Studio (cloud) can reach
# it; the static API key below is the only thing protecting /token.
HOST=127.0.0.1

# --- Caller authentication (broker front door) ---
# Static key every caller must send in the `x-api-key` header. Generate a long
# random value, e.g. `openssl rand -hex 32`.
BROKER_API_KEY=

# --- PingOne token endpoint ---
# Either set PINGONE_TOKEN_ENDPOINT explicitly, OR set ENVIRONMENT_ID + REGION
# and the broker derives https://auth.pingone.<region>/<envId>/as/token.
PINGONE_TOKEN_ENDPOINT=
PINGONE_ENVIRONMENT_ID=01d89b06-66d5-430e-9f28-65636843788b
PINGONE_REGION=com

# --- Copilot's dedicated PingOne agent app (WEB_APP + client-credentials) ---
# Provisioned app: "Demo AI App - Copilot Studio Agent"
# client_id = 7d028710-c411-4a6c-be12-067141b36d5a (env d02d2305-...)
# Copy the real client secret from the PingOne console (Applications →
# Demo AI App - Copilot Studio Agent → Configuration → Client Secret).
PINGONE_AGENT_CLIENT_ID=7d028710-c411-4a6c-be12-067141b36d5a
PINGONE_AGENT_CLIENT_SECRET=

# Token-endpoint auth method. This environment's agent/MCP apps use 'post'
# (credentials in the body). 'basic' sends the Authorization header instead.
PINGONE_AGENT_TOKEN_AUTH_METHOD=post

# Requested scope. The app is granted `agent:invoke` on the Agent Gateway
# resource, so the issued token has aud=agentgateway.ping.demo. (This env reaches
# mcpgateway.ping.demo only via RFC 8693 exchange, not a direct CC grant.)
PINGONE_AGENT_SCOPE=agent:invoke

# Optional explicit `audience`/`resource` param if your PingOne env requires it
# to stamp the token aud (this env derives aud from the requested scope's resource).
PINGONE_AGENT_AUDIENCE=

# --- Optional: private_key_jwt instead of client_secret ---
USE_PKI_AGENT_CREDS=false
AGENT_CERT_PATH=

# --- Identity sidecar mode (POST /v1/token; compose profile agent-identity-sidecar) ---
# One sidecar per agent identity. To front the BFF's AI Agent actor token, point the
# PINGONE_AGENT_* vars above at the AI Agent app ("Demo AI App - AI Agent Actor",
# PINGONE_AI_AGENT_ACTOR_CLIENT_ID / _SECRET) and set PINGONE_AGENT_TOKEN_AUTH_METHOD=post:
# that app is CLIENT_SECRET_POST, so `basic` is rejected with invalid_client. Declare the
# targets callers may ask for; a caller sends only the target name, and scope/audience/
# resource live here. PingOne stamps `resource` into the token's aud, so use the bare
# audience (no https://). Example (what the BFF asks for):
#   TARGETS_JSON={"agent-gateway":{"scope":"agent:invoke","resource":"agentgateway.ping.demo"}}
# The BFF's own key for this sidecar goes in demo_api_server/.env as
# AGENT_IDENTITY_SIDECAR_API_KEY (the same value as BROKER_API_KEY above).
TARGETS_JSON=
# Default resource indicator when a caller names no target (optional).
PINGONE_AGENT_RESOURCE=
