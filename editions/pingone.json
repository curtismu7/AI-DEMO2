  "keepIgnore": [
    {
      "regex": "^(docs|planning)/",
      "reason": "PF-named docs, specs and plans are prose; they ship in both editions and cannot break a build"
    },
    {
      "regex": "^(\\.claude|\\.superpowers|se-skills-export)/",
      "reason": "agent skills, SDD reports and shared Ping skill packages are documentation, not runtime code"
    },
    {
      "regex": "^PF-[^/]*\\.md$",
      "reason": "root PF session notes (docs only)"
    },
    {
      "regex": "^editions/",
      "reason": "the edition manifests themselves (editions/pingfederate.json)"
    }
  ],
  "dropUseCases": ["UC40"]
