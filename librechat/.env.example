# librechat/.env.example
# Copy to librechat/.env and fill in real values. librechat/.env is
# gitignored by this repo's root .gitignore (**/.env) — never commit it.

# --- Server ---
HOST=0.0.0.0
PORT=3080
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

# --- Footer link to the repo's MCP Inspector ---
# Manual "pop out and watch" link, not a live/automatic connection between
# LibreChat and the Inspector - the two apps don't talk to each other. Deep-
# links straight to the built-in Privilege MCP profile (see the AI-DEMO2 repo's
# demo_api_server/routes/mcpPrivilegeAuth.js / mcpInspector.js). Requires an
# admin session on local.ping-devops.com:4000 - that's the only origin where
# this demo's session cookies actually work (see that repo's root CLAUDE.md).
CUSTOM_FOOTER=[LibreChat](https://librechat.ai) | [Open MCP Inspector (Privilege)](https://local.ping-devops.com:4000/pingone-mcp-inspector?source=custom&profile=built-in-privilege-mcp)

# --- Local account registration ---
# LibreChat's own account system (backed by mongodb, unrelated to PingOne)
# defaults registration to disallowed. This stack needs at least one local
# account to reach the chat UI and drive the Privilege MCP OAuth flow.
ALLOW_REGISTRATION=true

# --- MongoDB ---
# Docker network service name, NOT 127.0.0.1 — the api and mongodb
# containers share librechat/docker-compose.yml's default network.
MONGO_URI=mongodb://mongodb:27017/LibreChat

# --- Session/credential secrets ---
# LibreChat will auto-generate temporary values into .env.temp if these are
# left blank, but that regenerates (and invalidates existing sessions/stored
# credentials) on every container recreate. Generate persistent values once:
#   openssl rand -hex 32   (JWT_SECRET, JWT_REFRESH_SECRET)
#   openssl rand -hex 16   (CREDS_IV)
#   openssl rand -hex 32   (CREDS_KEY)
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=

# --- Search (left off — meilisearch is not part of this stack; see
# docs/superpowers/plans/2026-08-24-librechat-privilege-mcp-client.md) ---
SEARCH=false

# --- Privilege MCP OAuth fallback (see
# docs/superpowers/plans/2026-08-24-librechat-privilege-mcp-client.md) ---
# Only needed if LibreChat's zero-config DCR flow against
# https://cmuir-agentless-mcpgw.ping-devops.com/external/mcp fails and a
# manually-registered PingOne OIDC client becomes necessary. Leave blank for
# the first attempt — librechat.yaml's mcpServers.privilege entry has no
# oauth: block by default, so these are unused unless that block is added.
# PRIVILEGE_MCP_CLIENT_ID=
# PRIVILEGE_MCP_CLIENT_SECRET=

# --- PingOne login for LibreChat's own account system (optional, alongside
# local email/password — NOT the same thing as the Privilege MCP OAuth
# above, which authenticates a *tool*, not the app itself) ---
# PingOne app "LibreChat Local Login - exploratory" (env 01d89b06), OIDC Web
# App, Authorization Code, PKCE S256 required. Get OPENID_CLIENT_SECRET from
# the PingOne console (Applications > this app > Configuration) — never hand
# this value through anything that logs it.
#
# Token endpoint auth method MUST be client_secret_post on the PingOne app
# side, not client_secret_basic. LibreChat's openidStrategy.js only sets
# token_endpoint_auth_method explicitly when OPENID_GENERATE_NONCE is on
# (unset here); otherwise it's left to the openid-client library's default,
# which resolves to client_secret_post — mismatched against a
# client_secret_basic-only PingOne app, this fails token exchange with a
# generic "server responded with an error in the response body" and no
# further detail in LibreChat's own logs. Same class of gotcha as this
# repo's other client_secret_basic-vs-post mismatches (see PingOne MCP
# skill notes) — verify empirically, don't assume basic is the default.
OPENID_ISSUER=https://auth.pingone.com/01d89b06-66d5-430e-9f28-65636843788b/as
OPENID_CLIENT_ID=b5c361b9-f76c-4320-ba2b-4125f9ee5b48
OPENID_CLIENT_SECRET=
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_SCOPE=openid profile email
# A freshly created PingOne oidc_web_app only maps `sub` by default — request
# the email/profile scopes here AND add an explicit `email` attribute mapping
# on the PingOne app (PingOne console > Applications > this app > Attribute
# Mappings, or the createAttributeMapping API), or LibreChat's user creation
# fails with "User validation failed: email: can't be blank" even though the
# PingOne user genuinely has an email on file.
OPENID_USE_PKCE=true
OPENID_BUTTON_LABEL=Continue with PingOne
# Keep false — this is "PingOne alongside local login," not a replacement.
# true would skip straight to PingOne and hide the local email/password form.
OPENID_AUTO_REDIRECT=false
# Required for LibreChat to even report openidLoginEnabled: true (see
# api/server/routes/config.js's isOpenIdEnabled check) — generate once:
#   openssl rand -hex 32
OPENID_SESSION_SECRET=
# Also required — the whole social-login block (including OpenID) only
# renders client-side when this top-level flag is on, separately from
# openidLoginEnabled itself (SocialLoginRender.tsx).
ALLOW_SOCIAL_LOGIN=true
