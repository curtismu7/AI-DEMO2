# Shared PingOne environment for this project.
PINGONE_ENVIRONMENT_ID=01d89b06-66d5-430e-9f28-65636843788b

# Pydantic AI agent service
AGENT_HTTP_HOST=127.0.0.1
# AGENT_HTTP_PORT: configure this setting for pydantic_agent/.env.example; see the service documentation.
AGENT_HTTP_PORT=8893

# OPENAI_API_KEY: configure this setting for pydantic_agent/.env.example; see the service documentation.
OPENAI_API_KEY=<your-openai-api-key>
# OPENAI_MODEL: configure this setting for pydantic_agent/.env.example; see the service documentation.
OPENAI_MODEL=openai:gpt-4o

# BFF_INTERNAL_SECRET: configure this setting for pydantic_agent/.env.example; see the service documentation.
BFF_INTERNAL_SECRET=dev-shared-secret-change-me
# BFF_INTERNAL_TOOL_URL: configure this setting for pydantic_agent/.env.example; see the service documentation.
BFF_INTERNAL_TOOL_URL=http://127.0.0.1:3001/internal/agent-tool
