{
  "mode": "PRODUCTION",
  "streamingEnabled": true,
  "connectors": [
    { "port": 8080, "host": "0.0.0.0" },
    { "port": 8443, "host": "0.0.0.0", "tls": "PgServerTlsOptions" }
  ],
  "heap": [
    {
      "name": "PgTlsPasswords",
      "type": "SystemAndEnvSecretStore",
      "config": {
        "format": "PLAIN"
      }
    },
    {
      "name": "PgServerTlsOptions",
      "type": "ServerTlsOptions",
      "config": {
        "keyManager": {
          "type": "SecretsKeyManager",
          "config": {
            "signingSecretId": "pg.tls.key",
            "secretsProvider": {
              "type": "KeyStoreSecretStore",
              "config": {
                "file": "/certs/pg-tls/pg-server.p12",
                "storeType": "PKCS12",
                "storePasswordSecretId": "pg.tls.keystore.password",
                "secretsProvider": "PgTlsPasswords",
                "mappings": [
                  { "secretId": "pg.tls.key", "aliases": ["api.ping.demo"] }
                ]
              }
            }
          }
        },
        "sslEnabledProtocols": ["TLSv1.3", "TLSv1.2"],
        "clientAuth": "NONE"
      }
    }
  ]
}
