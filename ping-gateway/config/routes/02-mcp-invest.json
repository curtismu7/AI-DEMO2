{
  "name": "mcp-invest-secondary",
  "condition": "${find(request.uri.path, '^/mcp/invest')}",
  "handler": {
    "type": "Chain",
    "config": {
      "filters": [
        {
          "name": "McpAudit",
          "type": "McpAuditFilter",
          "config": {
            "auditService": "AuditService"
          }
        },
        {
          "name": "StripInvestPrefix",
          "type": "UriPathRewriteFilter",
          "config": {
            "mappings": {
              "/mcp/invest": "/mcp"
            }
          }
        },
        {
          "name": "McpGatewayProtection",
          "type": "McpProtectionFilter",
          "config": {
            "resourceId": "${env['PG_GATEWAY_RESOURCE_ID']}",
            "authorizationServerUri": "${env['PINGONE_ISSUER_URI']}",
            "resourceServerFilter": "rsFilter"
          }
        },
        {
          "name": "McpProtocol",
          "type": "McpValidationFilter",
          "config": {
            "acceptedOrigins": ".*",
            "metricsEnabled": true
          }
        },
        {
          "name": "McpRequestValidation",
          "type": "ScriptableFilter",
          "config": {
            "type": "application/x-groovy",
            "file": "mcp-request-validation.groovy"
          }
        },
        {
          "name": "Uc18RateLimit",
          "type": "ScriptableFilter",
          "config": {
            "type": "application/x-groovy",
            "file": "uc18-rate-limit.groovy"
          }
        },
        {
          "name": "P1AZDecision",
          "type": "ScriptableFilter",
          "config": {
            "type": "application/x-groovy",
            "file": "p1az-decision.groovy"
          }
        },
        {
          "name": "GatewayToInvestTokenExchange",
          "type": "OAuth2TokenExchangeFilter",
          "config": {
            "endpoint": "${env['PINGONE_TOKEN_ENDPOINT']}",
            "endpointHandler": "TokenExchangeEndpointHandler",
            "failureHandler": "TokenExchangeFailureHandler",
            "subjectToken": "#{request.headers['Authorization'][0].substring(7)}",
            "subjectTokenType": "urn:ietf:params:oauth:token-type:access_token",
            "requestedTokenType": "urn:ietf:params:oauth:token-type:access_token",
            "scopes": [ "${env['PG_INVEST_SCOPE']}" ],
            "audience": "${env['PG_INVEST_RESOURCE_URI']}"
          }
        },
        {
          "type": "HeaderFilter",
          "config": {
            "messageType": "request",
            "remove": [ "Authorization" ],
            "add": {
              "Authorization": [ "Bearer ${contexts.oauth2TokenExchange.issuedToken}" ]
            }
          }
        }
      ],
      "handler": {
        "type": "ReverseProxyHandler",
        "baseURI": "${env['PG_INVEST_BACKEND_URL']}",
        "config": {}
      }
    }
  }
}
