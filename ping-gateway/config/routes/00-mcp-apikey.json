{
  "name": "mcp-apikey-dispatcher",
  "condition": "${find(request.uri.path, '^/mcp/apikey')}",
  "heap": [
    {
      "name": "SecretsStore",
      "type": "SystemAndEnvSecretStore",
      "config": {
        "format": "PLAIN"
      }
    },
    {
      "name": "IntrospectionProviderHandler",
      "type": "Chain",
      "config": {
        "filters": [
          {
            "name": "IntrospectionClientAuth",
            "type": "ScriptableFilter",
            "config": {
              "type": "application/x-groovy",
              "source": "import java.net.URLEncoder\ndef body = request.entity.string ?: ''\ndef cid = System.getenv('INTROSPECT_CLIENT_ID') ?: ''\ndef cs  = System.getenv('INTROSPECT_CLIENT_SECRET') ?: ''\nif (cid) { request.entity.setString(body + '&client_id=' + URLEncoder.encode(cid, 'UTF-8') + '&client_secret=' + URLEncoder.encode(cs, 'UTF-8')) }\nreturn next.handle(context, request)"
            }
          }
        ],
        "handler": {
          "type": "ClientHandler"
        }
      }
    },
    {
      "name": "RsFilterTokenResolver",
      "type": "TokenIntrospectionAccessTokenResolver",
      "config": {
        "endpoint": "${env['PINGONE_INTROSPECTION_ENDPOINT']}",
        "providerHandler": "IntrospectionProviderHandler"
      }
    }
  ],
  "baseURI": "${env['BANKING_API_URL']}",
  "handler": "RsFilterChain",
  "filters": [
    {
      "name": "ApiKeyDispatch",
      "type": "ScriptableFilter",
      "config": {
        "type": "application/x-groovy",
        "file": "scripts/groovy/apikey-dispatch.groovy"
      }
    },
    {
      "name": "P1AZDecisionGate",
      "type": "ScriptableFilter",
      "config": {
        "type": "application/x-groovy",
        "file": "scripts/groovy/p1az-decision-apikey.groovy"
      }
    }
  ]
}
