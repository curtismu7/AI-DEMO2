# --- PingGateway MCP Route Config -------------------------------------------
# Copy to .env and fill in values. All ${env['VAR']} references in route JSON
# read from the process environment via PingGateway property substitution.
# The Groovy decision filter reads its vars via System.getenv (same names).

# --- Inbound token validation -----------------------------------------------
# PingOne introspection endpoint
PINGONE_INTROSPECTION_ENDPOINT=https://auth.pingone.com/d02d2305-f445-406d-82ee-7cdbf6eeabfd/as/introspect

# PingOne issuer URI (authorization server). McpProtectionFilter.authorizationServerUri.
# Form: https://auth.pingone.com/<envId>/as
PINGONE_ISSUER_URI=https://auth.pingone.com/d02d2305-f445-406d-82ee-7cdbf6eeabfd/as

# Client used to introspect inbound mcpgateway.ping.demo tokens.
# Must be the issuing client or a resource server that owns the audience.
# Use the MCP exchanger client (same as the Node gateway).
INTROSPECT_CLIENT_ID=d3f8fead-b81d-46f9-bba5-051e493cea0e
# Secret mapped to "introspect.client.secret" by SystemAndEnvSecretStore (PLAIN format)
INTROSPECT_CLIENT_SECRET=<exchanger-client-secret>

# --- Local JWKS validation (ff_mcp_gateway_jwks / X-Token-Validation: jwks) ---
# Route 00-mcp-olb-jwks.json validates the inbound JWT locally instead of
# introspecting. RS256 tokens verify against this JWKS endpoint (default when
# unset: ${PINGONE_ISSUER_URI}/jwks). Educational tradeoff: local validation
# cannot detect revoked tokens until they expire.
PINGONE_JWKS_URI=https://auth.pingone.com/d02d2305-f445-406d-82ee-7cdbf6eeabfd/as/jwks
# Mock demo_authz_server HS256 tokens (ff_authorize_simulated=true) verify with
# this shared secret — SAME value the authz-server signs with. Unset = HS256
# tokens fail closed (401) on the JWKS route.
AUTHZ_JWT_SECRET=<authz-jwt-secret>
# Optional expected issuer for mock HS256 tokens; unset = iss not checked on the
# HS256 branch (possession of the shared secret is the trust anchor).
AUTHZ_ISSUER_URI=

# --- Inbound gateway resource identity --------------------------------------
# Two DISTINCT identifiers (do not merge):
#
# PG_GATEWAY_RESOURCE_ID is the McpProtectionFilter.resourceId. Per the
# PingGateway docs it must be the HTTPS URL of the public gateway MCP resource,
# and the inbound access token aud must match it.
#   KNOWN VERIFY ITEM (Phase 5): the Node-gateway TX token carries the bare aud
#   "mcpgateway.ping.demo", not this URL. On the live container, confirm whether
#   McpProtectionFilter accepts the bare aud or the inbound token must be issued
#   with this URL as aud for the PingGateway path. Reconcile there, not here.
PG_GATEWAY_RESOURCE_ID=https://api.ping.demo:3036/mcp
#
# PG_GATEWAY_RESOURCE_URI is the bare audience string the Groovy decision filter
# reports as TokenAudience (mirrors the Node PingOneAuthorizeClient gatewayResourceUri).
PG_GATEWAY_RESOURCE_URI=mcpgateway.ping.demo

# Scope required on the inbound token (Exchange #2 leg, McpProtectionFilter).
# gateway:mcp:invoke is the mcp:invoke capability, uniquely named because PingOne
# forbids one exchanger app from holding the same scope name on two resources
# (an AS grant-model constraint, not a PingGateway product requirement).
PG_INBOUND_SCOPE=gateway:mcp:invoke

# --- Token exchange (gateway -> OLB backend) --------------------------------
# Backend audience the issued (exchanged) token must carry. PREREQUISITE: this
# value must exist as a PingOne Resource Server, and TE_CLIENT_ID must be the
# MCP Gateway app (NOT the MCP Exchanger) — only the Gateway app has grants on
# mcpserver.ping.demo. Using the exchanger yields wrong aud / D-05 or invalid_scope.
#
# SINGLE-resource exchange (NOT multi-resource). The MCP server's HTTP transport
# enforces D-05 (HttpMCPTransport.enforceUpstreamContract): a token reaching the
# upstream MUST NOT carry the gateway aud (mcpgateway.ping.demo) and MUST carry
# the upstream aud. A multi-resource token (both auds) would be REJECTED by D-05.
# So PingGateway exchanges to THIS aud only. Reconciliation that keeps BOTH the
# Node gateway (WS, aud=mcpgateway.ping.demo) and PingGateway (HTTP, aud=this)
# working at the same MCP server is ENV on the MCP server (see Phase 5):
#   MCP_GATEWAY_MODE=true
#   MCP_AUDIENCE=mcpgateway.ping.demo            (WS path expected aud)
#   MCP_UPSTREAM_RESOURCE_URI=mcpserver.ping.demo (HTTP path upstream aud)
#   MCP_GW_RESOURCE_URI=mcpgateway.ping.demo      (HTTP path D-05 reject aud)
PG_OLB_RESOURCE_URI=mcpserver.ping.demo
# Mirrored scopes on Super Banking MCP Server only. Must include `write` for
# transfer/deposit/withdraw. Do NOT add `mcp:invoke` — that name also exists on
# mcpgateway.ping.demo and triggers multi-resource invalid_scope / wrong aud.
PG_OLB_SCOPE=read write

# PingOne token endpoint for RFC 8693 exchange
PINGONE_TOKEN_ENDPOINT=https://auth.pingone.com/d02d2305-f445-406d-82ee-7cdbf6eeabfd/as/token

# Client performing Exchange #3 — MCP Gateway app (grants on mcpserver).
TE_CLIENT_ID=<mcp-gateway-client-id>
# Secret mapped to "te.client.secret" by SystemAndEnvSecretStore (PLAIN format)
TE_CLIENT_SECRET=<mcp-gateway-client-secret>

# --- Token exchange (gateway -> Invest backend) -----------------------------
# Same PingOne Resource Server prerequisite as PG_OLB_RESOURCE_URI above.
PG_INVEST_RESOURCE_URI=mcp-invest.ping.demo
# Invest resource scopes only (single-resource). Do not mix mcp:invoke here.
PG_INVEST_SCOPE=invest:read

# --- Backend URLs -----------------------------------------------------------
# Standalone (ping-gateway/docker-compose.yml): use host.docker.internal to reach
# services on the macOS host. In the main compose stack: use service DNS names
# (http://mcp-server:8080, http://mcp-invest:8081). K8s: use cluster service DNS.
PG_OLB_BACKEND_URL=http://host.docker.internal:8080
PG_INVEST_BACKEND_URL=http://host.docker.internal:8081
# demo_mcp_weather bridge (Agent Gateway showcase — third-party weather-mcp, Texas-only).
# In the main compose stack this is overridden to http://mcp-weather:8896 (service DNS).
PG_WEATHER_BACKEND_URL=http://host.docker.internal:8896
# apikey-dispatch.groovy (mortgage + invest api-key routes). Was undocumented here
# even though the main compose stack and refresh-service-envs.js both set it, so the
# only statement of its default was a hardcoded literal in the groovy.
PG_MORTGAGE_BACKEND_URL=http://host.docker.internal:8082

# --- PingOne Authorize (P1AZ) decision backend (live-switchable) -------------
# The Groovy decision filter mirrors the Node gateway's PingOneAuthorizeClient:
# it POSTs the 25-key parameters payload to
#   <BASE>/governance/pap/alpha/policy/<P1AZ_WORKER_ID>/decision
# and selects <BASE> PER REQUEST from the X-Authz-Simulated header set by the BFF
# (value = effective ff_authorize_simulated): true => P1AZ_MOCK_BASE, false =>
# P1AZ_REAL_BASE. Absent header => mock (default). See Phase 4.

# Mock backend = demo_authz_server (drop-in PingOne Authorize replacement).
# In the main compose stack this is the service DNS name.
P1AZ_MOCK_BASE=http://authz-server:9001

# Real PingOne Authorize base (Decision Endpoints / PAP API host).
P1AZ_REAL_BASE=https://api.pingone.com/v1/environments/d02d2305-f445-406d-82ee-7cdbf6eeabfd

# Worker/policy id used in the decision path segment.
P1AZ_WORKER_ID=<authorize-worker-or-policy-id>

# Worker app client credentials. The Groovy filter acquires + refreshes a bearer
# via client_credentials ONLY when targeting the REAL backend (mock needs none).
# The worker app must have the PingOne Authorize role.
P1AZ_WORKER_CLIENT_ID=<worker-client-id>
P1AZ_WORKER_CLIENT_SECRET=<worker-client-secret>

# --- UC18 rate limiting (uc18-rate-limit.groovy) -----------------------------
# Runs before p1az-decision.groovy on all MCP routes. Throttled tools/call requests
# return 429 and never reach PingOne Authorize (protects P1AZ API quota).
# Default OFF — demos arm via BFF X-UC18-Rate-Limit header (ff_mcp_rate_limit).
# Set PG_RATE_LIMIT_ENABLED=true to always arm without the header.
# Limits match the Node gateway (20 per 60s) — the same token must not be throttled
# differently depending on which gateway is active.
PG_RATE_LIMIT_ENABLED=false
PG_RATE_LIMIT_MAX_REQUESTS=20
PG_RATE_LIMIT_WINDOW_MS=60000

# --- PingOne Authorize API Access Management (04-aam-api-access.json) --------
# A SECOND, coarse-grained Authorize capability, independent of the P1AZ decision
# endpoint above. The stock PingAuthorizeFilter posts method/path/headers to the
# PingOne Authorize Sideband API, which matches an API Service's operations and
# returns allow/deny. It does NOT see MCP tool names or arguments — the /mcp
# routes keep using p1az-decision.groovy for that.
#
# Both vars must be set together, and both come from the PingOne console:
#   PG_AAM_SERVICE_URL   Authorization > API Gateways > <gateway> > Service URL
#   AAM_GATEWAY_SECRET   Authorization > API Gateways > <gateway> > Credentials
#
# AAM_GATEWAY_SECRET is read through the global SecretsStore, a
# SystemAndEnvSecretStore with format PLAIN (config.json), so paste the credential
# VERBATIM. The Ping doc's base64-encode step applies to the default base64 format
# and would be decoded into garbage here.
#
# Leave PG_AAM_SERVICE_URL empty to keep the route inert: its condition fails, no
# route matches /aam, and the gateway returns 404 rather than erroring per request.
PG_AAM_SERVICE_URL=
AAM_GATEWAY_SECRET=

# --- Binding-evidence verification (p1az-decision.groovy) --------------------
# Intent Token: the BFF mints an HMAC-SHA256 token per prompt and sends it as
# X-Intent-Token. This MUST be the same secret the BFF signs with or the gateway
# cannot verify the signature. When unset, the gateway does NOT verify the intent
# binding and OMITS IntentTokenValid / IntentMatchesTool from the decision
# (omission means "unknown"; sending false would mean "verified absent").
#
# REQUIRED, not optional-in-practice: until this is populated the verifier at
# p1az-decision.groovy short-circuits and the whole HMAC/exp/permitted_tools branch
# is dead code on the running stack. refresh-service-envs.js writes it here.
#
# It must be the BFF's EFFECTIVE key, not literally its INTENT_TOKEN_SECRET:
# intentTokenService.js:8 signs with `INTENT_TOKEN_SECRET || SESSION_SECRET`, so on a
# deployment that sets only SESSION_SECRET the generator must write SESSION_SECRET's
# value here. Writing an empty/placeholder INTENT_TOKEN_SECRET instead is worse than
# writing nothing: the verifier then runs and fails every signature.
INTENT_TOKEN_SECRET=<the-BFF-effective-key: its INTENT_TOKEN_SECRET, else its SESSION_SECRET>
# Fail the request closed when the intent token is missing, invalid, expired, or does
# not permit the requested tool. Default false = observe + report to the PDP only
# (parity with the Node gateway's INTENT_TOKEN_REQUIRED).
INTENT_TOKEN_REQUIRED=false

# X-TraT-Context carries RAR authorization_details, purpose, and cnf.jkt, but the
# envelope is UNSIGNED. Only when this is true does the gateway treat it as decision
# evidence (RarAuthorizationDetails / TratPurp / Cnf); otherwise it is ignored so a
# direct caller cannot forge them. Same flag the Node gateway and MCP server use.
#
# NOTE: the main stack's docker-compose.yml sets this in the ping-gateway `environment:`
# block as ${ALLOW_UNSIGNED_TRAT_CONTEXT:-true}, matching mcp-server and mcp-gateway, and
# `environment:` WINS over this env_file — so in the main stack the effective value is
# true unless you export ALLOW_UNSIGNED_TRAT_CONTEXT=false on the host (which moves all
# three services together). Leaving it false here while the other two paths defaulted true
# is what made the same request carry RAR/purp/cnf to the PDP through the Node gateway and
# lose it through PingGateway. This value governs the STANDALONE ping-gateway compose only.
ALLOW_UNSIGNED_TRAT_CONTEXT=false

# --- Vault bridge TLS (apikey-dispatch.groovy) -------------------------------
# The BFF mkcert cert has SANs api.ping.demo/localhost only, but in-cluster the vault
# URL uses demo-api-server DNS. Setting this true relaxes TLS HOSTNAME verification
# (certificate trust is unaffected) for those demo hostnames. DEV ONLY — leave unset
# in any deployed environment; the durable fix is to add demo-api-server to the cert SANs.
PG_ALLOW_INSECURE_VAULT_HOSTNAME=false
