#!/usr/bin/env sh
# The Learning Hub mirror is regenerated manually with `npm run export:learning`
# and landed through a PR: the export snapshots measured layout and is not
# deterministic, so it must not run automatically.

# When a merge changes scope-topology.json, restart the BFF in the background.
# scopeTopology.js hot-reloads the manifest on mtime change, but MCP_TOOL_SCOPES
# is still frozen at require time, so a restart is needed for that (node --watch
# watches /app, not the repo-root topology). The file is directory-mounted
# (docker-compose.yml ./:/repo), so a restart suffices — no recreate. Backgrounded
# so the merge never stalls on Docker's
# stop timeout. No-op when Docker or the BFF isn't running.
if git diff --name-only ORIG_HEAD HEAD 2>/dev/null | grep -q '^scope-topology\.json$'; then
  if command -v docker >/dev/null 2>&1 && docker ps --format '{{.Names}}' 2>/dev/null | grep -q '^ai-demo-api-server$'; then
    echo "[post-merge] scope-topology.json changed — restarting BFF in background to reload MCP_TOOL_SCOPES..."
    nohup docker restart ai-demo-api-server >/dev/null 2>&1 &
  fi
fi

exit 0
