#!/usr/bin/env sh
# Auto-export the public Learning Hub mirror when a merge touches the in-app
# education panels, so the public GitHub Pages site stops drifting from the
# app. Runs in the background and never blocks or fails the git operation.
# Manual escape hatch: npm run export:learning.

if git diff --name-only ORIG_HEAD HEAD 2>/dev/null | grep -q '^demo_api_ui/src/components/education/'; then
  echo "[post-merge] education panels changed — exporting Learning Hub in background (logs/learning-hub-export.log)..."
  mkdir -p logs
  nohup npm run export:learning >> logs/learning-hub-export.log 2>&1 &
fi

# When a merge changes scope-topology.json, reload the BFF so it picks up the new
# SSOT: scopeTopology memoizes at first load and MCP_TOOL_SCOPES is frozen, so
# only a process restart reloads it (node --watch watches /app, not the repo-root
# topology). The file is directory-mounted (docker-compose.yml ./:/repo), so a
# restart suffices — no recreate. No-op when Docker or the BFF isn't running.
if git diff --name-only ORIG_HEAD HEAD 2>/dev/null | grep -q '^scope-topology\.json$'; then
  if command -v docker >/dev/null 2>&1 && docker ps --format '{{.Names}}' 2>/dev/null | grep -q '^ai-demo-api-server$'; then
    echo "[post-merge] scope-topology.json changed — restarting BFF to reload the SSOT..."
    docker restart ai-demo-api-server >/dev/null 2>&1 \
      && echo "[post-merge] BFF restarted." \
      || echo "[post-merge] BFF restart failed — run: docker restart ai-demo-api-server"
  fi
fi

exit 0
