#!/usr/bin/env sh
# ─── scope-topology.json "no drift" gate ───────────────────────────────────────
# When the scope SSOT — or anything that must stay in lock-step with it — is
# staged, regenerate the P1AZ snapshot (kept in sync automatically) and then
# BLOCK the commit unless the full OFFLINE verification passes: running-code
# consumers, P1AZ snapshot, PingGateway config, and the mock authz rule store.
# The live PingOne diff stays opt-in (npm run topology:verify:live).
TOPO_TOUCHED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(scope-topology\.json|scope-topology\.schema\.json|docs/scope-topology\.md|mcp-tool-schemas\.json|ping-gateway/(\.env\.example|config/)|demo_mcp_gateway/(\.env\.example|src/gatewayTools\.ts)|demo_mcp_server/src/tools/|demo_mcp_resource_server/src/tools/investTools\.ts|demo_api_server/services/(intentTokenService|configStore)\.js|snapshots/Super_Banking_Transaction_Authorization_P1AZ\.snapshot\.json)' || true)
if [ -n "$TOPO_TOUCHED" ] && [ ! -x demo_mcp_gateway/node_modules/.bin/ts-node ] && ! command -v ts-node >/dev/null 2>&1; then
  # The regen + drift checks below need node_modules (ts-node, topology deps). A
  # git worktree does not get its own node_modules, so these are absent there.
  # Do NOT hard-fail the whole hook in that case — that pushes developers to
  # `git commit --no-verify`, which ALSO bypasses the secret & backup-artifact
  # guards further down. Skip the drift check with a loud warning; the secret
  # guards still run. Re-run the drift check in the main checkout before merge.
  echo "[pre-commit] ⚠️  tool-schema/topology drift check SKIPPED — ts-node/node_modules unavailable (git worktree?)."
  echo "[pre-commit]    The secret & backup guards below STILL run. Run 'npm run topology:verify' in the main checkout before merging."
elif [ -n "$TOPO_TOUCHED" ]; then
  echo "[pre-commit] scope-topology / tool surface changed — regenerating P1AZ snapshot + tool schemas + verifying no drift..."
  # snapshots/ is gitignored (local-only artifact); only regenerate where present.
  if [ -f snapshots/gen-authorize-snapshot.js ]; then
    node snapshots/gen-authorize-snapshot.js
    git add snapshots/Super_Banking_Transaction_Authorization_P1AZ.snapshot.json 2>/dev/null || true
  fi
  # Keep PingGateway's tool schema (mcp-tool-schemas.json) in lock-step with the
  # tool registry (BankingToolRegistry + invest + gateway tools). Idempotent — a
  # no-op git add when nothing changed. Abort the commit if generation fails
  # rather than committing a stale schema.
  if ! npm --prefix demo_mcp_gateway run --silent gen:tool-schemas; then
    echo "[pre-commit] ❌ gen:tool-schemas failed — cannot regenerate mcp-tool-schemas.json (fix the tool source, then re-commit)."
    exit 1
  fi
  # Both outputs: the root artifact and IG's copy inside the ping-gateway/config
  # directory mount (see genToolSchemas.ts — they must stay byte-identical).
  git add mcp-tool-schemas.json ping-gateway/config/mcp-tool-schemas.json 2>/dev/null || true
  if ! npm run --silent topology:verify; then
    echo "[pre-commit] ❌ topology:verify failed — scope-topology.json drifts from PingGateway / P1AZ / running code / mock authz (see above)."
    echo "[pre-commit]    Fix the drift, or regenerate the derived artifacts (npm run scopes:doc / npm --prefix demo_api_server run scopes:gen), then re-commit."
    echo "[pre-commit]    Bypass (NOT recommended): git commit --no-verify"
    exit 1
  fi
  echo "[pre-commit] ✅ Snapshot updated + topology:verify passed."
fi

# ─── Worktree guard: no SOURCE commits from the shared main checkout ──────────
# CLAUDE.md: "Edit -> test -> commit only in an isolated git worktree." Concurrent
# sessions share one index, and this has silently clobbered work twice:
#   2026-07-11  5f5770de8 swept in a stale AIAgent.js, reverting 855f8a78a (§4).
#   2026-07-16  85f2b1e44 swept in stale demo_api_ui files, silently reverting
#               three commits. No test or build failure. Recovered in #516.
# PR #532 added a Claude Code PreToolUse hook for this, but that only binds Claude
# -- Cursor, Kilo, aider and a plain terminal are unaffected (.cursor/ exists here
# and jest.config.js still ignores /\.kilo/worktrees/). This is the same rule at
# the git layer, so it binds every tool.
#
# Detection is generic (no hardcoded paths): in a linked worktree --absolute-git-dir
# is <repo>/.git/worktrees/<name> while --git-common-dir is the shared <repo>/.git;
# in the main checkout the two resolve to the SAME directory.
GITDIR=$(git rev-parse --absolute-git-dir 2>/dev/null || true)
COMMONDIR=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
if [ -n "$GITDIR" ] && [ "$GITDIR" = "$COMMONDIR" ]; then
  # Exempt agent config and the contract docs: the clobber pattern is stale SOURCE
  # swept into a commit, not config -- and these must stay editable in the main
  # checkout or the hooks themselves become unmaintainable. Same list as #532.
  SRC=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -vE '^(\.claude/|CLAUDE\.md$|REGRESSION_PLAN\.md$|AGENTS\.md$)' \
    | grep -E '\.(js|jsx|ts|tsx|py|sh|css|scss|json|ya?ml)$' || true)
  if [ -n "$SRC" ]; then
    echo "[pre-commit] ❌ Source commit from the shared MAIN checkout — blocked."
    echo "$SRC" | head -5 | sed 's/^/    /'
    [ "$(echo "$SRC" | wc -l)" -gt 5 ] && echo "    ... $(echo "$SRC" | wc -l | tr -d ' ') files total"
    echo "[pre-commit]    Concurrent sessions share one index; this has silently"
    echo "[pre-commit]    clobbered work twice (REGRESSION_PLAN §4, 07-11 and 07-16)."
    echo "[pre-commit]    Commit from a worktree instead:"
    echo "[pre-commit]      git worktree add .claude/worktrees/<name> -b <branch>"
    echo "[pre-commit]    Exempt: .claude/**, CLAUDE.md, REGRESSION_PLAN.md, AGENTS.md."
    echo "[pre-commit]    Deliberate exception: git commit --no-verify"
    exit 1
  fi
fi

# ─── Secret & backup-artifact guard (added to prevent leak/stale-data recurrence) ───
# 1) Block accidental commits of app-generated backups even if .gitignore is bypassed (git add -f).
#    Only inspect added/modified files (--diff-filter=ACM) so REMOVING these backups is allowed.
BLOCKED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(\.bak$|\.env\.pre-import-|/data/backups/|(^|/)\.env$)' || true)
if [ -n "$BLOCKED" ]; then
  echo "[pre-commit] ❌ Refusing to commit backup/secret files:"
  echo "$BLOCKED" | sed 's/^/    /'
  echo "[pre-commit]    These are gitignored for a reason. Remove them from the commit."
  exit 1
fi

# 2) Scan staged changes for secrets. Prefer gitleaks; fall back to a high-signal regex.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --no-banner || {
    echo "[pre-commit] ❌ gitleaks found a secret in staged changes. Commit blocked."
    exit 1
  }
else
  HITS=$(git diff --cached -U0 | grep -E '^\+' \
    | grep -viE 'example|placeholder|redact|<.*>|process\.env|import\.meta|\$\{|test|mock|dummy|REACT_APP_' \
    | grep -EinC0 '(client[_-]?secret|worker[_-]?secret|api[_-]?key)["'"'"' ]*[:=]["'"'"' ]*[A-Za-z0-9._~/+-]{16,}|-----BEGIN [A-Z ]*PRIVATE KEY-----' \
    || true)
  if [ -n "$HITS" ]; then
    echo "[pre-commit] ❌ Possible secret in staged changes (regex fallback):"
    echo "$HITS" | sed -E 's/([:=]).{4}.*/\1***REDACTED***/' | head -5 | sed 's/^/    /'
    echo "[pre-commit]    Install gitleaks for accurate scanning: brew install gitleaks"
    echo "[pre-commit]    If this is a false positive, commit with --no-verify."
    exit 1
  fi
fi
