#!/bin/bash
# Pre-commit hook: block accidental secret commits
# Checks staged changes for common secret patterns

set -e

# ANSI colors
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

FOUND_SECRETS=0

# Patterns that look like secrets (case-insensitive)
SECRET_PATTERNS=(
  "PINGONE_.*_SECRET"
  "ANTHROPIC_API_KEY"
  "OPENAI_API_KEY"
  "JWT_SECRET"
  "SESSION_SECRET"
  "DATABASE_PASSWORD"
  "API_KEY"
  "bearer [A-Za-z0-9_-]{20,}"
)

echo "🔐 Checking for accidental secret commits..."

# Check staged files for secret patterns
for pattern in "${SECRET_PATTERNS[@]}"; do
  if git diff --cached -i --name-only | xargs grep -l "$pattern" 2>/dev/null | grep -v "\.template\|\.example\|\.md\|SECRETS_HARDENING"; then
    echo -e "${RED}❌ Found potential secret pattern: $pattern${NC}"
    git diff --cached -i | grep -B3 -A3 "$pattern" | head -20
    FOUND_SECRETS=1
  fi
done

# Check for .env files (should never be staged)
if git diff --cached --name-only | grep -E '\.env($|\..*$)' | grep -v "\.env\.template\|\.env\.example"; then
  echo -e "${RED}❌ Attempted to commit .env file (secrets):${NC}"
  git diff --cached --name-only | grep -E '\.env($|\..*$)'
  FOUND_SECRETS=1
fi

# Check for 03-secrets.yaml (K8s secrets should use sealed-secrets)
if git diff --cached --name-only | grep "03-secrets\.yaml"; then
  echo -e "${RED}❌ Attempted to commit unencrypted K8s secrets (use sealed-secrets):${NC}"
  echo "  Generate with: k8s/sealed-secrets.sh"
  FOUND_SECRETS=1
fi

if [ $FOUND_SECRETS -eq 1 ]; then
  echo -e "${RED}❌ Commit blocked. Unstage secrets with:${NC}"
  echo "  git reset HEAD <file>"
  echo ""
  echo "For help, see: docs/SECRETS_HARDENING.md"
  exit 1
fi

echo -e "${GREEN}✅ No obvious secrets detected.${NC}"
exit 0
