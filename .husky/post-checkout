#!/usr/bin/env sh
# Auto-export the public Learning Hub mirror when a branch checkout touches
# the in-app education panels, so the public GitHub Pages site stops drifting
# from the app. Runs in the background and never blocks or fails the git
# operation. Manual escape hatch: npm run export:learning.
#
# git passes: $1=prev HEAD, $2=new HEAD, $3=1 for a branch checkout (0 for a
# plain file checkout, which we ignore here).

prev_head=$1
new_head=$2
is_branch_checkout=$3

# Never fire inside an agent worktree (.claude/worktrees/<name>/...). The
# exporter's ensureMirror() does `git -C <mirror-dir> reset --hard origin/main`
# — safe against its intended standalone clone, but if MIRROR_DIR ever
# resolves to the checkout the hook is running in (seen 2026-09-07 in a
# Claude Code worktree), that reset lands on this checkout's own branch,
# discarding local commits. A worktree's dev stack isn't what publishes the
# Learning Hub anyway, so skipping here costs nothing.
case "$(pwd)" in
  */.claude/worktrees/*) exit 0 ;;
esac

if [ "$is_branch_checkout" = "1" ] && git diff --name-only "$prev_head" "$new_head" 2>/dev/null | grep -q '^demo_api_ui/src/components/education/'; then
  echo "[post-checkout] education panels changed — exporting Learning Hub in background (logs/learning-hub-export.log)..."
  mkdir -p logs
  nohup npm run export:learning >> logs/learning-hub-export.log 2>&1 &
fi

exit 0
