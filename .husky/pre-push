#!/usr/bin/env sh
# Local guard: reject force-pushes / deletions to protected branches (main/master).
# Bypassable with --no-verify. This is a local safety net, not a server-side rule.
z40=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master) ;;
    *) continue ;;
  esac
  if [ "$local_sha" = "$z40" ]; then
    echo "pre-push: BLOCKED deletion of $remote_ref (protected)." >&2
    status=1
    continue
  fi
  if [ "$remote_sha" != "$z40" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      echo "pre-push: BLOCKED non-fast-forward (force) push to $remote_ref (protected)." >&2
      echo "         Re-run with --no-verify only if this rewrite is intentional." >&2
      status=1
    fi
  fi
done

# ─── local CI gate: REMOVED 2026-08-02 ────────────────────────────────────────
# This used to run scripts/ci-local.sh on every push. It existed because GitHub
# Actions was billing-blocked (issue #524) and nothing else verified a merge.
# Actions has been running since 2026-07-28 and main is green, so ci.yml is the
# gate now and this was costing more than it caught:
#
#   - It ran the full jest suite at --maxWorkers=50%, above the maxWorkers:2 that
#     demo_api_server/jest.config.js sets under CI precisely because higher
#     counts flake the supertest suites. It blocked pushes at random on suites
#     that pass in isolation.
#   - git sends deletions through pre-push too, so `git push --delete <merged
#     branch>` ran a multi-minute test suite and then refused the delete.
#   - Every random block is a nudge toward --no-verify, which ALSO disables the
#     secret guards in pre-commit. A flaky gate makes the real guards weaker.
#
# scripts/ci-local.sh is kept and still works — run it by hand when you want the
# CI checks before pushing (it is the only way to run the suite against real
# credentials). It is just no longer automatic, and it is no longer the gate.
#
# The protected-branch guard above stays: it is fast, deterministic, and it is
# the thing that once stopped a force-push from dropping 11 merged PRs.

exit $status
