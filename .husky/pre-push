#!/usr/bin/env sh
# Local guard: reject force-pushes / deletions to protected branches (main/master).
# Bypassable with --no-verify. This is a local safety net, not a server-side rule.
z40=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master) ;;
    *) continue ;;
  esac
  if [ "$local_sha" = "$z40" ]; then
    echo "pre-push: BLOCKED deletion of $remote_ref (protected)." >&2
    status=1
    continue
  fi
  if [ "$remote_sha" != "$z40" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      echo "pre-push: BLOCKED non-fast-forward (force) push to $remote_ref (protected)." >&2
      echo "         Re-run with --no-verify only if this rewrite is intentional." >&2
      status=1
    fi
  fi
done

# ─── local CI gate ────────────────────────────────────────────────────────────
# GitHub Actions is billing-blocked (jobs die in ~3s with 0 steps; see issue
# #524), so every PR is red regardless of the code and nothing verifies a merge.
# Run the same checks ci.yml runs, here, until Actions is paying its bills again.
# ~65s. Bypassable with --no-verify.
if [ "$status" -eq 0 ]; then
  gate="$(git rev-parse --show-toplevel)/scripts/ci-local.sh"
  if [ ! -f "$gate" ]; then
    # This checkout predates the gate (older worktree, or a clone that has not
    # pulled yet). Skip loudly rather than blocking: a missing script is not a
    # failed check, and blocking here would teach people to use --no-verify,
    # which ALSO disables the secret guards in pre-commit.
    echo "pre-push: local CI gate not present in this checkout — skipping." >&2
    echo "          (expected at scripts/ci-local.sh; pull main to enable it)" >&2
  elif ! bash "$gate"; then
    status=1
  fi
fi

exit $status
