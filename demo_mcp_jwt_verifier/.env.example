# JWT Verifier MCP Server Configuration
# Python/FastMCP port of jwt-verifier-mcp-server, wired behind demo_mcp_gateway.
# Monorepo catalog (shared keys & BFF vars): ../.env.example

MCP_JWT_VERIFIER_HOST=0.0.0.0
MCP_JWT_VERIFIER_PORT=8083

# RFC 8707 audience validation — must match demo_mcp_gateway's
# MCP_JWTVERIFIER_RESOURCE_URI so the gateway's RFC 8693 re-exchange mints
# tokens this server accepts.
MCP_JWTVERIFIER_RESOURCE_URI=mcp-jwt-verifier.ping.demo

# PingOne auth-host JWKS + issuer, used to verify the signature of every
# inbound bearer token (same host as demo_mcp_server's PINGONE_JWKS_URI).
PINGONE_JWKS_URI=https://auth.pingone.com/your-environment-id/as/jwks
PINGONE_ISSUER=https://auth.pingone.com/your-environment-id/as

HTTP_TIMEOUT_SECONDS=10
MAX_JWKS_RESPONSE_BYTES=1048576
