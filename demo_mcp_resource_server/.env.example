# banking-mcp-resource-server — environment variables
# Copy to .env and fill in real values

PORT=8081
HOST=0.0.0.0

# Resource URI — must match what agents use as `audience` when exchanging for this server's token
# Comma-separated ACCEPTED audiences. mcp-invest.ping.demo is the audience the
# PingOne "Demo MCP Invest" resource carries; the other two stay accepted so the
# forward-unchanged fallback and any pinned older caller keep working.
MCP_RESOURCE_SERVER_RESOURCE_URI=mcp-invest.ping.demo,mcp-resource-server.ping.demo,mcpgateway.ping.demo
MCP_SERVER_RESOURCE_NAME=Super Banking MCP Server (mcp-resource-server)

# PingOne
PINGONE_ENVIRONMENT_ID=01d89b06-66d5-430e-9f28-65636843788b
PINGONE_REGION=com

# Agent Privilege "Static Token" auth mode (optional, off when unset).
# When set to a secret of at least 32 characters, a bearer equal to it is
# accepted on /mcp without JWT verification, as a caller with no user and only
# the scopes listed below. Enter the same value as the app's Static Token in
# the Privilege console. Every gateway caller then shares this one identity.
# Scopes are comma- or space-separated and default to none, so a token set
# without scopes can call no tool. `read` alone covers list tools in nine
# verticals; invest and airline tools need invest:read and airlines:read.
# MCP_RESOURCE_SERVER_GATEWAY_STATIC_TOKEN=
# MCP_RESOURCE_SERVER_GATEWAY_STATIC_SCOPES=read,invest:read,airlines:read

# Banking BFF (used by tool handlers)
BANKING_API_BASE_URL=https://api.ping.demo:3001
