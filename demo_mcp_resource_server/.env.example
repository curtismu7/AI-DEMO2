# banking-mcp-resource-server — environment variables
# Copy to .env and fill in real values

# PORT: configure this setting for demo_mcp_resource_server/.env.example; see the service documentation.
PORT=8081
# HOST: configure this setting for demo_mcp_resource_server/.env.example; see the service documentation.
HOST=0.0.0.0

# Resource URI — must match what agents use as `audience` when exchanging for this server's token
# Comma-separated ACCEPTED audiences. mcp-invest.ping.demo is the audience the
# PingOne "Demo MCP Invest" resource carries; the other two stay accepted so the
# forward-unchanged fallback and any pinned older caller keep working.
MCP_RESOURCE_SERVER_RESOURCE_URI=mcp-invest.ping.demo,mcp-resource-server.ping.demo,mcpgateway.ping.demo
# MCP_SERVER_RESOURCE_NAME: configure this setting for demo_mcp_resource_server/.env.example; see the service documentation.
MCP_SERVER_RESOURCE_NAME=Super Banking MCP Server (mcp-resource-server)

# PingOne
PINGONE_ENVIRONMENT_ID=your-pingone-env-id
# PINGONE_REGION: configure this setting for demo_mcp_resource_server/.env.example; see the service documentation.
PINGONE_REGION=com

# Banking BFF (used by tool handlers)
BANKING_API_BASE_URL=https://api.ping.demo:3001
