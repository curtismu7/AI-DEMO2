{
  "name": "banking-mcp-resource-server",
  "version": "1.0.0",
  "description": "mcp-resource-server — MCP server for investment account tools (aud: mcp-resource-server.bxf.com)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:clean": "rm -rf dist && npm run build",
    "dev": "nodemon --exec ts-node src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.59.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.200.0",
    "@opentelemetry/sdk-node": "^0.200.0",
    "axios": "^1.17.0",
    "dotenv": "^17.2.2",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.0",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "nodemon": "^3.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
