# banking-mcp-resource-server — standalone deployment
# Copy to .env (same directory as docker-compose.standalone.yml) and fill in
# real values. This server needs NO other AI-DEMO2 service to run: every
# vertical below is backed by its own bundled SQLite database except
# "invest", which is optional (see BANKING_API_BASE_URL).

PORT=8081
HOST=0.0.0.0

# --- Resource identity ---
# The audience (aud) this server accepts on inbound bearer tokens. Must match
# the resource/audience you configure on your own PingOne environment for
# whatever OAuth client mints tokens for your MCP caller.
MCP_RESOURCE_SERVER_RESOURCE_URI=your-resource-uri
MCP_SERVER_RESOURCE_NAME=Banking MCP Resource Server

# --- Your PingOne environment (bring-your-own) ---
# Used to build the RFC 9728 discovery metadata at
# /.well-known/oauth-protected-resource.
PINGONE_ENVIRONMENT_ID=your-pingone-env-id
PINGONE_REGION=com

# Token *signature* verification (JWKS) is separate from the two vars above —
# set ONE of these so inbound tokens are cryptographically checked against
# your PingOne environment's keys instead of only pattern-matched:
PINGONE_ISSUER=https://auth.pingone.com/your-pingone-env-id/as
# PINGONE_JWKS_URI=https://auth.pingone.com/your-pingone-env-id/as/jwks
# PINGONE_BASE_URL=https://auth.pingone.com/your-pingone-env-id/as

# Fail closed if a token's signature can't be verified (no JWKS reachable).
# Defaults to false (warn + accept) so this runs out of the box before
# PingOne is wired up. Set to true once real tokens are flowing.
STRICT_AUTH=false

# --- Optional: investment tools only ---
# get_investment_accounts / get_investment_balance / get_portfolio_summary /
# get_investment_transactions proxy to a banking API you run yourself. Every
# other tool (banking, healthcare, government, manufacturing, retail,
# sporting-goods, university, workforce, anf, airlines) reads its own
# bundled SQLite database and needs nothing here. Leave unset to skip invest.
# BANKING_API_BASE_URL=https://your-banking-api.example.com
