# Configuration template for development environment
# Copy this file to .env and fill in your actual values
# Monorepo catalog: ../.env.example

# LangChain agent ports (loopback only, not exposed externally):
#   :8888  — main uvicorn HTTP server (launched by run-bank.sh)
#   :8889  — chat streaming WebSocket (WEBSOCKET_PORT, defaulted in src/config/settings.py)
#   :8890  — health + /inspector/mcp-host JSON sidecar (HEALTH_HTTP_PORT)
#
# Defaults below match the code defaults. Override here only if you need to.
HEALTH_HTTP_PORT=8890
AGUI_HTTP_HOST=127.0.0.1
AGUI_HTTP_PORT=8888
# Server bind hosts default to loopback; override only for container networking
CHAT_WS_HOST=127.0.0.1
TRACE_SERVER_HOST=127.0.0.1
# Chat WebSocket Origin allowlist (comma-separated) + max frame size in bytes
ALLOWED_WS_ORIGINS=https://demo-api-server:3001,http://localhost:4000,http://127.0.0.1:4000
WS_MAX_MESSAGE_BYTES=65536

ENVIRONMENT=
DEBUG=
LOG_LEVEL=
WEBSOCKET_PORT=8889
LANGCHAIN_VERBOSE=
# WebSocket streaming during agent turns (MCP tool lifecycle + LLM tokens; ChatOpenAI only)
LANGCHAIN_STREAM_MCP_TOOL_EVENTS=true
LANGCHAIN_STREAM_LLM_TOKENS=true
# Conversation trimming: maximum number of messages to keep per session (Stage 1).
# NOTE: token_counter=len counts messages, not tokens — this is a message-count cap,
# not a token-budget. A value of 4096 keeps up to 4096 messages before trimming.
# Set this BELOW max_messages_per_session (default 100) to activate Stage-1 trimming.
# Example: set to 20 to trim to the 20 most recent messages before the count cap runs.
LANGCHAIN_MAX_CONTEXT_TOKENS=4096
LANGCHAIN_MODEL_NAME=
PINGONE_REDIRECT_URI=
SESSION_TIMEOUT_MINUTES=

# PingOne AI IAM Core Configuration
# Replace with your actual ForgeRock tenant configuration
PINGONE_BASE_URL=
PINGONE_CLIENT_REGISTRATION_ENDPOINT=
PINGONE_TOKEN_ENDPOINT=
PINGONE_AUTHORIZATION_ENDPOINT=
PINGONE_DEFAULT_SCOPE=
PINGONE_REALM=

# Token validation (this agent validates its OWN audience — T-5)
# Primary accepted audience: REQUIRED — the validator refuses to start
# without one. The value below is the canonical local-dev audience.
PINGONE_RESOURCE_LANGCHAIN_AGENT_URI=https://banking-langchain-agent.banking-demo.com
# Extra accepted audiences (comma-separated, explicit opt-in only)
LANGCHAIN_ACCEPTED_AUDIENCES=
# Issuer override; when blank it is derived from PINGONE_TOKEN_ENDPOINT
# (https://auth.pingone.com/<envId>/as/token -> https://auth.pingone.com/<envId>/as)
PINGONE_ISSUER=
# JWKS override; when blank it is derived from PINGONE_TOKEN_ENDPOINT
LANGCHAIN_JWKS_URI=
PINGONE_JWKS_URI=

# OAuth client credentials (pre-provisioned by `npm run pingone:bootstrap`)
PINGONE_USER_CLIENT_ID=
PINGONE_USER_CLIENT_SECRET=
AGENT_CLIENT_ID=
AGENT_CLIENT_SECRET=
# ForgeRock Dynamic Client Registration opt-in (PingOne does not support it)
AGENT_DCR_ENABLED=false

# MCP resource indicators (RFC 8707 audience binding for agent tokens)
# MCP_GW_RESOURCE_URI is the gateway audience (Phase 243); MCP_SERVER_RESOURCE_URI
# is the legacy fallback.
MCP_GW_RESOURCE_URI=
MCP_SERVER_RESOURCE_URI=

# MCP transport: "websocket" (default) or "streamable_http"
MCP_TRANSPORT=websocket

# LLM provider: "helix" (default), "lmstudio", "anthropic-lmstudio", "anthropic"
LANGCHAIN_LLM_PROVIDER=helix
# Helix (Ping AI) — tenant-specific; REQUIRED for the helix provider
HELIX_BASE_URL=https://openam-helix.forgeblocks.com
HELIX_API_KEY=
HELIX_ENVIRONMENT_ID=your-helix-environment-uuid
HELIX_AGENT_ID=LLM2
HELIX_PROMPT_FIELD_ID=your-prompt-field-id
# LM Studio (OpenAI-compatible endpoint; also used by anthropic-lmstudio)
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# API Keys
# Get your OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic key — real key for the "anthropic" provider; any non-empty value
# works for LM Studio (defaults to "lm-studio")
ANTHROPIC_API_KEY=

# MCP Server Configuration (add as needed)
MCP_SERVER_BANKING_ENDPOINT=
MCP_SERVER_BANKING_CAPABILITIES=
MCP_SERVER_BANKING_AUTH_REQUIRED=

# MCP_SERVER_GITHUB_ENDPOINT=
# MCP_SERVER_GITHUB_CAPABILITIES=
# MCP_SERVER_GITHUB_AUTH_REQUIRED=

# MCP_SERVER_SLACK_ENDPOINT=
# MCP_SERVER_SLACK_CAPABILITIES=
# MCP_SERVER_SLACK_AUTH_REQUIRED=

# --- external_client.py only (langchain_agent/src/mcp/external_client.py) ---
# Standalone CLI proof harness for the two "external agent" MCP front doors
# (Agent Gateway / Privilege-agentless). NOT required for the main agent
# service — only needed to run: python -m src.mcp.external_client
#
# Both endpoints below must be the BASE URL with NO trailing "/mcp" —
# StreamableHttpMCPConnection appends "/mcp" itself; passing an endpoint that
# already ends in "/mcp" produces a double "/mcp/mcp" and 404s.
# MCP_SERVER_AGENT_GATEWAY_ENDPOINT=https://your-gateway.example.com
# MCP_SERVER_PRIVILEGE_ENDPOINT=https://your-agentless-mcpgw.example.com

# Privilege Cloud MCP Gateway (agentless) OAuth PKCE client — see PrivilegeConfig
# PRIVILEGE_MCP_CLIENT_ID=
# PRIVILEGE_MCP_CLIENT_SECRET=
# PRIVILEGE_MCP_AUTHORIZE_URL=https://your-privilege-tenant.example.com/authorize
# PRIVILEGE_MCP_TOKEN_URL=https://your-privilege-tenant.example.com/token
# PRIVILEGE_MCP_REDIRECT_URI=http://127.0.0.1:8765/callback
# PRIVILEGE_MCP_SCOPE=openid
# PRIVILEGE_MCP_CALLBACK_PORT=8765
