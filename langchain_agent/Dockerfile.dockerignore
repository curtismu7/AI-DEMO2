# Allow only the files copied by langchain_agent/Dockerfile.
**
!langchain_agent/
!langchain_agent/requirements.txt
!langchain_agent/src/
!langchain_agent/src/**
!langchain_agent/scripts/
!langchain_agent/scripts/**
!langchain_agent/repo-src/
!langchain_agent/repo-src/**
!langchain_agent/.env.example
!langchain_agent/codegraph.db*
!scripts/
!scripts/build-codegraph.py

# Keep credentials, local state, dependencies, VCS metadata, logs, and caches out.
**/.git
**/.env
**/.env.*
!langchain_agent/.env.example
**/*.key
**/credentials*.json
**/secrets*.json
**/*.pem
**/*.crt
**/*.cer
**/*.p12
**/*.pfx
**/node_modules
**/venv
**/.venv
**/env
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.cache
**/logs
**/*.log
**/coverage
**/.coverage*
**/htmlcov
