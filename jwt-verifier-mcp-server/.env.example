# JWT Verifier MCP Server
# Environment configuration (optional — all defaults are sensible)

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# HTTP client timeout (ms) for JWKS URI fetches
HTTP_TIMEOUT_MS=10000

# Maximum JWKS size to accept (bytes)
MAX_JWKS_SIZE=1048576

# Clock tolerance for exp/nbf validation (seconds)
DEFAULT_CLOCK_TOLERANCE_SECONDS=30
