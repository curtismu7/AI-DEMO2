# Banking API Server — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# This file documents every variable the server uses, using the EXACT names
# that bootstrap (npm run pingone:bootstrap) writes to .env.
#
# Usage:
#   Run bootstrap to generate a populated .env:
#     cd demo_api_server && npm run pingone:bootstrap
#   Or copy this file and fill in secrets manually:
#     cp .env.example .env
#
# Default local host: https://api.ping.demo (HTTPS via mkcert)
#   BFF binds on :3001 — actual server listener
#   UI runs on  :4000  — also where users land in the browser
#   PINGONE_PUBLIC_APP_URL defaults to the UI port (:4000) because OAuth
#   callbacks land in the browser; CRA proxy (setupProxy.js) forwards
#   /api/auth/oauth/callback from :4000 → BFF :3001.
#
# Override any value via the /setup page (saved to LMDB, survives .env loss)
# or by editing this file (requires server restart).
#
# SoT: docs/PINGONE_CONFIG.md — canonical PingOne entity IDs and audiences.
# NEVER commit this file with real secrets. .env is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# =============================================================================
# CORE PINGONE CONFIGURATION
# =============================================================================
# PingOne environment UUID — Admin → Environments → (env) → Environment ID
PINGONE_ENVIRONMENT_ID=

# Region TLD: com (default) | eu | ca | com.au | asia | sg
PINGONE_REGION=com

# PAR (RFC 9126) endpoint for the intent-binding demo's live mode.
# Format: https://auth.pingone.<region>/<envId>/as/par
PINGONE_PAR_ENDPOINT=
# Registered redirect_uri of the AI Agent Actor client — the PAR push (S256 PKCE)
# is rejected unless this exactly matches a redirectUris entry on that app.
PINGONE_AI_AGENT_ACTOR_REDIRECT_URI=

# Ping Identity email — must be @pingidentity.com (personal email rejected).
# Used by run-k8.sh to derive your SE K8 namespace
# (local part, dots stripped: cmuir@pingidentity.com → ping-devops-cmuir).
# Bootstrap auto-fills from git config user.email when it ends in @pingidentity.com.
# Override with SE_NAMESPACE if you need a different namespace.
PING_EMAIL=

# =============================================================================
# SESSION / ENCRYPTION
# =============================================================================
# Strong random secret for Express session signing and config encryption.
# Bootstrap generates this automatically and preserves it on re-runs.
# Generate manually: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BOOTSTRAP_ALLOWLIST: always read from .env, never overridden by LMDB.
SESSION_SECRET=

# =============================================================================
# ADMIN OAUTH APP  (Demo Admin App — staff / BFF login)
# =============================================================================
# Web Application in PingOne with grant types: authorization_code, refresh_token, token_exchange
# Token Endpoint Auth Method: CLIENT_SECRET_POST
PINGONE_ADMIN_CLIENT_ID=
PINGONE_ADMIN_CLIENT_SECRET=
# Redirect URI — auto-derived from PINGONE_PUBLIC_APP_URL; uncomment only to override
# PINGONE_ADMIN_REDIRECT_URI=https://demo-api-server:3001/api/auth/oauth/callback

# Token endpoint auth method: 'post' (CLIENT_SECRET_POST, PingOne default for web apps)
# Override to 'basic' only for older PingOne apps configured with CLIENT_SECRET_BASIC.
PINGONE_ADMIN_TOKEN_ENDPOINT_AUTH=post

# Dedicated CIBA-only PingOne application (Grant Type = CIBA, no other grants).
# Optional — cibaService.js falls back to PINGONE_ADMIN_CLIENT_ID/SECRET when unset.
# See docs/superpowers/plans/2026-07-20-ciba-real-platform-provisioning.md.
PINGONE_CIBA_CLIENT_ID=
PINGONE_CIBA_CLIENT_SECRET=

# =============================================================================
# USER OAUTH APP  (Demo User App — end-user / customer login)
# =============================================================================
# Web Application in PingOne with grant types: authorization_code, refresh_token
# Token Endpoint Auth Method: NONE (public client) — PKCE-only since 2026-08-24.
# No client secret: PINGONE_USER_CLIENT_SECRET is unused, do not set it (see docs/ENV.md).
PINGONE_USER_CLIENT_ID=
# Redirect URI — auto-derived from PINGONE_PUBLIC_APP_URL; uncomment only to override
# PINGONE_USER_REDIRECT_URI=https://demo-api-server:3001/api/auth/oauth/user/callback

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=3001
NODE_ENV=development

# =============================================================================
# FRONTEND / PUBLIC URLs (sourced from scope-topology.json deployment section)
# =============================================================================
# Master SoT: scope-topology.json → deployment.environments.local.publicAppUrl
# Used for all OAuth redirect URIs and browser-facing links.
# Public origin where users open the app in their browser. Drives ALL OAuth
# redirect URIs automatically (callbacks must land at the browser origin).
# Register these in PingOne app → Redirect URIs:
#   Admin redirect: {PINGONE_PUBLIC_APP_URL}/api/auth/oauth/callback
#   User  redirect: {PINGONE_PUBLIC_APP_URL}/api/auth/oauth/user/callback
#
# local.ping-devops.com — NOT api.ping.demo — because passkeys only work here.
# WebAuthn requires the FIDO2 rp.id to be the origin's host or a registrable
# parent of it, and PingOne rejects any rp.id whose TLD isn't public, so
# `api.ping.demo` can never be a relying-party id. Serving from a host under
# ping-devops.com lets rp.id=ping-devops.com cover local AND the SE cluster.
# Requires: 127.0.0.1 local.ping-devops.com in /etc/hosts (run.sh adds it).
# api.ping.demo still resolves and works for everything except passkeys.
PINGONE_PUBLIC_APP_URL=https://local.ping-devops.com:4000
PUBLIC_APP_URL=https://local.ping-devops.com:4000
# Comma-separated list — both local browser origins are accepted.
CORS_ORIGIN=https://local.ping-devops.com:4000,https://api.ping.demo:4000

# FIDO2 relying-party id. Must be a registrable parent of every origin that
# needs passkeys (local.ping-devops.com and ai-demo.ping-devops.com), since a
# PingOne environment holds exactly one. Applied at API-server boot.
FIDO2_RP_ID=ping-devops.com

# Step-up method surfaced to the UI as `step_up_method` on every 428:
#   ciba  — back-channel challenge
#   email — OIDC re-auth redirect
#   p1mfa — real PingOne device authentication. ONLY this value makes the agent
#           step-up modal show the device picker (SMS / email / passkey); any
#           other value renders the stub OTP-only modal, so a passkey can never
#           be selected. Passkeys also need the browser origin under FIDO2_RP_ID.
STEP_UP_METHOD=p1mfa


# UI URLs — used by BFF to redirect after login/logout.
# Default: same origin as PINGONE_PUBLIC_APP_URL.
REACT_APP_CLIENT_URL=https://local.ping-devops.com:4000
FRONTEND_ADMIN_URL=https://local.ping-devops.com:4000/admin
FRONTEND_DASHBOARD_URL=https://local.ping-devops.com:4000/dashboard

# PingGateway resource URI (alternate gateway endpoint)
# Master SoT: scope-topology.json → deployment.environments.local.pingGatewayResourceUri
PINGONE_RESOURCE_PINGGATEWAY_URI=https://api.ping.demo:3036/mcp

# PingGateway /mcp/apikey route resource URI — api-key-disposition tools
# (show_mortgage, show_gear_order, ...) exchange against this audience instead
# of PINGONE_RESOURCE_PINGGATEWAY_URI above. Distinct PingOne resource so a
# /mcp-scoped token cannot be replayed against /mcp/apikey.
PINGONE_RESOURCE_MCP_APIKEY_URI=https://api.ping.demo:3036/mcp/apikey

# =============================================================================
# RESOURCE SERVER AUDIENCES
# Audience (aud) values must match the resource server strings registered in PingOne.
# See docs/PINGONE_CONFIG.md → Resource Servers for the full table.
# =============================================================================

# Demo API resource — end-user access token audience.
# Bootstrap writes: ENDUSER_AUDIENCE=enduser.ping.demo
ENDUSER_AUDIENCE=enduser.ping.demo

# =============================================================================
# RESOURCE URIS (PingOne Resource Server Audiences — RFC 8707)
# ─────────────────────────────────────────────────────────────────────────────
# PINGONE_RESOURCE_MCP_GATEWAY_URI: MCP Gateway's audience (Exchange #2 actor)
# PINGONE_RESOURCE_MCP_SERVER_URI: MCP Server audience (backend MCP server)
# PINGONE_RESOURCE_MCP_RESOURCE_SERVER_URI: MCP Invest callback route audience
# PINGONE_RESOURCE_JWT_VERIFIER_URI: JWT verifier service audience
# PINGONE_RESOURCE_A2A_INTERMEDIATE_*_URI: A2A specialist intermediate audiences
# =============================================================================

PINGONE_RESOURCE_MCP_SERVER_URI=mcpserver.ping.demo
# Canonical PingOne "Demo MCP Invest" audience first; legacy name kept so a pinned
# older caller still matches the portfolio callback (audiences are ADDED, never swapped).
PINGONE_RESOURCE_MCP_RESOURCE_SERVER_URI=mcp-invest.ping.demo,mcp-resource-server.ping.demo
PINGONE_RESOURCE_JWT_VERIFIER_URI=mcp-jwt-verifier.ping.demo

# =============================================================================
# MCP TOKEN EXCHANGER  (Demo MCP Exchanger — RFC 8693 legacy actor, currently unused)
# =============================================================================
# Worker-style app used as the actor token source in the original single-exchange flow.
# The two-exchange flow uses PINGONE_AI_AGENT_CLIENT_ID + MCP_GW_CLIENT_ID instead.
# Kept for backwards compatibility; callers alias this as AGENT_OAUTH_CLIENT_ID (see below).
PINGONE_MCP_EXCHANGER_CLIENT_ID=
PINGONE_MCP_EXCHANGER_CLIENT_SECRET=

# =============================================================================
# MCP GATEWAY  (Demo MCP Gateway — :3005)
# =============================================================================
# WEB_APP in PingOne with grant types: client_credentials, token_exchange
# Acts as the Exchange #2 actor in the two-exchange RFC 8693 delegation chain.
MCP_GW_CLIENT_ID=
MCP_GW_CLIENT_SECRET=
# Token endpoint auth method for the gateway app: 'post' (CLIENT_SECRET_POST)
MCP_GW_TOKEN_ENDPOINT_AUTH_METHOD=post
# When true, gateway proxies MCP requests directly to the MCP server without
# performing a downstream token re-exchange. Used in local dev.
MCP_GW_PASSTHROUGH_TO_MCP_SERVER=true

# HTTP base URL of the MCP Gateway — triggers gateway-audience token exchange
# in agentMcpTokenService._resolveFinalMcpAudience.
# Local dev: https://127.0.0.1:3005 (TLS via mkcert, loopback only)
MCP_GATEWAY_HTTP_URL=https://127.0.0.1:3005

# WebSocket URL the BFF dials to reach the MCP server (or gateway in passthrough mode).
# Local dev: wss://127.0.0.1:3005 (routes through gateway)
# Direct MCP (no gateway): ws://localhost:8080
MCP_SERVER_URL=wss://127.0.0.1:3005

# Dev-only: skip TLS verification on the gateway /health probe and MCP WebSocket.
# Hard-ignored in production (NODE_ENV=production). Set via LMDB or this file.
# run.sh sets NODE_EXTRA_CA_CERTS instead — prefer that over this flag.
# GATEWAY_HEALTH_PROBE_INSECURE=true

# Optional: validate PingOne resource servers and scopes at startup.
# Checks all four Demo resource servers (audience values) and their scopes
# against the reference values in docs/PINGONE_CONFIG.md.
# Requires PINGONE_WORKER_CLIENT_ID + PINGONE_WORKER_CLIENT_SECRET to be set.
# Non-blocking — warnings only, never prevents startup.
# PINGONE_VALIDATE_ON_STARTUP=true

# =============================================================================
# DEMO AGENT SERVICE  (Demo Agent — :3006, worker app)
# =============================================================================
# WORKER app in PingOne with grant type: client_credentials
# Used by the agent service for internal BFF→agent auth and management API calls.
AGENT_CLIENT_ID=
AGENT_CLIENT_SECRET=

# =============================================================================
# CLAUDE CODE / CURSOR "pingone" MCP OAUTH CLIENT  (developer tooling, not runtime)
# =============================================================================
# NATIVE_APP in PingOne: PKCE S256, no client secret, grants authorization_code +
# refresh_token, redirect URIs: http://localhost:7464/callback (Claude Code),
# cursor://anysphere.cursor-mcp/oauth/callback (Cursor desktop). Bootstrap provisions
# the "PingOne MCP Server" app and writes its id here; install.sh patches it into
# .mcp.json and .cursor/mcp.json so the hosted PingOne MCP server authenticates.
PINGONE_MCP_OAUTH_CLIENT_ID=

# Claude Code "banking-gateway" MCP OAuth client (developer tooling). NATIVE_APP,
# PKCE S256, no secret; granted MCP Gateway resource scopes so its user token has
# aud=mcpgateway.ping.demo. Redirect http://localhost:7465/callback. Bootstrap
# provisions the "Claude Code - Banking Gateway" app and writes its id here;
# install.sh patches it into .mcp.json mcpServers.banking-gateway.oauth.clientId.
PINGONE_GATEWAY_MCP_OAUTH_CLIENT_ID=

# =============================================================================
# RFC 8693 TWO-EXCHANGE DELEGATION CHAIN
# ─────────────────────────────────────────────────────────────────────────────
# Exchange #1: AI Agent (d21c5124) exchanges:
#   subject_token = user access token (aud=enduser.ping.demo)
#   actor_token   = AI Agent CC token (aud=agentgateway.ping.demo)
#   → intermediate token: aud=agentgateway.ping.demo, act.sub=AI_AGENT_CLIENT_ID
#
# Exchange #2: MCP Exchanger (d3f8fead) exchanges:
#   subject_token = intermediate token (aud=agentgateway.ping.demo)
#   actor_token   = MCP Gateway CC token (aud=mcpgateway.ping.demo)
#   → final MCP token: aud=mcpgateway.ping.demo, act.sub=MCP_GW_CLIENT_ID
#
# See docs/PINGONE_CONFIG.md → RFC 8693 Token Exchange Chain for full diagram.
# =============================================================================

# Demo AI Agent — the RFC 8693 Exchange #1 actor
# WEB_APP in PingOne: authorization_code, client_credentials, token_exchange
PINGONE_AI_AGENT_CLIENT_ID=
PINGONE_AI_AGENT_CLIENT_SECRET=

# Audience values for the exchange chain
PINGONE_RESOURCE_AGENT_GATEWAY_URI=agentgateway.ping.demo
PINGONE_RESOURCE_MCP_GATEWAY_URI=mcpgateway.ping.demo

# Intermediate audience after Exchange #1 (same as PINGONE_RESOURCE_AGENT_GATEWAY_URI)
AI_AGENT_INTERMEDIATE_AUDIENCE=agentgateway.ping.demo

# Scope the AI Agent requests on the Agent Gateway resource in Exchange #1
TWO_EXCHANGE_INTERMEDIATE_SCOPE=agent:invoke

# ── Alias block — kept in sync with PINGONE_MCP_EXCHANGER_* above ────────────
# Some internal callers resolve the MCP Exchanger credentials under these names.
# Values MUST stay identical to PINGONE_MCP_EXCHANGER_CLIENT_ID/SECRET.
AGENT_OAUTH_CLIENT_ID=
AGENT_OAUTH_CLIENT_SECRET=

# =============================================================================
# ADMIN TOKEN EXCHANGE
# =============================================================================
# Use RFC 8693 token exchange for admin sessions (experimental)
ff_admin_token_exchange=true
# DPoP (RFC 9449) sender-constrained tokens: bind the MCP token to a per-session key
# (cnf.jkt) and sign a DPoP proof per hop. Gateway/MCP enforce when REQUIRE_DPOP_PROOF=true.
ff_dpop=false
# RAR (RFC 9396) intent-bound authorization: build authorization_details from the tool +
# params; gateway enforces params subset-of-grant when REQUIRE_RAR_INTENT=true.
ff_rar=false

# =============================================================================
# ENTERPRISE-MANAGED MCP AUTHORIZATION (Phase 1–2)
# =============================================================================
# Master switch — default off; toggle via Quick Flags or env.
ff_enterprise_managed_mcp_auth=false
# Comma-separated PingOne group names or population IDs allowed MCP access
ENTERPRISE_MCP_ALLOWED_GROUPS=banking-agents,employees
# Optional override; defaults to scope-topology MCP resource URIs when empty
ENTERPRISE_MCP_RESOURCE_URIS=

# Access token lifetime (seconds) for admin OAuth app
ADMIN_TOKEN_LIFETIME=7200
# Refresh token lifetime (seconds) for admin OAuth app
ADMIN_REFRESH_TOKEN_LIFETIME=86400

# =============================================================================
# TOKEN ENDPOINT AUTH METHODS
# =============================================================================
# ARCHITECTURE: every PingOne client connection uses CLIENT_SECRET_POST ('post').
# The ONLY exception is the Worker Token CC client (WORKER type, Management API)
# which stays CLIENT_SECRET_BASIC ('basic'). See docs/PINGONE_CONFIG.md.
PINGONE_ADMIN_TOKEN_ENDPOINT_AUTH=post
# Token introspection authenticates AS the token's ISSUING client (PingOne binds
# RFC 7662 introspection to the issuer; a Worker introspecting another client's
# user token gets active:false -> "Session expired" reauth loop). The BFF default
# introspects user tokens as PINGONE_USER_CLIENT_ID (the Demo User App, post); the
# gateway introspects exchanged tokens as GW_INTROSPECTION_CLIENT_ID (MCP Exchanger,
# post). This var ONLY applies to the optional dedicated PINGONE_INTROSPECTION_CLIENT_ID
# override; every non-worker app is client_secret_post.
PINGONE_INTROSPECTION_AUTH_METHOD=post

# =============================================================================
# DEMO USERS  (created by bootstrap — passwords match PingOne)
# =============================================================================
DEMO_USER_USERNAME=demoUser
DEMO_USER_PASSWORD=2Federate!
DEMO_ADMIN_USERNAME=demoAdmin
DEMO_ADMIN_PASSWORD=2Federate!

# =============================================================================
# WORKER CREDENTIALS  (Demo Worker Token App — Management API)
# =============================================================================
# WORKER app in PingOne with grant type: client_credentials
# Token endpoint auth method: CLIENT_SECRET_BASIC (only exception to post rule above)
# Used for PingOne Management API calls (user management, app config, provisioning).
PINGONE_WORKER_CLIENT_ID=
PINGONE_WORKER_CLIENT_SECRET=

# =============================================================================
# INTERNAL SERVICE SECRET
# =============================================================================
# Shared secret between BFF (:3001) and demo_agent_service (:3006).
# Used in x-internal-gateway-secret header for BFF→agent internal calls.
# Bootstrap generates this; set to any strong random value.
BFF_INTERNAL_SECRET=

# =============================================================================
# OPTIONAL: MFA CONFIGURATION
# =============================================================================
# MFA Policy ID from PingOne — Policies → Sign-On Policies → (policy) → Policy ID
# PINGONE_MFA_POLICY_ID=
# ACR value to request for MFA (must match a Sign-On Policy name in PingOne)
# PINGONE_MFA_ACR_VALUE=Multi_factor

# =============================================================================
# OPTIONAL: PORTABLE ENCRYPTED CREDENTIAL VAULT
# =============================================================================
# The vault keeps secrets out of .env. Drop a secrets.vault file at the repo
# root (created via `npm run vault:set ...`) and provide the unlock password.
# The BFF reads the vault at startup, merges entries into configStore, then
# deletes VAULT_PASSWORD from process.env immediately.
#
# ⚠️  No password recovery. Lose the password → rebuild from source secrets.
# Quote secrets (CLAUDE.md rule): special chars like ~ . - break shell parsing.
# Vercel: vault is SKIPPED when VERCEL=1 — use Encrypted Environment Variables.
#
# VAULT_PATH=
# VAULT_PASSWORD=

# =============================================================================
# OPTIONAL: HELIX LLM  (defaults to the shared Super Banking demo agent)
# =============================================================================
# Four Helix values are committed as defaults in configStore.js so this repo
# works out of the box for the public demo. Only HELIX_API_KEY is required.
#
# Priority order for the API key:
#   1. HELIX_API_KEY here (or shell env) — wins
#   2. /setup → LLM Provider → Helix — saved in LMDB configStore
#   3. <HELIX_AGENT_ID>.json in repo root / ~/Documents / ~/Downloads
#      (Helix Console → API Keys → Download; file is gitignored)
HELIX_API_KEY=
# Override only when pointing at a different Helix tenant:
# HELIX_BASE_URL=https://openam-helix.forgeblocks.com
# HELIX_ENVIRONMENT_ID=fe213c3c-9c1d-4bdb-954a-a22879dad26d
# HELIX_AGENT_ID=LLM
# HELIX_PROMPT_FIELD_ID=textInput502c5045a61c

# =============================================================================
# OPTIONAL: LLAMA.CPP  (local LLM fallback for NL intent)
# =============================================================================
# llama.cpp's llama-server (OpenAI-compatible /v1 API). LLAMACPP_BASE_URL is the
# origin only (no /v1) — the services append /v1. Defaults to
# http://127.0.0.1:8090 when unset. Set to a remote host for a shared instance.
# LLAMACPP_MODEL is optional; when unset the served model (/v1/models) is used.
# LLAMACPP_BASE_URL=http://127.0.0.1:8090
# LLAMACPP_MODEL=phi-4-mini-instruct
# LLM_BACKEND=llamacpp   # default — 2-tier llama.cpp proxy on Mac
# LLM_BACKEND=omlx       # Mac only — oMLX on :8090 (see demo_llm_proxy/start-omlx.sh)
# LLM_BACKEND=mlx        # Mac only — mlx-lm fallback on :8090 (see demo_llm_proxy/start-mlx.sh)
#
# Keep-warm (demo latency): decay off by default in run.sh / docker-compose.
# LLM_PROXY_IDLE_DECAY_MS=0          # 0 = never idle-unload; 300000 = classic 5-min decay
# LLM_PROXY_PIN_TIER=8096           # optional hard pin to gpt-oss agent brain
# LLM_WARMUP=1                      # background scripts/llm-warmup.sh from ./run.sh
# LLM_CTX_SIZE=8192                 # llama-server context (smaller = faster load)
# LLM_N_PARALLEL=1
# LLM_SLOT_PROMPT_SIMILARITY=0.50
# NL_INTENT_CACHE_TTL_MS=600000     # BFF repeat free-text cache (10 min)
#
# Apple mlx-lm demo agent mode (separate from LLM_BACKEND — one model on :8098):
# MLX_LM_BASE_URL=http://127.0.0.1:8098
# MLX_LM_MODEL=mlx-community/Phi-4-mini-instruct-4bit
# Setup: bash demo_llm_proxy/setup-mlx-venv.sh && bash demo_llm_proxy/start-mlx-lm.sh start

# =============================================================================
# OPTIONAL: PINGONE RECOGNIZE  (biometric face auth)
# =============================================================================
# Obtain from Recognize tenant dashboard (SDK Customer Dashboard).
# RECOGNIZE_API_KEY=
# RECOGNIZE_TENANT_NAME=
# RECOGNIZE_BASE_URL=https://authentication-service.eks.core-production.saas-us-east.keyless.technology

# =============================================================================
# OPTIONAL: SESSION STORE
# =============================================================================
# Default: LMDB at demo_api_server/data/sessions-lmdb/ (no config needed).
# For multi-process / Vercel deployments, use one of:
# REDIS_URL=
# KV_URL=

# =============================================================================
# OPTIONAL: ANTHROPIC  (Claude as agent reasoning provider)
# =============================================================================
# Optional — enables the "Claude (Anthropic)" agent mode in the UI.
# Set LLM_PROVIDER=anthropic in demo_agent_service/.env and provide key here.
# The BFF forwards this to :3006 — it never reaches the browser.
# ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# AGENT CONVERSATION HISTORY
# =============================================================================
# Maximum number of messages forwarded to stateless agents (sliding window).
# Prevents unbounded context growth. Default: 20. Min: 1.
# AGENT_HISTORY_LIMIT=10

# =============================================================================
# DEBUG  (set to false in production)
# =============================================================================
PINGONE_DEBUG_OAUTH=false
DEBUG_TOKENS=false
DEBUG_SCOPES=false
# WARNING: Must be false in production — server exits at startup if NODE_ENV=production
# This one is the BFF's OWN switch (middleware/auth.js). It is NOT propagated to
# other services — see MCP_SERVER_SKIP_TOKEN_SIGNATURE_VALIDATION below.
SKIP_TOKEN_SIGNATURE_VALIDATION=false

# --- MCP server auth switches -------------------------------------------------
# Both are fail-OPEN and belong HERE, not hand-edited into oauth-mcp/.env, which
# scripts/refresh-service-envs.js rewrites wholesale on every ./run.sh (that is
# how two hand-added toggles kept silently disappearing).
#
# Deliberately separate from the BFF key above: the generator emits this as
# SKIP_TOKEN_SIGNATURE_VALIDATION *inside oauth-mcp/.env only*, so turning it on
# for the MCP server does not also switch off the BFF's token validation.
MCP_SERVER_SKIP_TOKEN_SIGNATURE_VALIDATION=false
# Accept an agent token when the JWKS endpoint is unreachable rather than failing
# closed — outage convenience that means the signature is NOT verified.
ALLOW_JWKS_FAILOPEN=false

# =============================================================================
# NEW RELIC APM  (optional — disabled when NR_LICENSE_KEY is unset)
# =============================================================================
# License key from New Relic → Account → API Keys → License Key (40-char NRAL string).
# When set: APM agent instruments the BFF, named transactions are sent per use case,
# custom spans trace PingOne/MCP/HITL calls, and app events forward to NR Logs API.
# When unset: all NR calls silently no-op — no effect on functionality.
# NR_LICENSE_KEY=

# New Relic User API key (NOT the license key above) — powers the public
# /monitoring/new-relic dashboard's NerdGraph proxy (routes/newRelicQuery.js).
# Generate: New Relic → API Keys → Create a key → User key.
# NR_USER_API_KEY=

# Numeric New Relic account id the dashboard above queries.
# NR_ACCOUNT_ID=

# =============================================================================
# SAILPOINT-STYLE LIFECYCLE EXPORT  (optional — disabled when SAILPOINT_WEBHOOK_URL is unset)
# =============================================================================
# Illustrative-only: this is NOT a real SailPoint integration. When set, agent
# joiner/mover/leaver lifecycle events (register, kill-switch, re-enable) also
# POST to this URL as a generic JSON webhook, simulating feeding an external
# IGA system. When unset, all export calls silently no-op — GET
# /api/control-plane/lifecycle-events still works as a pollable feed regardless.
# SAILPOINT_WEBHOOK_URL=
# SAILPOINT_WEBHOOK_API_KEY=

# =============================================================================
# NOTEBOOKLM DOCS SIDECAR  (admin-only Ping docs Q&A page)
# =============================================================================
# Base URL of the `notebooklm` compose service (docker/notebooklm/Dockerfile),
# including the server's /v1 router prefix — the proxied paths live under it.
# Internal compose network only — never published to the host.
NOTEBOOKLM_URL=http://notebooklm:8000/v1
# Directory the sidecar and the BFF both mount the Ping docs bundle text from,
# used to resolve NotebookLM citations back to doc URLs.
PING_DOCS_BUNDLE_DIR=/bundles
# Shared bearer token — same value on the notebooklm service (via this file's
# env_file mount) and the BFF. Generate: openssl rand -hex 32
NOTEBOOKLM_SERVER_TOKEN=changeme-generate-with-openssl-rand-hex-32

# =============================================================================
# PINGONE WEBHOOKS
# =============================================================================
# No variable is needed for the PingOne webhook. /webhook/pingone is an open,
# unauthenticated ingest endpoint by design — PingOne cannot sign a request
# body, so the HMAC check this once used could never pass against a real
# subscription. See docs/PINGONE-WEBHOOK.md.

# =============================================================================
# SENTRY ERROR MONITORING  (optional — disabled when SENTRY_DSN is unset)
# =============================================================================
# DSN from the Sentry project (Settings -> Client Keys). Leave blank to disable.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# Performance tracing sample rate (0 = errors only, 1 = all transactions).
# SENTRY_TRACES_SAMPLE_RATE=0

# =============================================================================
# POSTHOG  (optional — product analytics + LLM Analytics via llm-proxy)
# =============================================================================
# Project API key (phc_…) from PostHog → Project settings. Leave blank to no-op.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# =============================================================================
# REAL HTTP TESTS  (tests/real/ — RUN_REAL_TESTS=true)
# =============================================================================
# Headless PingOne login for jest.real.config.js (also accepts E2E_CUSTOMER_* from demo_api_ui).
# PINGONE_TEST_USER=
# PINGONE_TEST_PASSWORD=
# PINGONE_TEST_ADMIN_USER=
# PINGONE_TEST_ADMIN_PASSWORD=

# =============================================================================
# PINGONE-ADMIN FAÇADE DOOR — external MCP clients  (optional, security trade)
# =============================================================================
# The pingone-admin door needs a delegated PingOne PKCE token, and only a
# browser can obtain one. Set this to let an EXTERNAL MCP client use the door
# anyway: it falls back to the token a human established at
# /privilege-mcp-client (services/pingoneAdminSession.js).
#
# THE TRADE: the bearer the façade verifies is a generic mcp:invoke token —
# anything that completes DCR against the broker holds one, and nothing in it
# says "admin" — so every such caller acts as that operator, on
# environment-wide PingOne admin tooling. Unset (the default) the door serves
# only callers that forward their own x-pingone-admin-token, and answers
# everyone else with 401 + a loginUrl. docker-compose.yml turns it on for the
# demo stack, which is what the door exists for.
# MCP_FACADE_PINGONE_ADMIN_SHARED_SESSION=true
