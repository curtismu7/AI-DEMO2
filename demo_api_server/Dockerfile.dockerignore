**/.git
**/.worktrees
**/.claude
**/certs
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.crt
**/*.cer
**/*.enc
**/*.log
**/coverage
**/.cache
**/.npm
**/.vite
**/.turbo
**/test-results
**/.DS_Store
**/__pycache__
**/*.py[cod]
**/.venv
**/venv
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache

