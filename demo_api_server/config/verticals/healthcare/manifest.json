  "agent": {
    "persona": "Care Assistant",
    "greeting": "Hi {name}! I can review your appointments, check coverage details, and help you manage records requests. I'll walk you through the consent flows as we go. What do you need?",
    "systemPromptFlavor": "You are a PingHealth patient assistant. Help patients view their insurance coverage, check patient records, review appointment history, and understand their benefits. Use healthcare language: accounts are patient records, transactions are appointments, consultations, or referrals, balance is coverage amount. Respond with appropriate care and clarity."
  },
  "dashboard": {
    "kind": "healthcare",
    "chips": [
      {
        "key": "balance",
        "label": "Check Coverage"
      },
      {
        "key": "accounts",
        "label": "My Records"
      },
      {
        "key": "transactions",
