    "pay_bill": { "type": "card", "title": "Bill Paid", "fields": [ { "label": "Bill", "path": "description" }, { "label": "Amount", "path": "amountDue", "format": "money" }, { "label": "Status", "path": "status" } ] },
    "cancel_appointment": { "type": "card", "title": "Appointment Cancelled", "fields": [ { "label": "Provider", "path": "provider" }, { "label": "When", "path": "when", "format": "date" }, { "label": "Status", "path": "status" } ] },
    "reschedule_appointment": { "type": "card", "title": "Appointment Rescheduled", "fields": [ { "label": "Provider", "path": "provider" }, { "label": "When", "path": "when", "format": "date" }, { "label": "Status", "path": "status" } ] },
    "view_medications": {"type":"table","title":"Current Medications","columns":[{"label":"Medication","path":"name"},{"label":"Dosage","path":"dosage"},{"label":"Frequency","path":"frequency"},{"label":"Status","path":"status"},{"label":"Refills Remaining","path":"refillsRemaining","format":"count"}]},
    "refill_prescription": {"type":"card","title":"Refill Requested","fields":[{"label":"Medication","path":"name"},{"label":"Dosage","path":"dosage"},{"label":"Status","path":"status"}]},
    "view_lab_results": {"type":"table","title":"Lab Results","columns":[{"label":"Test","path":"test"},{"label":"Date","path":"date","format":"date"},{"label":"Result","path":"value"},{"label":"Reference Range","path":"referenceRange"},{"label":"Status","path":"status"}]},
    "view_vitals": {"type":"table","title":"Vital Signs","columns":[{"label":"Type","path":"type"},{"label":"Value","path":"value"},{"label":"Unit","path":"unit"},{"label":"Recorded Date","path":"recordedDate","format":"date"},{"label":"Recorded By","path":"recordedBy"}]},
    "view_care_team": {"type":"table","title":"My Care Team","columns":[{"label":"Provider","path":"name"},{"label":"Specialty","path":"specialty"},{"label":"Clinic","path":"clinic"},{"label":"Phone","path":"phone"},{"label":"Next Available","path":"nextAvailable","format":"date"}]},
    "list_messages": {"type":"table","title":"Secure Messages","columns":[{"label":"From","path":"from"},{"label":"Subject","path":"subject"},{"label":"Date","path":"date","format":"date"},{"label":"Status","path":"status"}]},
    "view_referrals": {"type":"table","title":"My Referrals","columns":[{"label":"Specialty","path":"specialty"},{"label":"Provider","path":"toProvider"},{"label":"Facility","path":"facility"},{"label":"Referred","path":"referredDate","format":"date"},{"label":"Expires","path":"expiryDate","format":"date"},{"label":"Status","path":"status"}]},
    "view_documents": {"type":"table","title":"My Health Documents","columns":[{"label":"Title","path":"title"},{"label":"Type","path":"type"},{"label":"Date","path":"date","format":"date"},{"label":"Status","path":"status"},{"label":"Uploaded By","path":"uploadedBy"}]},
    "view_immunizations": {"type":"table","title":"Immunization History","columns":[{"label":"Vaccine","path":"vaccine"},{"label":"Date","path":"date","format":"date"},{"label":"Dose","path":"dose"},{"label":"Manufacturer","path":"manufacturer"},{"label":"Status","path":"status"}]},
    "view_allergies": {"type":"table","title":"My Allergies","columns":[{"label":"Allergen","path":"allergen"},{"label":"Reaction","path":"reaction"},{"label":"Severity","path":"severity"},{"label":"Status","path":"status"},{"label":"Onset Date","path":"onsetDate","format":"date"}]},
    "view_dependents": {"type":"table","title":"Covered Dependents","columns":[{"label":"Name","path":"name"},{"label":"Relationship","path":"relationship"},{"label":"Date of Birth","path":"dob","format":"date"},{"label":"Coverage Status","path":"coverageStatus"},{"label":"Plan","path":"plan"}]},
    "view_care_plan": {"type":"table","title":"Care Plan Goals","columns":[{"label":"Goal","path":"goal"},{"label":"Target","path":"target"},{"label":"Due Date","path":"dueDate","format":"date"},{"label":"Status","path":"status"},{"label":"Assigned To","path":"assignedTo"}]},
    "mark_message_read": {"type":"card","title":"Message Marked as Read","fields":[{"label":"Subject","path":"subject"},{"label":"Status","path":"status"}]},
    "request_document": {"type":"card","title":"Document Request Submitted","fields":[{"label":"Document","path":"title"},{"label":"Type","path":"type"},{"label":"Status","path":"status"}]},
    "cancel_referral": {"type":"card","title":"Referral Cancelled","fields":[{"label":"Specialty","path":"specialty"},{"label":"Status","path":"status"}]},
    "view_records": { "type": "table", "columns": [ { "label": "Record ID", "path": "id" }, { "label": "Type", "path": "recordType" }, { "label": "Provider", "path": "provider" }, { "label": "Status", "path": "status" } ] },
