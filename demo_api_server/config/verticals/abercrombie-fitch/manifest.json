  "groups": {
    "access": {
      "label": "XClub member",
      "memberStory": "demoUser is an XClub member \u2014 the Style Assistant may read their sensitive Walbuy order history (purchases, returns, waitlist items).",
      "nonMemberStory": "demoDelegate has no XClub membership: sensitive order history is members-only, so their calls are denied today. Joining XClub flips it instantly."
},
    "categories": {
      "privileged": {
        "name": "AI_Demo_Privileged",
        "description": "Users permitted to reach the active vertical's sensitive tool (UC9). One group serves every vertical."
      },
      "delegates": {
        "name": "AI_Demo_Delegates",
        "description": "Users authorized as delegated agents. One group serves every vertical."
      },
      "premiumTier": {
        "name": "AbercrombieFitch_PremiumTier",
        "description": "Entitlement tier that gates this vertical's sensitive tool (UC21 permits, UC9 denies). Scoped to this vertical so a UC9 run does not deny the other eleven."
      }
    },
    "restrictedTools": {
      "sensitive_order_history": "premiumTier"
    },
    "userMemberships": {
      "demoUser": [
        "privileged",
        "premiumTier"
      ],
      "demoAdmin": [
        "privileged",
        "premiumTier"
      ],
      "demoDelegate": [
        "privileged",
        "premiumTier"
      ]
    }
  },
  "agent": {
    "persona": "Walbuy Style Assistant",
    "greeting": "Hi {name}! I can help with your Walbuy orders, myWalbuy rewards, saved styles, deliveries, and returns. What would you like to do?",
    "systemPromptFlavor": "You are the Walbuy Style Assistant. Help customers review Walbuy orders, track deliveries, check myWalbuy rewards, manage returns and saved items, and complete apparel purchases. Be concise and only use facts returned by tools."
  },
