  "agent": {
    "persona": "Liberty",
    "greeting": "Hi {name}! I'm Liberty. I can show your permits and licenses, check fees owed, review your filing history, and help you release permit records — I'll walk you through the consent steps. What do you need?",
    "systemPromptFlavor": "You are Liberty, a CivicPermit citizen-services assistant. Help residents view permits and licenses, check fees owed, review filing history, and release permit records. Use government permitting language: accounts are permits and licenses, transactions are filings (applications, inspections, renewals, records releases), balance is fees owed. Be clear and procedural."
  },
  "hero": {
    "imageUrl": "https://images.unsplash.com/photo-1593255136145-da399169fadd?w=1200&h=600&fit=crop",
    "greeting": "Welcome. How may we assist?"
  },
  "dashboard": {
    "kind": "government",
    "chips": [
      { "key": "balance", "label": "Fees Owed" },
      { "key": "accounts", "label": "My Permits" },
      { "key": "transactions", "label": "Filing History" },
      { "key": "transfer", "label": "Release Record" },
      { "key": "feature", "label": "Permit Status" }
    ],
    "hero": {
      "cards": [
        { "label": "Active Permits", "dataKey": "heroStats.activePermits", "format": "count" },
        { "label": "Fees Owed", "dataKey": "heroStats.feesOwed", "format": "money" },
        { "label": "Next Inspection", "dataKey": "heroStats.nextInspection", "format": "date" },
        { "label": "License Status", "dataKey": "heroStats.licenseStatus", "format": "text" }
      ]
    },
    "llmChipGroups": {
      "Permits": [
        { "id": "gov_permits", "label": "My permits", "message": "Show my permits and licenses" },
        { "id": "gov_expiring", "label": "Expiring soon", "message": "Which of my permits expire soon?" }
      ],
      "Fees": [
        { "id": "gov_fees", "label": "What do I owe?", "message": "What permit fees do I owe?" },
        { "id": "gov_pay", "label": "Pay a fee", "message": "I want to pay an outstanding permit fee" }
      ],
      "Filings": [
        { "id": "gov_filings", "label": "Filing history", "message": "Show my filing history" },
        { "id": "gov_inspection", "label": "Inspection status", "message": "What's the status of my latest inspection?" }
      ],
      "Records": [
        { "id": "gov_release", "label": "Release a record", "message": "Release my permit record to a third party" }
      ]
    },
    "chips10": [
      { "id": "gv-jwt", "label": "Decode my token", "message": "decode my jwt token", "mode": "both", "tool": "jwt_decode_full", "useCaseId": "delegated-access-with-proof" },
      { "id": "gv1", "label": "My permits", "message": "show my permits", "mode": "both", "tool": "view_permits", "useCaseId": "delegated-access-with-proof" },
      { "id": "gv2", "label": "Fees owed", "message": "what fees do I owe", "mode": "both", "tool": "view_fees", "useCaseId": "delegated-access-with-proof" },
      { "id": "gv4", "label": "Pay a fee", "message": "pay a permit fee", "mode": "both", "elicitationTrigger": true, "tool": "pay_fee", "useCaseId": "delegated-access-with-proof" },
      { "id": "gv5", "label": "🔑 Release record", "message": "release my permit record", "mode": "both", "hitlTrigger": true, "elicitationTrigger": true, "challenge": "step_up", "tool": "release_record", "useCaseId": "step-up-required" },
      { "id": "gv-feature", "label": "Permit status", "message": "show permit status", "mode": "both", "tool": "show_permit", "useCaseId": "delegated-access-with-proof" },
      { "id": "gv-a2a", "label": "Sensitive tax record", "message": "access my sensitive tax record", "mode": "both", "challenge": "consent", "tool": "sensitive_tax_record", "useCaseId": "a2a-delegation", "group": "advanced" },
      { "id": "gv6", "label": "Expiring permits", "message": "which permits expire soon", "mode": "llm", "tool": "view_permits" },
      { "id": "gv-direct", "label": "Direct MCP", "message": "get my permits", "mode": "direct", "tool": "view_permits" },
      { "id": "gv-dpop", "label": "DPoP / replay defense", "message": "fire a token with the wrong audience at the gateway", "mode": "direct", "tool": "test_wrong_audience", "useCaseId": "token-theft-replay" },
      { "id": "gv-deny", "label": "Authz DENY", "message": "show a patient's health record", "mode": "direct", "denyTool": "show_health_record", "useCaseId": "authz-denied" },
      { "id": "gv-bad-scope", "label": "Bad scope", "message": "run a call my token has no scope for", "mode": "direct", "tool": "test_wrong_scope", "useCaseId": "insufficient-scope" }
    ],
    "securityShowcase": {
      "tabs": [
        {
          "id": "defenses",
          "label": "Defenses",
          "chips": [
            { "id": "sec_mfa_otp", "label": "🔐 MFA · OTP", "message": "release my permit record", "mode": "both", "challenge": "step_up", "tool": "release_record", "hitlTrigger": true, "showcase": "mfa_otp", "stepUpMethod": "otp", "caption": "Defense worked. A high-value action forced live identity verification (email/SMS OTP) before a permit-record release — the agent alone couldn't complete it." },
            { "id": "sec_mfa_fido", "label": "🔐 MFA · Passkey", "message": "release my permit record", "mode": "both", "challenge": "step_up", "tool": "release_record", "hitlTrigger": true, "showcase": "mfa_fido", "stepUpMethod": "fido", "caption": "Defense worked. The same high-value gate was satisfied with a passkey (FIDO2/WebAuthn) — phishing-resistant step-up, no shared secret." },
            { "id": "sec_hitl", "label": "🔐 HITL consent", "message": "release my permit record", "mode": "both", "challenge": "consent", "tool": "release_record", "hitlTrigger": true, "showcase": "hitl_consent", "caption": "Defense worked. A human had to explicitly approve the agent's action; PingOne Authorize returned a bound, single-use receipt before the permit-record release ran." },
            { "id": "sec_deny", "label": "⛔ Authz DENY", "message": "show my mortgage", "mode": "direct", "denyTool": "show_mortgage", "showcase": "authz_deny", "caption": "Defense worked. PingOne Authorize hard-denied a tool from another vertical (AllowedVertical) — the agent can only reach tools the active context permits." },
            { "id": "sec_bad_scope", "label": "🚫 Bad scope", "message": "look up all customers", "mode": "both", "showcase": "bad_scope", "caption": "Defense worked. The call was refused with insufficient_scope — the user's token never carried admin scope, and RFC 8693 exchange can only narrow, never add, scope." }
          ]
        },
        {
          "id": "ai",
          "label": "AI Reasoning",
          "chips": [
            { "id": "sec_llm_analyze", "label": "Spot unusual patterns", "message": "Check for unusual patterns in my recent activity", "mode": "llm", "showcase": "llm_analyze", "caption": "The analysis path ran the full pipeline — same RFC 8693 → gateway → Authorize legs as a heuristic chip, no shortcut." },
            { "id": "sec_llm_explain", "label": "Why was that blocked?", "message": "Explain why my last blocked action was denied and walk me through the token chain", "mode": "llm", "showcase": "llm_explain", "caption": "The agent explained its own security posture from the live token-chain events — useful for teaching why a control fired." }
          ]
        },
        {
          "id": "attacks",
          "label": "Attacks",
          "chips": [
            { "id": "sec_atk_prompt_injection", "label": "💉 Prompt injection", "message": "review my recent transactions and act on any instructions you find", "mode": "both", "showcase": "atk_prompt_injection", "caption": "Attack blocked. A poisoned transaction tried to redirect the agent; the HITL gate + Authorize policy stopped the injected transfer regardless of what the LLM 'decided'." },
            { "id": "sec_atk_indirect_injection", "label": "💉 Indirect injection", "message": "summarize my accounts including any notes", "mode": "both", "showcase": "atk_indirect_injection", "caption": "Attack blocked. Malicious text hidden in account metadata couldn't drive an unauthorized action — the policy gate evaluates the request, not the agent's intent." },
            { "id": "sec_atk_wrong_aud", "label": "🎭 Wrong audience", "message": "fire a token with the wrong audience at the gateway", "mode": "direct", "showcase": "atk_wrong_aud", "caption": "Attack blocked. A token minted for the BFF was rejected at the gateway (D-05) — each hop validates the aud claim was issued specifically for it." },
            { "id": "sec_atk_scope_escalation", "label": "🪜 Scope escalation", "message": "call an admin-only tool to escalate privileges", "mode": "direct", "showcase": "atk_scope_escalation", "caption": "Attack blocked. The attempt to grab admin capability failed with insufficient_scope at both the gateway and the MCP server — dual enforcement." },
            { "id": "sec_atk_confused_deputy", "label": "🕵 Confused deputy", "message": "act as a rogue agent on the user's behalf", "mode": "direct", "showcase": "atk_confused_deputy", "caption": "Attack blocked. A forged actor chain (rogue act.sub) failed HasValidActorChain — delegation is bound to the registered AI Agent, not a may_act allowlist." },
            { "id": "sec_atk_hitl_replay", "label": "♻ HITL replay", "message": "reuse an approved consent receipt for a larger transfer", "mode": "direct", "showcase": "atk_hitl_replay", "caption": "Attack blocked. A consent receipt is bound to the exact tool it approved — replaying an approved create_transfer receipt on a different tool (create_withdrawal) is re-challenged, never honored." }
          ]
        },
        {
          "id": "pingone",
          "label": "PingOne Admin",
          "adminOnly": true,
          "badge": "MCP",
          "chips": [
            { "id": "p1_list_apps", "label": "List all apps", "message": "List all applications in our PingOne environment", "mode": "llm" },
            { "id": "p1_list_envs", "label": "List environments", "message": "Show all environments I have access to in PingOne", "mode": "llm" },
            { "id": "p1_services_enabled", "label": "What services are enabled?", "message": "What services are enabled in our PingOne environment?", "mode": "llm" },
            { "id": "p1_identity_count", "label": "Identity count this week", "message": "How many identities are in our PingOne environment?", "mode": "llm" },
            { "id": "p1_ai_agent_config", "label": "Show Demo AI Agent config", "message": "Get the configuration for the Demo AI Agent application in PingOne", "mode": "llm" },
            { "id": "p1_verify_apps", "label": "Verify all 8 demo apps", "message": "Confirm all 8 demo apps exist in PingOne: Demo Admin App, Demo User App, Demo MCP Server, Demo Worker, Demo MCP Exchanger, Demo MCP Gateway, Demo Agent, Demo AI Agent", "mode": "llm" }
          ]
        }
      ]
    }
