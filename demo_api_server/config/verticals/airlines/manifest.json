{
  "id": "airlines",
  "schemaVersion": 3,
  "identity": {
    "displayName": "United Airlines",
    "headerTitle": "United Airlines",
    "documentTitle": "United Airlines · PingOne AI IAM Core",
    "logoAlt": "United Airlines logo",
    "tagline": "Good Leads The Way"
  },
  "theme": {
    "cssVars": {
      "--app-primary-red": "#002244",
      "--app-primary-red-hover": "#001731",
      "--app-primary-red-mid": "#1414D2",
      "--app-primary-red-border": "#001731",
      "--brand-dashboard-header-start": "#002244",
      "--brand-dashboard-header-end": "#1414D2",
      "--brand-app-shell-hero-start": "#002244",
      "--brand-app-shell-hero-end": "#1414D2",
      "--theme-accent": "#1414D2",
      "--brand-dashboard-header-text": "#ffffff"
    }
  },
  "terminology": {
    "account": "Reservation",
    "accounts": "Reservations",
    "accountTypes": ["Economy", "Economy Plus", "United First", "United Polaris"],
    "transaction": "Flight",
    "transactions": "Flights",
    "transactionTypes": ["Booking", "Seat Change", "Bag Added", "Cancellation"],
    "balance": "MileagePlus Balance",
    "agent": "Travel Agent",
    "dashboard": "My Trips",
    "highValueAction": "Cancel Reservation",
    "highValueLabel": "Cancel a reservation and process a refund"
  },
  "groups": {
    "categories": {
      "privileged": {
        "name": "AI_Demo_Privileged",
        "description": "Users permitted to reach the active vertical's sensitive tool (UC9). One group serves every vertical."
      },
      "delegates": {
        "name": "AI_Demo_Delegates",
        "description": "Users authorized as delegated agents. One group serves every vertical."
      }
    },
    "restrictedTools": {
      "sensitive_airline_bookings": "privileged",
      "sensitive_passenger_record": "privileged"
    },
    "userMemberships": {
      "demoUser": ["privileged"],
      "demoAdmin": ["privileged"],
      "demoDelegate": ["privileged"]
    }
  },
  "agent": {
    "persona": "Skyline",
    "greeting": "Hi {name}! I'm Skyline, your United travel agent. I can pull up your reservations, check a flight's status and gate, and show you the seat map. What would you like to look at?",
    "systemPromptFlavor": "You are Skyline, a United Airlines travel agent. Help passengers view their reservations, check flight status and gate information, and see seat availability. Use airline language: accounts are reservations, transactions are flights, balance is the MileagePlus balance. Be concise and factual — every answer comes from the airline's reservation system, so never invent a flight, seat, or confirmation number."
  },
  "hero": {
    "imageUrl": "https://images.unsplash.com/photo-1436491865332-7a61a109cc05?w=1200&h=600&fit=crop",
    "greeting": "Ready for your next flight?"
  },
  "dashboard": {
    "kind": "airlines",
    "chips": [
      { "key": "balance", "label": "MileagePlus Balance" },
      { "key": "accounts", "label": "My Reservations" },
      { "key": "transactions", "label": "My Flights" }
    ],
    "chips10": [
      {
        "id": "ua1",
        "label": "My reservations",
        "message": "show my reservations",
        "mode": "both",
        "tool": "get_airline_bookings",
        "useCaseId": "delegated-access-with-proof"
      },
      {
        "id": "ua5",
        "label": "🔑 Cancel a reservation",
        "message": "cancel my reservation and refund it",
        "mode": "both",
        "challenge": "step_up",
        "tool": "cancel_airline_reservation",
        "useCaseId": "step-up-required",
        "group": "advanced"
      },
      {
        "id": "ua6",
        "label": "Pay a change fee",
        "message": "pay a $300 change fee",
        "mode": "both",
        "tool": "pay_airline_fee",
        "useCaseId": "hitl-consent",
        "group": "advanced"
      },
      {
        "id": "ua4",
        "label": "🔐 Sensitive reservations",
        "message": "access my sensitive airline bookings",
        "mode": "both",
        "challenge": "consent",
        "tool": "sensitive_airline_bookings",
        "useCaseId": "hitl-consent",
        "group": "advanced"
      },
      {
        "id": "ua2",
        "label": "Flight status",
        "message": "what is the status of flight UA328",
        "mode": "both",
        "tool": "get_flight_status",
        "useCaseId": "delegated-access-with-proof"
      },
      {
        "id": "ua3",
        "label": "Available seats",
        "message": "show available seats on flight UA328",
        "mode": "both",
        "tool": "check_seat_availability",
        "useCaseId": "delegated-access-with-proof"
      },
      {
        "id": "ua-a2a",
        "label": "Sensitive passenger record",
        "message": "show my sensitive passenger record",
        "mode": "both",
        "challenge": "consent",
        "tool": "sensitive_passenger_record",
        "useCaseId": "a2a-delegation",
        "group": "advanced"
      }
    ]
  },
  "render": {
    "check_seat_availability": { "type": "seatMap" },
    "get_airline_bookings": {
      "type": "table",
      "title": "Your Reservations",
      "columns": [
        { "label": "Confirmation", "path": "confirmationNumber" },
        { "label": "Flight", "path": "flightNumber" },
        { "label": "Route", "path": "route" },
        { "label": "Departure", "path": "departureTime", "format": "date" },
        { "label": "Gate", "path": "gate" },
        { "label": "Seat", "path": "seat" },
        { "label": "Cabin", "path": "cabin" },
        { "label": "Status", "path": "status" }
      ]
    },
    "sensitive_airline_bookings": {
      "type": "table",
      "title": "Reservations (sensitive)",
      "columns": [
        { "label": "Confirmation", "path": "confirmationNumber" },
        { "label": "Flight", "path": "flightNumber" },
        { "label": "Route", "path": "route" },
        { "label": "Departure", "path": "departureTime", "format": "date" },
        { "label": "Seat", "path": "seat" },
        { "label": "Cabin", "path": "cabin" },
        { "label": "Status", "path": "status" }
      ]
    },
    "get_flight_status": {
      "type": "card",
      "title": "Flight Status",
      "fields": [
        { "label": "Flight", "path": "flightNumber", "accent": true },
        { "label": "Route", "path": "route" },
        { "label": "Departure", "path": "departureTime", "format": "date" },
        { "label": "Arrival", "path": "arrivalTime", "format": "date" },
        { "label": "Gate", "path": "gate" },
        { "label": "Aircraft", "path": "aircraft" },
        { "label": "Status", "path": "status" }
      ]
    },
    "get_loyalty_status": {
      "type": "card",
      "title": "MileagePlus Status",
      "fields": [
        { "label": "Passenger", "path": "name" },
        { "label": "Tier", "path": "loyaltyTier", "accent": true },
        { "label": "Points", "path": "loyaltyPoints", "format": "count" },
        { "label": "Passenger ref", "path": "passengerRef" }
      ]
    },
    "redeem_miles": {
      "type": "card",
      "title": "Miles Redemption",
      "fields": [
        { "label": "Confirmation", "path": "confirmationNumber" },
        { "label": "Flight", "path": "flightNumber" },
        { "label": "Route", "path": "route" },
        { "label": "Upgraded to", "path": "upgradedToCabin", "accent": true },
        { "label": "Previous cabin", "path": "previousCabin" },
        { "label": "Points redeemed", "path": "pointsRedeemed", "format": "count" },
        { "label": "Points remaining", "path": "pointsRemaining", "format": "count" }
      ]
    },
    "pay_airline_fee": {
      "type": "card",
      "title": "Fee Payment",
      "fields": [
        { "label": "Amount", "path": "amount", "format": "money", "accent": true },
        { "label": "Fee type", "path": "feeType" },
        { "label": "Confirmation", "path": "confirmationNumber" },
        { "label": "Receipt", "path": "receiptId" },
        { "label": "Paid at", "path": "paidAt", "format": "date" }
      ]
    },
    "cancel_airline_reservation": {
      "type": "card",
      "title": "Reservation Cancelled",
      "fields": [
        { "label": "Confirmation", "path": "confirmationNumber" },
        { "label": "Flight", "path": "flightNumber" },
        { "label": "Route", "path": "route" },
        { "label": "Departure", "path": "departureTime", "format": "date" },
        { "label": "Refund", "path": "refund.status", "accent": true },
        { "label": "Refund method", "path": "refund.method" }
      ]
    },
    "sensitive_passenger_record": {
      "type": "fieldList",
      "title": "Passenger Record (PII)",
      "fields": [
        { "label": "Name", "path": "name", "accent": true },
        { "label": "Passenger ref", "path": "passengerRef" },
        { "label": "Date of birth", "path": "dateOfBirth", "format": "date" },
        { "label": "Passport", "path": "passportNumber" },
        { "label": "Known traveler", "path": "knownTravelerNumber" },
        { "label": "Loyalty tier", "path": "loyalty.tier" },
        { "label": "Loyalty points", "path": "loyalty.points", "format": "count" },
        { "label": "Loyalty account", "path": "loyalty.accountNumber" },
        { "label": "Card", "path": "paymentCard.brand" },
        { "label": "Card last 4", "path": "paymentCard.last4" }
      ]
    }
  },
  "scopes": {
    "read": "read",
    "write": "write",
    "transfer": "transfer",
    "featureScope": "airlines:read"
  },
  "demoUsers": {
    "customer": {
      "hint": "demoUser",
      "passwordHint": "Tigers7&"
    },
    "admin": {
      "hint": "demoAdmin",
      "passwordHint": "Tigers7&"
    }
  }
}
