      { "id": "wf2", "label": "PTO balance", "message": "pto balance", "mode": "both", "tool": "pto_balance", "useCaseId": "delegated-access-with-proof" },
      { "id": "wf3", "label": "My expenses", "message": "my expenses", "mode": "both", "tool": "list_expenses", "useCaseId": "delegated-access-with-proof" },
      { "id": "wf4", "label": "🔑 Submit an expense", "message": "submit an expense", "mode": "both", "hitlTrigger": true, "challenge": "step_up", "tool": "submit_expense", "useCaseId": "step-up-required" },
      { "id": "wf5", "label": "🔐 Request time off", "message": "request time off", "mode": "both", "hitlTrigger": true, "challenge": "consent", "tool": "request_time_off", "useCaseId": "hitl-consent" },
      { "id": "wf-feature", "label": "My expense report", "message": "view my expense report", "mode": "both", "tool": "show_expense_report", "useCaseId": "delegated-access-with-proof" },
