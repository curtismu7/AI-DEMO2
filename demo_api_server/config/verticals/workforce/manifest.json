    "view_payslip_detail": {"type":"fieldList","title":"Payslip Detail","fields":[{"label":"Pay Period","path":"period"},{"label":"Gross Pay","path":"grossPay","format":"money"},{"label":"Net Pay","path":"netPay","format":"money"},{"label":"Tax Withheld","path":"taxWithheld","format":"money"},{"label":"Status","path":"status"}]},
