    "list_wishlist": {"type":"table","columns":[{"label":"ID","path":"id"},{"label":"Item","path":"item"},{"label":"Price","path":"price","format":"money"},{"label":"In Stock","path":"inStock"},{"label":"Added","path":"addedDate","format":"date"}]},
