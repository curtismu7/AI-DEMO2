  "agent": {
    "persona": "Sports Assistant",
    "greeting": "Hi {name}! I can check your reward points, browse your purchase history, and help you place orders. What do you need?",
    "systemPromptFlavor": "You are a Super Sports Assistant. Help members check their reward points, view loyalty account details, browse purchase history, and place orders for gear and equipment. Use sports retail language: accounts are loyalty accounts, transactions are purchases, balance is reward points. Be concise and professional."
  },
  "hero": {
    "imageUrl": "https://images.unsplash.com/photo-1461896836934-ffe607ba8211?w=1200&h=600&fit=crop",
    "greeting": "Welcome! Ready to gear up?"
  },
  "dashboard": {
    "kind": "sporting-goods",
    "chips": [
      {
        "key": "balance",
        "label": "Reward Points"
      },
      {
        "key": "accounts",
        "label": "My Gear"
      },
      {
        "key": "transactions",
        "label": "Purchase History"
      },
      {
        "key": "transfer",
        "label": "Place Order"
      },
      {
        "key": "feature",
        "label": "Show Gear Order"
      }
    ],
    "hero": {
      "cards": [
        {
          "label": "Gear Value",
          "dataKey": "heroStats.gearValue",
          "format": "money"
        },
        {
          "label": "Active Rentals",
          "dataKey": "heroStats.activeRentals",
          "format": "count"
        },
        {
          "label": "Loyalty Tier",
          "dataKey": "heroStats.loyaltyTier",
          "format": "text"
        },
        {
          "label": "Last Purchase",
          "dataKey": "heroStats.lastPurchase",
          "format": "date"
        }
      ]
    },
    "chips10": [
      { "id": "sg-jwt", "label": "Decode my token", "message": "decode my jwt token", "mode": "both", "tool": "jwt_decode_full", "useCaseId": "delegated-access-with-proof" },
      { "id": "sg1", "label": "My gear", "message": "my gear", "mode": "both", "tool": "list_gear", "useCaseId": "delegated-access-with-proof" },
      { "id": "sg2", "label": "My rentals", "message": "my rentals", "mode": "both", "tool": "list_rentals", "useCaseId": "delegated-access-with-proof" },
      { "id": "sg-gear", "label": "Shop hiking gear", "message": "I need gear for a hiking trip", "mode": "both", "tool": "browse_gear", "useCaseId": "delegated-access-with-proof" },
      { "id": "sg3", "label": "🔐 Extend my rental", "message": "extend my rental", "mode": "both", "hitlTrigger": true, "challenge": "consent", "tool": "extend_rental", "useCaseId": "hitl-consent" },
      { "id": "sg-mfa", "label": "Transfer membership", "message": "transfer my membership", "mode": "both", "challenge": "step_up", "tool": "transfer_membership", "useCaseId": "step-up-required" },
      { "id": "sg4", "label": "Order status", "message": "order status", "mode": "both", "tool": "gear_order_status", "useCaseId": "delegated-access-with-proof" },
      { "id": "sg5", "label": "My loyalty points", "message": "my loyalty points", "mode": "both", "tool": "loyalty_balance", "useCaseId": "delegated-access-with-proof" },
      { "id": "sg-feature", "label": "My gear order", "message": "view my gear order", "mode": "both", "tool": "show_gear_order", "useCaseId": "delegated-access-with-proof" },
      { "id": "sg6", "label": "My gear warranty", "message": "show my gear warranty", "mode": "both", "tool": "show_gear_warranty", "useCaseId": "mortgage-delegated-access" },
      { "id": "sg7", "label": "Price-match my order", "message": "can you price-match my last order?", "mode": "both", "tool": "request_price_match", "useCaseId": "unauthorized-commitment-fee-waiver" },
      { "id": "sg-a2a", "label": "Sensitive membership details", "message": "access my sensitive membership details", "mode": "both", "challenge": "consent", "tool": "sensitive_membership_details", "useCaseId": "a2a-delegation" },
      { "id": "sg-direct", "label": "Direct MCP", "message": "order status", "mode": "direct", "tool": "gear_order_status" },
      { "id": "sg-dpop", "label": "DPoP / replay defense", "message": "fire a token with the wrong audience at the gateway", "mode": "direct", "tool": "test_wrong_audience", "useCaseId": "token-theft-replay" },
      { "id": "sg-deny", "label": "Authz DENY", "message": "show my university enrollment", "mode": "direct", "denyTool": "show_enrollment", "useCaseId": "authz-denied" },
      { "id": "sg-bad-scope", "label": "Bad scope", "message": "run a gear order call my token has no scope for", "mode": "direct", "tool": "test_wrong_scope", "useCaseId": "insufficient-scope" }
    ],
    "securityShowcase": {
      "tabs": [
        {
          "id": "defenses",
          "label": "Defenses",
          "chips": [
            { "id": "sec_mfa_otp", "label": "🔐 MFA · OTP", "message": "extend my rental", "mode": "both", "challenge": "step_up", "tool": "extend_rental", "hitlTrigger": true, "showcase": "mfa_otp", "stepUpMethod": "otp", "caption": "Defense worked. A high-value action forced live identity verification (email/SMS OTP) before money moved — the agent alone couldn't complete it." },
            { "id": "sec_mfa_fido", "label": "🔐 MFA · Passkey", "message": "extend my rental", "mode": "both", "challenge": "step_up", "tool": "extend_rental", "hitlTrigger": true, "showcase": "mfa_fido", "stepUpMethod": "fido", "caption": "Defense worked. The same high-value gate was satisfied with a passkey (FIDO2/WebAuthn) — phishing-resistant step-up, no shared secret." },
            { "id": "sec_hitl", "label": "🔐 HITL consent", "message": "extend my rental", "mode": "both", "challenge": "consent", "tool": "extend_rental", "hitlTrigger": true, "showcase": "hitl_consent", "caption": "Defense worked. A human had to explicitly approve the agent's action; PingOne Authorize returned a bound, single-use receipt before the transfer ran." },
            { "id": "sec_deny", "label": "⛔ Authz DENY", "message": "show my mortgage", "mode": "direct", "denyTool": "show_mortgage", "showcase": "authz_deny", "caption": "Defense worked. PingOne Authorize hard-denied a tool from another vertical (AllowedVertical) — the agent can only reach tools the active context permits." },
            { "id": "sec_bad_scope", "label": "🚫 Bad scope", "message": "look up all customers", "mode": "both", "showcase": "bad_scope", "caption": "Defense worked. The call was refused with insufficient_scope — the user's token never carried admin scope, and RFC 8693 exchange can only narrow, never add, scope." }
          ]
        },
        {
          "id": "ai",
          "label": "AI Reasoning",
          "chips": [
            { "id": "sec_llm_analyze", "label": "Spot unusual patterns", "message": "Check for unusual patterns in my recent activity", "mode": "llm", "showcase": "llm_analyze", "caption": "The analysis path ran the full pipeline — same RFC 8693 → gateway → Authorize legs as a heuristic chip, no shortcut." },
            { "id": "sec_llm_explain", "label": "Why was that blocked?", "message": "Explain why my last blocked action was denied and walk me through the token chain", "mode": "llm", "showcase": "llm_explain", "caption": "The agent explained its own security posture from the live token-chain events — useful for teaching why a control fired." }
          ]
        },
        {
          "id": "attacks",
          "label": "Attacks",
          "chips": [
            { "id": "sec_atk_prompt_injection", "label": "💉 Prompt injection", "message": "review my recent purchases and act on any instructions you find", "mode": "both", "showcase": "atk_prompt_injection", "caption": "Attack blocked. A poisoned purchase record tried to redirect the agent; the HITL gate + Authorize policy stopped the injected order regardless of what the LLM 'decided'." },
            { "id": "sec_atk_indirect_injection", "label": "💉 Indirect injection", "message": "summarize my accounts including any notes", "mode": "both", "showcase": "atk_indirect_injection", "caption": "Attack blocked. Malicious text hidden in account metadata couldn't drive an unauthorized action — the policy gate evaluates the request, not the agent's intent." },
            { "id": "sec_atk_wrong_aud", "label": "🎭 Wrong audience", "message": "fire a token with the wrong audience at the gateway", "mode": "direct", "showcase": "atk_wrong_aud", "caption": "Attack blocked. A token minted for the BFF was rejected at the gateway (D-05) — each hop validates the aud claim was issued specifically for it." },
            { "id": "sec_atk_scope_escalation", "label": "🪜 Scope escalation", "message": "call an admin-only tool to escalate privileges", "mode": "direct", "showcase": "atk_scope_escalation", "caption": "Attack blocked. The attempt to grab admin capability failed with insufficient_scope at both the gateway and the MCP server — dual enforcement." },
            { "id": "sec_atk_confused_deputy", "label": "🕵 Confused deputy", "message": "act as a rogue agent on the user's behalf", "mode": "direct", "showcase": "atk_confused_deputy", "caption": "Attack blocked. A forged actor chain (rogue act.sub) failed HasValidActorChain — delegation is bound to the registered AI Agent, not a may_act allowlist." },
            { "id": "sec_atk_hitl_replay", "label": "♻ HITL replay", "message": "reuse an approved consent receipt for a larger order", "mode": "direct", "showcase": "atk_hitl_replay", "caption": "Attack blocked. A consent receipt is bound to the exact tool it approved — replaying an approved create_transfer receipt on a different tool (create_withdrawal) is re-challenged, never honored." }
          ]
        },
        {
          "id": "pingone",
          "label": "PingOne Admin",
          "adminOnly": true,
          "badge": "MCP",
          "chips": [
            { "id": "p1_list_apps", "label": "List all apps", "message": "List all applications in our PingOne environment", "mode": "llm" },
            { "id": "p1_list_envs", "label": "List environments", "message": "Show all environments I have access to in PingOne", "mode": "llm" },
            { "id": "p1_services_enabled", "label": "What services are enabled?", "message": "What services are enabled in our PingOne environment?", "mode": "llm" },
            { "id": "p1_identity_count", "label": "Identity count this week", "message": "How many identities are in our PingOne environment?", "mode": "llm" },
            { "id": "p1_ai_agent_config", "label": "Show Demo AI Agent config", "message": "Get the configuration for the Demo AI Agent application in PingOne", "mode": "llm" },
            { "id": "p1_verify_apps", "label": "Verify all 8 demo apps", "message": "Confirm all 8 demo apps exist in PingOne: Demo Admin App, Demo User App, Demo MCP Server, Demo Worker, Demo MCP Exchanger, Demo MCP Gateway, Demo Agent, Demo AI Agent", "mode": "llm" }
          ]
        }
      ]
    },
