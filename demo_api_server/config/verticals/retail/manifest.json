    "greeting": "Hi {name}! I can browse products, check prices, help with your cart, and explain the OAuth flows securing your checkout. What would you like to do?",
    "systemPromptFlavor": "You are a Great Buy shopping assistant. Help customers check their reward points, browse purchase history, view their account balances, and complete checkouts. Use retail language: accounts are loyalty accounts, transactions are purchases, balance is reward points, transfers are orders. Be concise and professional."
  },
  "hero": {
    "imageUrl": "https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=1200&h=600&fit=crop",
    "greeting": "Let's find something great for you."
  },
  "dashboard": {
    "kind": "retail",
    "chips": [
      {
        "key": "balance",
        "label": "Rewards Points"
      },
      {
        "key": "accounts",
        "label": "List My Orders"
      },
      {
        "key": "transactions",
        "label": "Purchase History"
      },
      {
        "key": "transfer",
        "label": "Checkout"
      },
      {
        "key": "feature",
        "label": "Show Large Purchase"
      }
    ],
    "chips10": [
      { "id": "rt-jwt", "label": "Decode my token", "message": "decode my jwt token", "mode": "both", "tool": "jwt_decode_full", "useCaseId": "delegated-access-with-proof" },
      { "id": "rt1", "label": "List my orders", "message": "list my orders", "mode": "both", "tool": "list_orders", "useCaseId": "delegated-access-with-proof" },
      { "id": "rt2", "label": "Where's my order?", "message": "order status", "mode": "both", "tool": "order_status", "useCaseId": "delegated-access-with-proof" },
      { "id": "rt3", "label": "My reward points", "message": "my reward points", "mode": "both", "tool": "rewards_balance", "useCaseId": "delegated-access-with-proof" },
      { "id": "rt4", "label": "🔐 Checkout", "message": "checkout", "mode": "both", "hitlTrigger": true, "challenge": "consent", "tool": "checkout", "useCaseId": "hitl-consent" },
      { "id": "rt-mfa", "label": "Cash out store credit", "message": "cash out my store credit", "mode": "both", "challenge": "step_up", "tool": "cash_out_store_credit", "useCaseId": "step-up-required" },
      { "id": "rt-feature", "label": "My large purchase", "message": "show my large purchase", "mode": "both", "tool": "show_large_purchase", "useCaseId": "delegated-access-with-proof" },
      { "id": "rt-invest", "label": "Portfolio status", "message": "show portfolio status", "mode": "both", "tool": "show_investment", "useCaseId": "delegated-access-with-proof" },
      { "id": "rt-a2a", "label": "Sensitive order history", "message": "access my sensitive order history", "mode": "both", "challenge": "consent", "tool": "sensitive_order_history", "useCaseId": "a2a-delegation", "group": "advanced" },
      { "id": "rt5", "label": "Order history", "message": "order history", "mode": "both", "tool": "list_orders", "useCaseId": "delegated-access-with-proof" },
      { "id": "rt6", "label": "Track my order", "message": "track my order", "mode": "both", "tool": "order_status", "useCaseId": "delegated-access-with-proof" },
      { "id": "rt7", "label": "Store credit balance", "message": "store credit balance", "mode": "both", "tool": "rewards_balance", "useCaseId": "delegated-access-with-proof" },
      { "id": "rt8", "label": "What should I buy with my points?", "message": "What should I buy with my points?", "mode": "both", "tool": "rewards_balance", "useCaseId": "delegated-access-with-proof" },
      { "id": "rt9", "label": "Compare my last two orders", "message": "Compare my recent purchases side by side", "mode": "both", "tool": "list_orders", "useCaseId": "delegated-access-with-proof" },
      { "id": "rt10", "label": "Any deals on what I viewed?", "message": "Any deals on what I viewed?", "mode": "both", "tool": "view_recently_viewed", "useCaseId": "delegated-access-with-proof" },
      { "id": "rt-direct", "label": "🔌 Direct MCP", "message": "list my orders", "mode": "direct", "tool": "list_orders" },
      { "id": "rt-dpop", "label": "DPoP / replay defense", "message": "fire a token with the wrong audience at the gateway", "mode": "direct", "tool": "test_wrong_audience", "useCaseId": "token-theft-replay" },
      { "id": "rt-deny", "label": "Authz DENY", "message": "show my sporting gear order", "mode": "direct", "denyTool": "show_gear_order", "useCaseId": "authz-denied" },
      { "id": "rt-bad-scope", "label": "Bad scope", "message": "run an order call my token has no scope for", "mode": "direct", "tool": "test_wrong_scope", "useCaseId": "insufficient-scope" }
    ],
    "hero": {
      "cards": [
        {
          "label": "Cart Value",
          "dataKey": "heroStats.cartValue",
          "format": "money"
        },
