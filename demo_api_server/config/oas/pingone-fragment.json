{
  "openapi": "3.1.0",
  "info": {
    "title": "PingOne Platform API (Demo Fragment)",
    "version": "2024.1.0",
    "description": "Mock OpenAPI 3.1 fragment demonstrating AI-readable API contracts with x-permission and securityScheme annotations. The ultimate aim is a well-defined, machine-understandable definition of platform APIs."
  },
  "servers": [
    {
      "url": "https://api.pingone.{tld}/",
      "description": "PingOne API",
      "variables": {
        "tld": { "default": "com", "enum": ["com", "eu", "com.au", "asia", "ca"] }
      }
    }
  ],
  "security": [{ "bearerAuth": [] }],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "OAuth 2.0 Bearer Token obtained via RFC 8693 token exchange from the MCP gateway. The exchanged token carries the required scopes declared per operation via x-public-api annotations."
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id":        { "type": "string", "format": "uuid", "readOnly": true },
          "username":  { "type": "string" },
          "email":     { "type": "string", "format": "email" },
          "enabled":   { "type": "boolean", "default": true },
          "createdAt": { "type": "string", "format": "date-time", "readOnly": true }
        },
        "required": ["username", "email"]
      },
      "Application": {
        "type": "object",
        "properties": {
          "id":      { "type": "string", "format": "uuid", "readOnly": true },
          "name":    { "type": "string" },
          "type":    { "type": "string", "enum": ["WEB_APP", "NATIVE_APP", "SINGLE_PAGE_APP", "WORKER"] },
          "enabled": { "type": "boolean", "default": true }
        }
      },
      "Environment": {
        "type": "object",
        "properties": {
          "id":     { "type": "string", "format": "uuid", "readOnly": true },
          "name":   { "type": "string" },
          "type":   { "type": "string", "enum": ["SANDBOX", "PRODUCTION"] },
          "region": { "type": "string" }
        }
      }
    }
  },
  "tags": [
    { "name": "Users",        "description": "User lifecycle management" },
    { "name": "Applications", "description": "Application registration and configuration" },
    { "name": "Environments", "description": "Environment management" }
  ],
  "paths": {
    "/v1/environments/{environmentId}/users": {
      "get": {
        "operationId": "listUsers",
        "summary": "List users in an environment",
        "tags": ["Users"],
        "x-public-api": "api",
        "x-permission": "Identity Admin",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "environmentId", "in": "path",  "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "limit",         "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 100 } },
          { "name": "filter",        "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Paginated list of users" },
          "401": { "description": "Unauthorized — bearer token missing or invalid" },
          "403": { "description": "Forbidden — insufficient scope or missing x-permission role" }
        }
      },
      "post": {
        "operationId": "createUser",
        "summary": "Create a user in an environment",
        "tags": ["Users"],
        "x-public-api": "api",
        "x-permission": "Identity Admin",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "environmentId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/User" } }
          }
        },
        "responses": {
          "201": { "description": "User created" },
          "400": { "description": "Invalid request body" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden — requires write scope + Identity Admin role" }
        }
      }
    },
    "/v1/environments/{environmentId}/users/{userId}": {
      "get": {
        "operationId": "getUser",
        "summary": "Get a single user by ID",
        "tags": ["Users"],
        "x-public-api": "api",
        "x-permission": "Identity Admin",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "environmentId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "userId",        "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "User object" },
          "404": { "description": "User not found" }
        }
      }
    },
    "/v1/environments/{environmentId}/applications": {
      "get": {
        "operationId": "listApplications",
        "summary": "List applications registered in an environment",
        "tags": ["Applications"],
        "x-public-api": "api",
        "x-permission": "Environment Admin",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "environmentId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "List of applications" },
          "403": { "description": "Forbidden — requires Environment Admin role" }
        }
      }
    },
    "/v1/environments/{environmentId}": {
      "get": {
        "operationId": "getEnvironment",
        "summary": "Get environment details",
        "tags": ["Environments"],
        "x-public-api": "api",
        "x-permission": "Environment Admin",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "environmentId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Environment object" }
        }
      }
    }
  }
}
