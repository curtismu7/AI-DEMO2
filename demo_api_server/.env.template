# demo_api_server/.env.template
# Copy to .env (gitignored) and fill with real values from 1Password or your secrets manager.
# NEVER commit actual secrets.
#
# Fetch from 1Password: op item get "demo-api-server secrets" --vault "Banking Demo" --format json | jq '.fields[] | "\(.label)=\(.value)"'

# PingOne Core
PINGONE_ENVIRONMENT_ID=
PINGONE_REGION=com

# PingOne Admin App (M2M for platform management)
PINGONE_ADMIN_CLIENT_ID=
PINGONE_ADMIN_CLIENT_SECRET=

# PingOne User App (User OAuth)
PINGONE_USER_CLIENT_ID=
PINGONE_USER_CLIENT_SECRET=

# PingOne Worker (Management API access)
PINGONE_WORKER_CLIENT_ID=
PINGONE_WORKER_CLIENT_SECRET=

# AI Agent (Exchange #1 actor)
PINGONE_AI_AGENT_CLIENT_ID=
PINGONE_AI_AGENT_CLIENT_SECRET=

# MCP Gateway (Exchange #2 actor)
MCP_GW_CLIENT_ID=
MCP_GW_CLIENT_SECRET=

# Agent Service
AGENT_CLIENT_ID=
AGENT_CLIENT_SECRET=
BFF_INTERNAL_SECRET=

# JWT signing (REQUIRED — without this BFF uses insecure hardcoded fallback)
JWT_SECRET=

# LLM API keys (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Session
SESSION_SECRET=

# PingOne Authorize + Token Exchange URLs
PINGONE_AUTHORIZE_URL=https://auth.pingone.com
PINGONE_TOKEN_ENDPOINT_URL=https://auth.pingone.com/as/token
PINGONE_INTROSPECT_ENDPOINT_URL=https://auth.pingone.com/as/introspect

# Application URLs
PUBLIC_APP_URL=https://local.ping-devops.com:4000
API_BASE_URL=https://api.ping.demo:3001
