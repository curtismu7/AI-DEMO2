# Mastra agent service
AGENT_HTTP_HOST=127.0.0.1
# AGENT_HTTP_PORT: configure this setting for mastra_agent/.env.example; see the service documentation.
AGENT_HTTP_PORT=8892

# OPENAI_API_KEY: configure this setting for mastra_agent/.env.example; see the service documentation.
OPENAI_API_KEY=<your-openai-api-key>
# OPENAI_MODEL: configure this setting for mastra_agent/.env.example; see the service documentation.
OPENAI_MODEL=gpt-4o

# Required only for Anthropic provider mode (context.provider="anthropic").
# The OpenAI/LM-Studio key above is never valid against api.anthropic.com.
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# BFF_INTERNAL_SECRET: configure this setting for mastra_agent/.env.example; see the service documentation.
BFF_INTERNAL_SECRET=dev-shared-secret-change-me
# BFF_INTERNAL_TOOL_URL: configure this setting for mastra_agent/.env.example; see the service documentation.
BFF_INTERNAL_TOOL_URL=http://127.0.0.1:3001/internal/agent-tool
