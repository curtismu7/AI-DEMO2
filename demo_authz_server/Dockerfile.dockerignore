# Start with an empty context and allow only the authz build inputs.
**
!scope-topology.json
!demo_authz_server/
!demo_authz_server/package*.json
!demo_authz_server/*.js
!demo_authz_server/routes/
!demo_authz_server/routes/**
!snapshots/
!snapshots/gen-authorize-snapshot.js
!snapshots/intentGovernancePolicy.js
!snapshots/AI_Demo_Transaction_Authorization_P1AZ.snapshot.json

# Keep secrets, dependency trees, VCS data, and generated/runtime clutter out.
**/.git
**/.git/**
**/node_modules
**/node_modules/**
**/.venv
**/.venv/**
**/venv
**/venv/**
**/__pycache__
**/__pycache__/**
**/*.pyc
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.crt
**/*.p12
**/*.pfx
**/*.log
**/coverage
**/coverage/**
**/.cache
**/.cache/**
**/.turbo
**/.turbo/**
