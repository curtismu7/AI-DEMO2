# Secrets template — copy to 03-secrets.yaml, fill in real values, NEVER commit.
# Generate base64: echo -n "value" | base64
# Or let the deploy script create this from demo_api_server/.env automatically.
#
# After filling in, apply with: kubectl apply -f k8s/03-secrets.yaml
# The deploy.sh script runs k8s/create-secrets.sh which does this from .env.

apiVersion: v1
kind: Secret
metadata:
  name: ai-demo-secrets
  namespace: ai-demo
  labels:
    app: ai-demo
type: Opaque
data:
  # ── Core PingOne ────────────────────────────────────────────────────────────
  PINGONE_ENVIRONMENT_ID: ""        # base64(your-env-id)
  PINGONE_REGION: "Y29t"           # base64("com")
  SESSION_SECRET: ""

  # ── Admin OAuth App ─────────────────────────────────────────────────────────
  PINGONE_ADMIN_CLIENT_ID: ""
  PINGONE_ADMIN_CLIENT_SECRET: ""

  # ── User OAuth App ──────────────────────────────────────────────────────────
  PINGONE_USER_CLIENT_ID: ""
  PINGONE_USER_CLIENT_SECRET: ""

  # ── Optional PingFederate provider mode ────────────────────────────────────
  # Leave empty for the default PingOne mode. Populate from the approved PF
  # deployment configuration; never commit the filled Secret.
  # SE cluster (opt-in): set SE_PF_ISSUER (shell or demo_api_server/.env) before
  # create-secrets.sh and it overrides PF_ISSUER, the PF_*_ENDPOINT/PF_JWKS_URI
  # keys and PF_USER_REDIRECT_URI with the SE PingFederate; SE_OAUTH_MCP_URL
  # also sets PF_ID_JAG_AUDIENCE and PF_ID_JAG_RESOURCE (<url>/mcp). Unset =
  # .env values ship unchanged. k8s/aws/deploy.sh pins ConfigMap OAUTH_PROVIDER
  # to pingone; SE_OAUTH_PROVIDER overrides it ("" un-pins so the UI toggle works).
  OAUTH_PROVIDER: "" # pingfederate or pingone
  PF_ISSUER: ""
  PF_DISCOVERY_ENDPOINT: ""
  PF_AUTHORIZATION_ENDPOINT: ""
  PF_TOKEN_ENDPOINT: ""
  PF_USERINFO_ENDPOINT: ""
  PF_JWKS_URI: ""
  PF_ADMIN_CLIENT_ID: ""
  PF_ADMIN_CLIENT_SECRET: ""
  PF_ADMIN_REDIRECT_URI: ""
  PF_USER_CLIENT_ID: ""
  PF_USER_CLIENT_SECRET: ""
  PF_USER_REDIRECT_URI: ""
  PF_TOKEN_EXCHANGE_CLIENT_ID: ""
  PF_TOKEN_EXCHANGE_CLIENT_SECRET: ""
  PF_ID_JAG_ENABLED: ""
  PF_ID_JAG_AUDIENCE: ""
  PF_ID_JAG_RESOURCE: ""
  PF_ID_JAG_SCOPE: ""
  PF_ID_JAG_SUBJECT_TOKEN_TYPE: ""
  PF_ID_JAG_REDEMPTION_TOKEN_ENDPOINT: ""
  PF_ID_JAG_REDEMPTION_CLIENT_ID: ""
  PF_ID_JAG_REDEMPTION_CLIENT_SECRET: ""
  PF_ID_JAG_REDEMPTION_AUTH_METHOD: ""

  # ── Optional SAML subject for the ID-JAG playground ─────────────────────────
  # Signer key pair for the SAML assertion the BFF signs (base64 of the PEM, so
  # base64 twice here) and the PingFederate client secret for the SAML exchange.
  # Leave empty to keep the playground's SAML toggle disabled.
  SAML_SIGNING_KEY_PEM_B64: ""
  SAML_SIGNING_CERT_PEM_B64: ""
  PF_SAML_CLIENT_SECRET: ""

  # ── Worker (Management API) ─────────────────────────────────────────────────
  PINGONE_WORKER_CLIENT_ID: ""
  PINGONE_WORKER_CLIENT_SECRET: ""

  # ── AI Agent (Exchange #1 actor) ────────────────────────────────────────────
  PINGONE_AI_AGENT_CLIENT_ID: ""
  PINGONE_AI_AGENT_CLIENT_SECRET: ""

  # ── MCP Gateway (Exchange #2 actor) ─────────────────────────────────────────
  MCP_GW_CLIENT_ID: ""
  MCP_GW_CLIENT_SECRET: ""

  # ── Agent Service ───────────────────────────────────────────────────────────
  AGENT_CLIENT_ID: ""
  AGENT_CLIENT_SECRET: ""
  BFF_INTERNAL_SECRET: ""

  # ── JWT signing (BFF clientCredentialsTokenService) ─────────────────────────
  # REQUIRED — without this the BFF silently uses the insecure hardcoded fallback
  JWT_SECRET: ""

  # ── LLM Provider (optional) ─────────────────────────────────────────────────
  ANTHROPIC_API_KEY: ""
  OPENAI_API_KEY: ""

  # ── PingOne Privilege LLM protection ────────────────────────────────────────
  # Calls a provider THROUGH Privilege: the gateway injects the real provider
  # key server-side and a policy can deny the call before it reaches the
  # provider. Virtual keys are issued in the Privilege console and are
  # CREDENTIALS — they ship empty here; create-secrets.sh mirrors real values
  # from the BFF .env into ai-demo-secrets, which the BFF mounts.
  PRIVILEGE_LLM_GATEWAY_URL: ""
  PRIVILEGE_LLM_VIRTUAL_KEY_ANTHROPIC: ""
  PRIVILEGE_LLM_VIRTUAL_KEY_GOOGLE: ""
  PRIVILEGE_LLM_VIRTUAL_KEY_OPENAI: ""
