# k8s/ghcr-images.env — canonical first-party image map for the GHCR share path.
#
# Sourced by publish.sh (author push), share-setup.sh (recipient setup) and
# deploy.sh's DEPLOY_SOURCE=ghcr recipient deploy. Each pair:
#   <manifest image name>:<GHCR repo name under $GITHUB_OWNER>
#
# The left side is the bare image name the k8s manifests reference
# (ai-demo-k8-*:latest, built locally by docker compose); the right side is the
# package published to ghcr.io/<GITHUB_OWNER>/. The two differ only where the
# compose service and the manifest name disagree (compose prefixing):
#   ui → frontend, api-server → demo-api-server, promptguard → mcp-promptguard.
#
# NOTE: k8s/aws/deploy.sh keeps its own IMAGE_MAP for the SE/EKS flow (live,
# regression-guarded — do not refactor the two into one unless you re-verify
# se-deploy). The test ghcr-image-map.test.sh cross-checks THIS map against the
# manifests so drift fails a test instead of a deploy.
#
# GHCR_IMAGE_MAP is an indexed array (macOS bash 3.2 — no associative arrays).
GHCR_IMAGE_MAP=(
  "ai-demo-k8-ui:ai-demo-frontend"
  "ai-demo-k8-api-server:ai-demo-demo-api-server"
  "ai-demo-k8-authz-server:ai-demo-authz-server"
  "ai-demo-k8-mcp-server:ai-demo-mcp-server"
  "ai-demo-k8-mcp-gateway:ai-demo-mcp-gateway"
  "ai-demo-k8-langchain-agent:ai-demo-langchain-agent"
  "ai-demo-k8-agent-service:ai-demo-agent-service"
  "ai-demo-k8-hitl-service:ai-demo-hitl-service"
  "ai-demo-k8-mcp-resource-server:ai-demo-mcp-resource-server"
  "ai-demo-k8-api-resource-server:ai-demo-api-resource-server"
  "ai-demo-k8-mcp-weather:ai-demo-mcp-weather"
  "ai-demo-k8-mcp-brave:ai-demo-mcp-brave"
  "ai-demo-k8-mcp-jwt-verifier:ai-demo-mcp-jwt-verifier"
  "ai-demo-k8-mcp-code-search:ai-demo-mcp-code-search"
  "ai-demo-k8-llamaindex-agent:ai-demo-llamaindex-agent"
  "ai-demo-k8-llm-proxy:ai-demo-llm-proxy"
  "ai-demo-k8-tier-manager:ai-demo-tier-manager"
  "ai-demo-k8-mcp-proxy:ai-demo-mcp-proxy"
  "ai-demo-k8-promptguard:ai-demo-mcp-promptguard"
  "ai-demo-k8-ungoverned-agent:ai-demo-ungoverned-agent"
)
