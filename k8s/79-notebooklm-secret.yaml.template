# NotebookLM sidecar credentials — TEMPLATE. Never commit the filled-in version.
#
# This Secret carries a live Google session. Anyone with `get secret` in this
# namespace can lift it and act as that Google account. Treat it accordingly.
#
# Create it from the host's real files rather than pasting values, so no
# credential ever passes through a shell history or an editor buffer:
#
#   kubectl create secret generic ai-demo-notebooklm \
#     --namespace ping-devops-cmuir \
#     --from-file=storage-state.json="$HOME/.notebooklm/profiles/default/storage_state.json" \
#     --from-literal=server-token="$(openssl rand -hex 32)"
#
# The SAME server-token value must also reach the BFF, which reads
# NOTEBOOKLM_SERVER_TOKEN from the ai-demo-secrets Secret. If the two disagree
# the sidecar answers 401 and the page renders "Host auth expired". To keep one
# source of truth, generate once and set both:
#
#   TOKEN="$(openssl rand -hex 32)"
#   kubectl create secret generic ai-demo-notebooklm -n ping-devops-cmuir \
#     --from-file=storage-state.json="$HOME/.notebooklm/profiles/default/storage_state.json" \
#     --from-literal=server-token="$TOKEN"
#   kubectl patch secret ai-demo-secrets -n ping-devops-cmuir \
#     --type=merge -p "{\"stringData\":{\"NOTEBOOKLM_SERVER_TOKEN\":\"$TOKEN\"}}"
#
# COOKIE STALENESS — the known limitation of this deployment. notebooklm-server
# rotates __Secure-1PSIDTS in its own jar, but that jar is an emptyDir, so the
# rotation is lost when the pod restarts and the pod reverts to the seeded
# cookies here. Those go stale after roughly 15-20 minutes of idleness. There is
# no in-cluster keepalive yet; refresh by re-running `notebooklm login` on the
# host and recreating this Secret:
#
#   kubectl delete secret ai-demo-notebooklm -n ping-devops-cmuir
#   kubectl create secret generic ai-demo-notebooklm ...   # as above
#   kubectl rollout restart deployment/notebooklm -n ping-devops-cmuir
#
apiVersion: v1
kind: Secret
metadata:
  name: ai-demo-notebooklm
type: Opaque
stringData:
  # Contents of ~/.notebooklm/profiles/default/storage_state.json on the host
  # that ran `notebooklm login`.
  storage-state.json: "REPLACE_ME_WITH_STORAGE_STATE_JSON"
  # Must match NOTEBOOKLM_SERVER_TOKEN in the ai-demo-secrets Secret.
  server-token: "REPLACE_ME_WITH_OPENSSL_RAND_HEX_32"
