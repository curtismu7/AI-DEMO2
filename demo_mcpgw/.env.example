# =============================================================================
# MCPGW — PingGateway MCP Security Gateway (standalone)
# Copy to .env and fill in values.
# =============================================================================

# --- PingOne environment -----------------------------------------------------
PINGONE_ENV_ID=<pingone-environment-id>

# --- Test resource credentials (PingGateway token introspection) -------------
# In PingOne: Applications > Resources > "test" resource > Overview tab
RESOURCE_CLIENT_ID=<test-resource-uuid>
# Mapped to "resource.secret.id" by SystemAndEnvSecretStore (PLAIN format).
RESOURCE_SECRET_ID=<test-resource-client-secret>

# --- Gateway public URL ------------------------------------------------------
# Must match the audience configured on the "test" PingOne resource.
GATEWAY_URL=http://localhost:3046

# --- Backend MCP server ------------------------------------------------------
# Standalone: http://host.docker.internal:8080
# In main ai-demo stack: http://mcp-server:8080
MCP_SERVER_URL=http://host.docker.internal:8080

# --- AI Agent credentials (MCP Tutorial app) ---------------------------------
# Used when starting the sample MCP agent — NOT read by PingGateway itself.
AGENT_CLIENT_ID=<agent-client-id>
AGENT_CLIENT_SECRET=<agent-client-secret>
